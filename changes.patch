+/**
+ * PlanStore — one "Complete the form" run at a time: its chips as the
+ * stream reports them, the planned sections, the spend so far and the
+ * trace, then Apply / Undo on the staff.
+ *
+ * Nothing touches the song until applyPlan: a run that fails or is
+ * cancelled leaves the score as it was. Apply appends every planned
+ * section's first suggestion through the song-form section APIs the
+ * section flow uses (placeSection, setChords, commitSection), after a
+ * snapshot that undoPlan restores with setSong.
+ */
+import { create } from 'zustand';
+import type { Song } from '../models/types';
+import { parseSuggestionChords } from '../engine/chordGenerator';
+import type { TargetChord } from '../engine/generationComparison';
+import {
+  buildPlanRequest,
+  runPlan,
+  type PlanEvent,
+  type PlanOptions,
+  type PlanRequest,
+  type PlanSectionResult,
+  type PlanTrace,
+  type PlannerKind,
+} from '../engine/planClient';
+import { CHORDS_PER_BAR, sectionLabel } from '../engine/songForm';
+import { useSongStore } from './songStore';
+import { beginTiming } from '../engine/experienceTiming.ts';
+
+export type PlanStatus = 'idle' | 'running' | 'done' | 'failed';
+export type PlanChipStep = 'plan' | 'validate' | 'revise' | 'generate_section' | 'judge' | 'error';
+/** Who did the step: Muse Spark, the author's chord model, or the rules. */
+export type PlanChipBadge = 'Muse Spark plan' | 'Muse Spark chords' | 'own model' | 'rules' | 'reused chorus';
+
+/** One step of the run as the band shows it, in run order. */
+export interface PlanChip {
+  step: PlanChipStep;
+  ok: boolean;
+  label: string;
+  badge: PlanChipBadge | null;
+  /** 'cadence: rules (n)' for a section with slots the song-form rules wrote. */
+  note: string | null;
+  latencyMs: number | null;
+  costUsd: number | null;
+  requestId: string | null;
+  /** Details for the tooltip: the plan, the validator's issues, a reason, the failure. */
+  message: string | null;
+}
+
+interface PlanState {
+  progress: string;
+  status: PlanStatus;
+  planner: PlannerKind | null;
+  chips: PlanChip[];
+  /** The generated sections by plan index; a regeneration replaces its entry. */
+  sections: PlanSectionResult[];
+  spendUsd: number;
+  error: string | null;
+  /** The terminal frame's trace (also of a failed run), for Export trace. */
+  trace: PlanTrace | null;
+  /** The sketch and settings the result was made for; checked again before Apply. */
+  request: PlanRequest | null;
+  applied: boolean;
+  /** The song before Apply; undoPlan restores it. */
+  snapshot: Song | null;
+  /** Id of the newest run; events and results of older runs are ignored. */
+  runId: number;
+
+  /** Start a run for the current song; a run in flight is aborted first. */
+  startPlan: (options: PlanOptions) => Promise<void>;
+  /** Abort the run in flight and hide the band; the song is untouched. */
+  cancelPlan: () => void;
+  /** Append every planned section's first suggestion to the song, in order. */
+  applyPlan: () => void;
+  /** Restore the song from before Apply. */
+  undoPlan: () => void;
+  /** The trace as JSON, or null before a terminal frame arrived. */
+  exportTrace: () => string | null;
+  /** Hide the band (cancelling a run in flight); applied sections stay. */
+  dismiss: () => void;
+}
+
+/** Store fields of no run at all. */
+function idleState(): Pick<PlanState, 'progress' | 'status' | 'planner' | 'chips' | 'sections' | 'spendUsd' | 'error' | 'trace' | 'request' | 'applied' | 'snapshot'> {
+  return {
+    progress: 'Preparing the song form…', status: 'idle', planner: null, chips: [], sections: [], spendUsd: 0, error: null, trace: null, request: null,
+    applied: false, snapshot: null,
+  };
+}
+
+/** 'chorus 8 (authentic) · verse 8 (half)': the plan as one line. */
+function planSummary(event: Extract<PlanEvent, { event: 'plan' | 'revise' }>['data']): string {
+  return event.plan.sections.map((s) => `${s.type} ${s.bars} (${s.cadence})`).join(' · ');
+}
+
+function sectionChip(section: PlanSectionResult): PlanChip {
+  const rules = section.rulesSlots.length;
+  return {
+    step: 'generate_section',
+    ok: true,
+    label: `${sectionLabel(section.sectionType)} · ${section.bars} bars${section.regenerated ? ' · regenerated' : ''}`,
+    // The backend's rule-based generator answers as 'rules' when the model is unavailable.
+    badge: section.source === 'reuse' ? 'reused chorus' : section.source === 'ai'
+      ? section.modelUsed === 'muse-spark-1.3' ? 'Muse Spark chords' : 'own model' : 'rules',
+    note: section.reuse
+      ? `from bar ${section.reuse.startMeasure + 1} · ${section.reuse.changedSlots.length} ending slots changed`
+      : rules > 0 ? `cadence: rules (${rules})` : null,
+    latencyMs: null,
+    costUsd: null,
+    requestId: null,
+    message: [section.modelUsed ? `model ${section.modelUsed}` : null, section.cadence ? `cadence ${section.cadence}` : null, section.reason || null]
+      .filter(Boolean).join(' · ') || null,
+  };
+}
+
+/** The chip for one stream event, or null for the terminal frames. */
+function chipFor(event: PlanEvent): PlanChip | null {
+  switch (event.event) {
+    case 'plan':
+    case 'revise': {
+      const { call, source, attempt } = event.data;
+      return {
+        step: event.event,
+        ok: true,
+        label: event.event === 'plan' ? 'plan' : `revise ${attempt}`,
+        badge: source === 'meta' ? 'Muse Spark plan' : 'rules',
+        note: null,
+        latencyMs: call?.latencyMs ?? null,
+        costUsd: call?.costUsd ?? null,
+        requestId: call?.requestId ?? null,
+        message: [call ? `${call.provider} ${call.model}` : null, planSummary(event.data)].filter(Boolean).join(' · '),
+      };
+    }
+    case 'validate': {
+      const { ok, errors } = event.data;
+      return {
+        step: 'validate',
+        ok,
+        label: ok ? 'validate ok' : `validate failed (${errors.length})`,
+        badge: null,
+        note: null,
+        latencyMs: null,
+        costUsd: null,
+        requestId: null,
+        message: errors.length ? errors.map((issue) => `${issue.code}: ${issue.message}`).join('; ') : null,
+      };
+    }
+    case 'generate_section':
+      return sectionChip(event.data);
+    case 'judge': {
+      const { decision, targets, provider, model, latencyMs, costUsd, requestId } = event.data;
+      return {
+        step: 'judge',
+        ok: true,
+        label: `judge: ${decision}${targets.length ? ` (${targets.length})` : ''}`,
+        badge: null,
+        note: null,
+        latencyMs,
+        costUsd,
+        requestId,
+        message: [`${provider} ${model}`, ...targets.map((t) => `section ${t.section + 1}: ${t.reason}`)].join(' · '),
+      };
+    }
+    default:
+      return null;
+  }
+}
+
+/** The red chip of a failed run. */
+function errorChip(label: string, message: string, requestId: string | null = null): PlanChip {
+  return { step: 'error', ok: false, label, badge: null, note: null, latencyMs: null, costUsd: null, requestId, message };
+}
+
+/** The section's chords, re-keyed from the server's absolute measure
+ *  indices to where placeSection put the section. */
+function sectionUpdates(section: PlanSectionResult, startMeasure: number): TargetChord[] {
+  const suggestion = section.suggestions[0];
+  if (!suggestion) return [];
+  const chords = parseSuggestionChords(suggestion);
+  const updates: TargetChord[] = [];
+  for (let bar = 0; bar < section.bars; bar++) {
+    for (let slot = 0; slot < CHORDS_PER_BAR; slot++) {
+      const chord = chords.get(`${section.startMeasure + bar}-${slot}`);
+      if (chord) updates.push({ address: { measureIndex: startMeasure + bar, slotIndex: slot as 0 | 1 }, chord });
+    }
+  }
+  return updates;
+}
+
+/** Module-level because it is not UI state. */
+let controller: AbortController | null = null;
+/** True while undoPlan replaces the song: that epoch bump is the plan's own. */
+let restoringSnapshot = false;
+
+export const usePlanStore = create<PlanState>((set, get) => {
+  const isCurrent = (runId: number) => get().runId === runId;
+
+  const onEventFor = (runId: number) => (event: PlanEvent) => {
+    if (!isCurrent(runId)) return;
+    if (event.event === 'progress') { set({ progress: event.data.label }); return; }
+    const chip = chipFor(event);
+    if (!chip) return;
+    set((state) => {
+      const sections = [...state.sections];
+      if (event.event === 'generate_section') sections[event.data.index] = event.data;
+      return { chips: [...state.chips, chip], sections, spendUsd: state.spendUsd + (chip.costUsd ?? 0) };
+    });
+  };
+
+  return {
+    ...idleState(),
+    runId: 0,
+
+    startPlan: async (options) => {
+      controller?.abort();
+      const current = new AbortController();
+      controller = current;
+      const runId = get().runId + 1;
+      set({ ...idleState(), runId, status: 'running', planner: options.planner });
+      const finish = beginTiming('form.result', options.planner);
+      try {
+        const request = buildPlanRequest(useSongStore.getState().song, options);
+        set({ request });
+        const trace = await runPlan(request, { signal: current.signal, onEvent: onEventFor(runId) });
+        finish(trace.status === 'ok' ? 'ok' : 'error');
+        if (!isCurrent(runId)) return;
+        if (trace.status === 'ok') {
+          set({ status: 'done', sections: trace.sections, spendUsd: trace.spendUsd, trace });
+        } else {
+          const failure = trace.error;
+          const label = failure ? `failed: ${failure.kind}` : 'failed';
+          const message = failure?.message ?? 'The run failed';
+          set((state) => ({
+            status: 'failed', error: message, spendUsd: trace.spendUsd, trace,
+            chips: [...state.chips, errorChip(label, message, failure?.requestId ?? null)],
+          }));
+        }
+      } catch (err) {
+        finish(current.signal.aborted ? 'cancelled' : 'error');
+        if (!isCurrent(runId) || current.signal.aborted) return;
+        const message = err instanceof Error ? err.message : String(err);
+        set((state) => ({ status: 'failed', error: message, chips: [...state.chips, errorChip('failed', message)] }));
+      } finally {
+        if (controller === current) controller = null;
+      }
+    },
+
+    cancelPlan: () => {
+      controller?.abort();
+      controller = null;
+      set((state) => ({ ...idleState(), runId: state.runId + 1 }));
+    },
+
+    applyPlan: () => {
+      const { status, sections, applied, request } = get();
+      if (status !== 'done' || applied || sections.length === 0 || !request) return;
+      const { song, placeSection, setChords, commitSection } = useSongStore.getState();
+      let matches = false;
+      try {
+        matches = JSON.stringify(buildPlanRequest(song, request)) === JSON.stringify(request);
+      } catch {
+        // An edit may also make the old request invalid (no genre or no room left).
+      }
+      if (!matches) {
+        const message = 'The score changed after this plan started. Start a new plan before applying it.';
+        set((state) => ({
+          status: 'failed', error: message,
+          chips: [...state.chips, errorChip('score changed', message)],
+        }));
+        return;
+      }
+      const snapshot = structuredClone(song);
+      for (const section of sections) {
+        // After the last used measure, so the sections follow each other.
+        const placed = placeSection(section.sectionType, section.bars);
+        const updates = sectionUpdates(section, placed.startMeasure);
+        if (updates.length > 0) setChords(updates);
+        // Its chords landed, so a reload keeps the section.
+        commitSection(placed.id);
+      }
+      set({ applied: true, snapshot });
+    },
+
+    undoPlan: () => {
+      const { applied, snapshot } = get();
+      if (!applied || !snapshot) return;
+      // setSong replaces the whole song; the import undo it would clear is unrelated to this plan
+      const { previousImportSong } = useSongStore.getState();
+      restoringSnapshot = true;
+      try {
+        useSongStore.getState().setSong(snapshot);
+      } finally {
+        restoringSnapshot = false;
+      }
+      useSongStore.setState({ previousImportSong });
+      set({ applied: false, snapshot: null });
+    },
+
+    exportTrace: () => {
+      const trace = get().trace;
+      return trace ? JSON.stringify(trace, null, 2) : null;
+    },
+
+    dismiss: () => {
+      if (get().status === 'running') {
+        get().cancelPlan();
+        return;
+      }
+      set(idleState());
+    },
+  };
+});
+
+// A replaced song (Initialize, Load, Import) is not the sketch the plan was
+// made for: drop the run, in flight or done, as generationStore drops its
+// suggestions. undoPlan's own replacement is the exception.
+useSongStore.subscribe((state, prev) => {
+  if (state.songEpoch === prev.songEpoch || restoringSnapshot) return;
+  if (usePlanStore.getState().status !== 'idle') usePlanStore.getState().dismiss();
+});
diff --git a/frontend/src/store/playMuteState.test.ts b/frontend/src/store/playMuteState.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..084f2fe1beef5e07fe6fca1741a2acb6a95f697c
--- /dev/null
+++ b/frontend/src/store/playMuteState.test.ts
@@ -0,0 +1,160 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import type { PlaySettings } from '../models/types.ts';
+import { DEFAULT_PLAY_SETTINGS } from '../engine/playSettings.ts';
+import {
+  playResumeState,
+  setDrumAutoState,
+  setDrumPatternState,
+  setDrumsEnabledState,
+  setHarmonyEnabledState,
+  setHarmonyVolumeState,
+} from './playMuteState.ts';
+import type { PlayMuteState } from './playMuteState.ts';
+
+function state(overrides: Partial<PlaySettings> = {}): PlayMuteState {
+  const settings = { ...DEFAULT_PLAY_SETTINGS, ...overrides };
+  return { settings, ...playResumeState(settings) };
+}
+
+test('Harmony off/on restores the audible level while retaining every other choice', () => {
+  const initial = state({
+    harmonyVolume: 0.37, harmonyOverride: 'trumpet', harmonyRhythmId: 'shuffle',
+    masterVolume: 0.8, bassEnabled: false, bassVolume: 0.2, drumVolume: 0.4,
+    drumMode: 'manual', drumPatternId: 2, visualMode: 'guitar',
+  });
+  const original = structuredClone(initial);
+  const muted = setHarmonyEnabledState(initial, false);
+  assert.deepEqual(muted.settings, { ...initial.settings, harmonyVolume: 0 });
+  assert.equal(muted.lastHarmonyVolume, 0.37);
+  const mutedAgain = setHarmonyEnabledState(muted, false);
+  assert.equal(mutedAgain.lastHarmonyVolume, 0.37);
+  const resumed = setHarmonyEnabledState(mutedAgain, true);
+  assert.deepEqual(resumed.settings, initial.settings);
+  assert.deepEqual(setHarmonyEnabledState(resumed, true), resumed);
+  assert.deepEqual(initial, original);
+});
+
+test('nonzero fader changes refresh Harmony resume volume and zero retains it', () => {
+  let current = setHarmonyEnabledState(state({ harmonyVolume: 0.61 }), false);
+  current = setHarmonyVolumeState(current, 0.24);
+  assert.equal(current.settings.harmonyVolume, 0.24);
+  assert.equal(current.lastHarmonyVolume, 0.24);
+  current = setHarmonyVolumeState(current, 0);
+  assert.equal(current.settings.harmonyVolume, 0);
+  assert.equal(current.lastHarmonyVolume, 0.24);
+  assert.equal(setHarmonyEnabledState(current, true).settings.harmonyVolume, 0.24);
+  assert.equal(setHarmonyVolumeState(current, 4).settings.harmonyVolume, 1);
+  assert.equal(setHarmonyVolumeState(current, -2).settings.harmonyVolume, 0);
+  for (const value of [Number.NaN, Number.POSITIVE_INFINITY]) {
+    const sanitized = setHarmonyVolumeState(current, value);
+    assert.equal(sanitized.settings.harmonyVolume, DEFAULT_PLAY_SETTINGS.harmonyVolume);
+    assert.equal(sanitized.lastHarmonyVolume, DEFAULT_PLAY_SETTINGS.harmonyVolume);
+  }
+});
+
+test('muted browser preferences roundtrip the prior volume and explicit drum pick', () => {
+  let saved = state({ harmonyVolume: 0.43, drumMode: 'manual', drumPatternId: 2, drumVolume: 0.29 });
+  saved = setHarmonyEnabledState(setDrumsEnabledState(saved, false), false);
+  const raw = JSON.parse(JSON.stringify(saved));
+  const reloaded = { settings: raw.settings as PlaySettings, ...playResumeState(raw.settings, raw) };
+  assert.equal(setHarmonyEnabledState(reloaded, true).settings.harmonyVolume, 0.43);
+  const resumed = setDrumsEnabledState(reloaded, true);
+  assert.equal(resumed.settings.drumMode, 'manual');
+  assert.equal(resumed.settings.drumPatternId, 2);
+  assert.equal(resumed.settings.drumVolume, 0.29);
+});
+
+test('live settings are authoritative over stale persisted resume preferences', () => {
+  const settings = state({ harmonyVolume: 0.72, drumMode: 'manual', drumPatternId: 1 }).settings;
+  assert.deepEqual(playResumeState(settings, {
+    lastHarmonyVolume: 0.21, resumeDrum: { drumMode: 'manual', drumPatternId: 2 },
+  }), {
+    lastHarmonyVolume: 0.72, resumeDrum: { drumMode: 'manual', drumPatternId: 1 },
+  });
+});
+
+test('invalid muted resume preferences cannot restore silence or an unknown drum id', () => {
+  const settings = state({ harmonyVolume: 0, drumMode: 'manual', drumPatternId: null }).settings;
+  for (const value of [0, -0.3, Number.NaN, Number.POSITIVE_INFINITY, '0.5', null]) {
+    assert.equal(playResumeState(settings, { lastHarmonyVolume: value }).lastHarmonyVolume,
+      DEFAULT_PLAY_SETTINGS.harmonyVolume);
+  }
+  assert.equal(playResumeState(settings, { lastHarmonyVolume: 8 }).lastHarmonyVolume, 1);
+  for (const resumeDrum of [
+    null, [], 'auto', {},
+    { drumMode: 'manual', drumPatternId: null },
+    { drumMode: 'manual', drumPatternId: 999 },
+    { drumMode: 'auto', drumPatternId: 999 },
+    { drumMode: 'manual', drumPatternId: '2' },
+    { drumMode: 'other', drumPatternId: 2 },
+  ]) {
+    assert.deepEqual(playResumeState(settings, { resumeDrum }).resumeDrum,
+      { drumMode: 'auto', drumPatternId: null });
+  }
+});
+
+test('Drums off/on restores Auto or manual choice without changing output gains', () => {
+  for (const choice of [
+    { drumMode: 'auto' as const, drumPatternId: null },
+    { drumMode: 'auto' as const, drumPatternId: 2 },
+    { drumMode: 'manual' as const, drumPatternId: 1 },
+  ]) {
+    const initial = state({ ...choice, harmonyVolume: 0.38, drumVolume: 0.27 });
+    const muted = setDrumsEnabledState(initial, false);
+    assert.deepEqual(muted.settings, { ...initial.settings, drumMode: 'manual', drumPatternId: null });
+    assert.deepEqual(muted.resumeDrum, choice);
+    const mutedAgain = setDrumsEnabledState(muted, false);
+    assert.deepEqual(mutedAgain.resumeDrum, choice);
+    const resumed = setDrumsEnabledState(mutedAgain, true);
+    assert.deepEqual(resumed.settings, initial.settings);
+    assert.deepEqual(setDrumsEnabledState(resumed, true), resumed);
+  }
+});
+
+test('explicit Off backs up the previous drum selection and new picks turn Drums on', () => {
+  const initial = state({ drumMode: 'manual', drumPatternId: 1, drumVolume: 0.33 });
+  const off = setDrumPatternState(initial, null);
+  assert.deepEqual(off.resumeDrum, { drumMode: 'manual', drumPatternId: 1 });
+  assert.deepEqual(setDrumsEnabledState(off, true).settings, initial.settings);
+  const picked = setDrumPatternState(off, 2);
+  assert.equal(picked.settings.drumMode, 'manual');
+  assert.equal(picked.settings.drumPatternId, 2);
+  assert.deepEqual(picked.resumeDrum, { drumMode: 'manual', drumPatternId: 2 });
+  const automatic = setDrumAutoState(off);
+  assert.equal(automatic.settings.drumMode, 'auto');
+  assert.deepEqual(automatic.resumeDrum, { drumMode: 'auto', drumPatternId: null });
+  assert.equal(automatic.settings.drumVolume, 0.33);
+});
+
+test('unknown drum picks cannot replace the last valid selection', () => {
+  const initial = state({ drumMode: 'manual', drumPatternId: 2 });
+  for (const id of [0, -1, 999, 1.5, Number.NaN, Number.POSITIVE_INFINITY]) {
+    assert.deepEqual(setDrumPatternState(initial, id), initial);
+  }
+});
+
+test('replacement projects derive fresh resume defaults instead of prior project backups', () => {
+  const oldProject = setHarmonyEnabledState(setDrumsEnabledState(state({
+    harmonyVolume: 0.18, drumMode: 'manual', drumPatternId: 2,
+  }), false), false);
+  const newSettings = state({ harmonyVolume: 0, drumMode: 'manual', drumPatternId: null }).settings;
+  const replacement = { settings: newSettings, ...playResumeState(newSettings) };
+  assert.equal(setHarmonyEnabledState(replacement, true).settings.harmonyVolume, DEFAULT_PLAY_SETTINGS.harmonyVolume);
+  assert.deepEqual(setDrumsEnabledState(replacement, true).resumeDrum,
+    { drumMode: 'auto', drumPatternId: null });
+  assert.equal(oldProject.lastHarmonyVolume, 0.18);
+  assert.deepEqual(oldProject.resumeDrum, { drumMode: 'manual', drumPatternId: 2 });
+});
+
+test('Harmony gain mute and Drums scheduling mute remain independent', () => {
+  const initial = state({ harmonyVolume: 0.55, drumMode: 'manual', drumPatternId: 2 });
+  const bothOff = setDrumsEnabledState(setHarmonyEnabledState(initial, false), false);
+  const harmonyOn = setHarmonyEnabledState(bothOff, true);
+  assert.equal(harmonyOn.settings.harmonyVolume, 0.55);
+  assert.equal(harmonyOn.settings.drumMode, 'manual');
+  assert.equal(harmonyOn.settings.drumPatternId, null);
+  const drumsOn = setDrumsEnabledState(bothOff, true);
+  assert.equal(drumsOn.settings.harmonyVolume, 0);
+  assert.equal(drumsOn.settings.drumPatternId, 2);
+});
diff --git a/frontend/src/store/playMuteState.ts b/frontend/src/store/playMuteState.ts
