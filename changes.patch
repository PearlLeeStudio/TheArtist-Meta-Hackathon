+  text-transform: uppercase;
+}
+.te-selection-pane {
+  height: 190px;
+  min-height: 190px;
+  overflow: visible;
+}
+.te-device .te-pane-tab {
+  height: 34px !important;
+  font-size: 12px !important;
+  letter-spacing: -0.02em;
+  text-transform: none;
+}
+.te-device .te-visual-key {
+  height: 26px !important;
+  font-size: 9px !important;
+  letter-spacing: normal;
+  text-transform: none;
+}
+.te-voicing-drawing {
+  --text-muted: var(--screen-text-dim);
+  --text-soft: var(--screen-text-dim);
+  --fret-label: var(--screen-text-dim);
+}
+.te-voicing-drawing svg {
+  max-height: clamp(64px, calc(8dvh - 8px), 124px);
+}
+
+/* VexFlow draws the clef, key and time signatures as SVG text that only inherits a fill;
+   pin them to the theme's stave colour, so they match the stave lines in both themes. */
+.vf-staff text {
+  fill: var(--stave-color);
+}
+
+/* On a full-height desktop, distribute the available height instead of
+   scrolling the hardware enclosure. Smaller windows retain a safe scroll fallback. */
+@media (min-height: 900px) {
+  .te-device {
+    --te-fader-bank-height: clamp(112px, 14dvh, 220px);
+    gap: 6px;
+    overflow-y: hidden;
+  }
+  .te-device .te-selection-pane {
+    height: auto;
+    min-height: 186px;
+    flex: 1 1 186px;
+  }
+}
+
+/* KeyButton. Hover dimming and the 1px press come from .btn-hover. */
+.te-key {
+  font-family: var(--font-device);
+  letter-spacing: 0.06em;
+  color: var(--key-text);
+  background: linear-gradient(180deg, var(--panel-glint), transparent 45%), var(--key-bg);
+  border: 1px solid var(--key-border);
+  border-radius: 4px;
+  box-shadow: var(--key-shadow);
+  -webkit-tap-highlight-color: transparent;
+  transition: opacity 0.15s ease, transform 0.08s ease,
+              background-color 0.08s ease, box-shadow 0.08s ease, color 0.08s ease;
+}
+.te-key[data-active],
+.te-key:active:not(:disabled) {
+  color: var(--key-text-active);
+  background: var(--key-bg-active);
+  box-shadow: var(--key-shadow-active);
+}
+.te-key:disabled {
+  opacity: 0.4;
+  cursor: default;
+  transform: none;
+}
+/* Recessed selection faces, with an amber lamp for the selected state. */
+.te-device .te-key:not(.te-transport__key) {
+  border: 1px solid transparent;
+  border-radius: 3px;
+  background: var(--selection-face);
+  color: var(--key-text);
+  box-shadow: var(--selection-shadow);
+}
+.te-device .te-key:not(.te-transport__key)[data-active],
+.te-device .te-key:not(.te-transport__key):active:not(:disabled) {
+  --key-text-dim: #6b5a3e;
+  background: radial-gradient(ellipse at 50% 42%, #fff0bb, #ebca8f 72%, #c39b62);
+  color: #3b3122;
+  box-shadow: inset 0 2px 4px #76542e55, inset 0 -1px 0 #fff6cfb3,
+              0 0 4px #edc47f33;
+}
+.te-device .te-key:not(.te-transport__key):hover {
+  filter: brightness(1.04);
+  opacity: 1;
+}
+/* The yellow focus ring barely shows on the light panel: use the key text colour. */
+:root.light .te-key:focus-visible {
+  outline-color: var(--key-text);
+}
+/* Forced colours drop the key backgrounds: outline the latched keys. */
+@media (forced-colors: active) {
+  .te-key[data-active]:not(:focus-visible) {
+    outline: 2px solid Highlight;
+    outline-offset: -4px;
+  }
+}
+
+/* Screen. */
+.te-screen {
+  font-family: var(--font-device);
+  color: var(--screen-text);
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0) 45%), var(--screen-bg);
+  border-radius: 3px;
+  box-shadow: var(--screen-shadow);
+  --key-text-dim: var(--screen-text-dim);
+}
