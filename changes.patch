diff --git a/frontend/src/components/RightPanel/play/ChoiceKeyGrid.tsx b/frontend/src/components/RightPanel/play/ChoiceKeyGrid.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..16ff0b3143e44ec5cdbc9f4e2ac21148c70d4fec
--- /dev/null
+++ b/frontend/src/components/RightPanel/play/ChoiceKeyGrid.tsx
@@ -0,0 +1,42 @@
+import { pickedLabelStyle } from './paneKeys';
+
+interface Choice {
+  id: string | number;
+  label: string;
+  ariaLabel?: string;
+  title: string;
+  checked: boolean;
+  onSelect: () => void;
+}
+
+interface ChoiceKeyGridProps {
+  choices: Choice[];
+  /** Full width (w-full), as the Drums grid has. */
+  fullWidth?: boolean;
+}
+
+const COLUMNS = 4;
+
+/** Radio keys four to a row; the rows share the pane's remaining height,
+ *  each at least as tall as an sm key (26px). Labels wrap inside the key. */
+export default function ChoiceKeyGrid({ choices, fullWidth }: ChoiceKeyGridProps) {
+  return (
+    <div className={fullWidth ? 'grid min-h-0 w-full flex-1 gap-[3px]' : 'grid min-h-0 flex-1 gap-[3px]'}
+      style={{
+        gridTemplateColumns: `repeat(${COLUMNS}, minmax(0, 1fr))`,
+        gridTemplateRows: `repeat(${Math.ceil(choices.length / COLUMNS)}, minmax(26px, 1fr))`,
+      }}
+    >
+      {choices.map((choice) => (
+        <button key={choice.id} type="button" role="radio" aria-label={choice.ariaLabel}
+          aria-checked={choice.checked} tabIndex={choice.checked ? 0 : -1}
+          data-active={choice.checked ? '' : undefined} onClick={choice.onSelect} title={choice.title}
+          className="te-key btn-hover h-full min-w-0"
+          style={{ minHeight: 26, padding: '0 3px', fontSize: 12, lineHeight: '12px', letterSpacing: 'normal',
+            whiteSpace: 'normal', overflowWrap: 'anywhere', ...pickedLabelStyle(choice.checked) }}>
+          {choice.label}
+        </button>
+      ))}
+    </div>
+  );
+}
diff --git a/frontend/src/components/RightPanel/play/ControllerPane.tsx b/frontend/src/components/RightPanel/play/ControllerPane.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..140c203ea255e264c85e1040b9a00de454ee16d0
--- /dev/null
+++ b/frontend/src/components/RightPanel/play/ControllerPane.tsx
@@ -0,0 +1,45 @@
+import { DEFAULT_PLAY_SETTINGS } from '../../../engine/playSettings';
+import { usePlayStore } from '../../../store/playStore';
+import { useSongStore } from '../../../store/songStore';
+import VolumeFader from './ui/VolumeFader';
+
+/** The tempo range the song store clamps to, and a new song's tempo, which
+ *  a double-click on the BPM fader restores. */
+const MIN_BPM = 20;
+const MAX_BPM = 300;
+const DEFAULT_BPM = 80;
+
+/** Tempo and four independent mix controls; the master scales the complete mix. */
+export default function ControllerPane() {
+  const bpm = useSongStore((s) => s.song.bpm);
+  const setBpmLive = useSongStore((s) => s.setBpmLive);
+  const settings = usePlayStore((s) => s.settings);
+  const setMasterVolume = usePlayStore((s) => s.setMasterVolume);
+  const setHarmonyVolume = usePlayStore((s) => s.setHarmonyVolume);
+  const setBassVolume = usePlayStore((s) => s.setBassVolume);
+  const setDrumVolume = usePlayStore((s) => s.setDrumVolume);
+  // Gains are 0..1 in the store and 0..100 on the faders.
+  const channels = [
+    { id: 'master', label: 'Master', value: settings.masterVolume, initial: DEFAULT_PLAY_SETTINGS.masterVolume, set: setMasterVolume },
+    { id: 'harmony', label: 'Harmony', value: settings.harmonyVolume, initial: DEFAULT_PLAY_SETTINGS.harmonyVolume, set: setHarmonyVolume },
+    { id: 'bass', label: 'Bass', value: settings.bassVolume, initial: DEFAULT_PLAY_SETTINGS.bassVolume, set: setBassVolume },
+    { id: 'drums', label: 'Drums', value: settings.drumVolume, initial: DEFAULT_PLAY_SETTINGS.drumVolume, set: setDrumVolume },
+  ];
+  return (
+    <div className="h-full min-h-0 overflow-y-auto overscroll-contain">
+      <div role="group" aria-label="Controller view" className="te-volume-bank">
+        <VolumeFader label="BPM" ariaLabel="Tempo in beats per minute" value={bpm}
+          min={MIN_BPM} max={MAX_BPM} step={1} defaultValue={DEFAULT_BPM} onChange={setBpmLive} />
+        {channels.map((channel) => (
+          <VolumeFader
+            key={channel.id}
+            label={channel.label}
+            value={Math.round(channel.value * 100)}
+            defaultValue={Math.round(channel.initial * 100)}
+            onChange={(value) => channel.set(value / 100)}
+          />
+        ))}
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/RightPanel/play/DrumsPane.tsx b/frontend/src/components/RightPanel/play/DrumsPane.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6c334f3f8f82e6bb180451396c5c0626f7a0333c
--- /dev/null
+++ b/frontend/src/components/RightPanel/play/DrumsPane.tsx
@@ -0,0 +1,64 @@
+// The shared playback status stays visible above this selection grid.
+import { DRUM_PATTERNS, drumPatternById } from '../../../engine/drumPatterns';
+import { genreDrumPatternId } from '../../../engine/playSettings';
+import { usePlayStore } from '../../../store/playStore';
+import { useSongStore } from '../../../store/songStore';
+import ChoiceKeyGrid from './ChoiceKeyGrid';
+import { genreTag } from './genreTag';
+import { moveChoiceByKey, WIDE_KEY_STYLE } from './paneKeys';
+
+/** Drums: follow the genre (Auto), off, or one of the 15 patterns. A pick
+ *  stays when the genre changes. */
+export default function DrumsPane() {
+  const settings = usePlayStore((s) => s.settings);
+  const setDrumAuto = usePlayStore((s) => s.setDrumAuto);
+  const setDrumPattern = usePlayStore((s) => s.setDrumPattern);
+  const setDrumsEnabled = usePlayStore((s) => s.setDrumsEnabled);
+  const genre = useSongStore((s) => s.song.genre);
+
+  const isAuto = settings.drumMode === 'auto';
+  const isOff = !isAuto && settings.drumPatternId === null;
+  const drumsOn = !isOff;
+  // With drums off no pattern is checked, so Auto keeps the group's tab stop.
+  const autoTabStop = isAuto || isOff;
+  const genreId = genreDrumPatternId(genre);
+  const genrePattern = drumPatternById(genreId);
+  const tag = genreTag(genre);
+  const autoTitle = genrePattern
+    ? `Auto: drums follow the genre (${genrePattern.name} for ${tag})`
+    : 'Auto: no genre set, so no drums';
+  const choices = DRUM_PATTERNS.map((pattern) => {
+    const swingNote = pattern.swing ? ' · swing' : '';
+    const autoNote = isAuto && pattern.id === genreId ? ` · Auto plays this for ${tag}` : '';
+    return {
+      id: pattern.id,
+      label: pattern.name,
+      ariaLabel: pattern.name,
+      checked: !isAuto && settings.drumPatternId === pattern.id,
+      onSelect: () => setDrumPattern(pattern.id),
+      title: `${pattern.name}${swingNote}${autoNote}`,
+    };
+  });
+
+  return (
+    <div className="te-choice-grid flex h-full min-h-0 min-w-0 flex-col gap-1 p-[3px]">
+      <button type="button" aria-pressed={drumsOn} data-active={drumsOn ? '' : undefined}
+        onClick={() => setDrumsEnabled(!drumsOn)} className="te-key btn-hover w-full shrink-0 px-2"
+        style={{ ...WIDE_KEY_STYLE, fontWeight: drumsOn ? 700 : 400 }}
+        title={drumsOn ? 'Turn drums off while keeping the current pattern.' : 'Turn drums on and restore the previous pattern.'}>
+        Drums {drumsOn ? 'on' : 'off'}
+      </button>
+
+      <div role="radiogroup" aria-label="Drum pattern" onKeyDown={(event) => moveChoiceByKey(event, '[role="radio"]')}
+        className="flex min-h-0 flex-1 flex-col gap-1">
+        <button type="button" role="radio" aria-label="Auto drum pattern" aria-checked={isAuto}
+          tabIndex={autoTabStop ? 0 : -1} data-active={isAuto ? '' : undefined}
+          onClick={setDrumAuto} title={autoTitle} className="te-key btn-hover w-full shrink-0 px-2"
+          style={{ ...WIDE_KEY_STYLE, fontWeight: isAuto ? 700 : 400 }}>
+          Auto
+        </button>
+        <ChoiceKeyGrid fullWidth choices={choices} />
+      </div>
+    </div>
+  );
+}
