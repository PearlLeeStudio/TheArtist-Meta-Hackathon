+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  MAX_SCORE_IMPORT_BYTES,
+  buildImportedSong,
+  buildScoreImportForEditor,
+  checkScoreFile,
+  createScoreImportDraft,
+  importMeasureRomanPreview,
+  metaAssistSummary,
+  scoreImportReadyStatus,
+  scoreImportRequestBody,
+  parseImportedChord,
+  readScoreImportResponse,
+  validateScoreImportDraft,
+  validateScoreImportForEditor,
+} from './scoreImport.ts';
+import type { ScoreImportResponse } from './scoreImport.ts';
+import { withoutImportedContent } from './importRetention.ts';
+import { needsSourceReview } from '../components/ScoreEditor/importedBars.ts';
+
+const response = (patch: Partial<ScoreImportResponse> = {}): ScoreImportResponse => ({
+  title: 'Paper sketch',
+  key: 'C major',
+  timeSignature: [4, 4],
+  measures: [
+    { chords: ['Cmaj7'], sourceLabel: 'Page 1, bar 1', needsReview: false, note: '' },
+    { chords: ['Dm7', 'G7'], sourceLabel: 'Page 1, bar 2', needsReview: false, note: '' },
+  ],
+  sections: [{ section: 'verse', label: 'Verse', startMeasure: 0, length: 2, basis: 'inferred', note: 'No printed section label.' }],
+  warnings: [],
+  model: 'muse-spark-1.3',
+  requestId: 'request-test',
+  ...patch,
+});
+
+test('verified reading requires comparison evidence and preserves review notes', () => {
+  const verified = response({ verification: { status: 'compared', localMeasures: 2, metaMeasures: 2,
+    comparedMeasures: 2, disputedMeasures: [1], notes: ['Meter needs review.'] } });
+  assert.equal(scoreImportRequestBody('score.pdf', 'application/pdf', 'data', 'chord_symbols', 'verified').engine, 'verified');
+  const parsed = readScoreImportResponse(verified, 'chord_symbols', 'verified');
+  const draft = createScoreImportDraft(parsed, 'score.pdf');
+  assert.deepEqual(draft.verification, { ...verified.verification, notes: [] });
+  assert.match(scoreImportReadyStatus(draft, 'verified'), /2 bars; 1 differences flagged/);
+  assert.throws(() => readScoreImportResponse(response(), 'chord_symbols', 'verified'));
+  assert.throws(() => readScoreImportResponse({ ...verified, verification: { ...verified.verification, disputedMeasures: [2] } }, 'chord_symbols', 'verified'));
+  assert.throws(() => readScoreImportResponse({ ...verified, verification: { ...verified.verification, metaMeasures: 3 } }, 'chord_symbols', 'verified'));
+});
+
+test('an unaligned comparison of a long local reading is accepted up to the 512-bar import limit', () => {
+  const measures = Array.from({ length: 300 }, (_, i) => ({ chords: ['C'], sourceLabel: `Bar ${i + 1}`, needsReview: true, note: 'Local/Meta comparison: bar alignment could not be established.', analysisSource: 'local' as const, model: null, requestId: null }));
+  const raw = response({ analysisSource: 'mixed', measures, sections: [], verification: {
+    status: 'unaligned', localMeasures: 300, metaMeasures: 128, comparedMeasures: 0,
+    disputedMeasures: measures.map((_, i) => i), notes: ['Bar counts differ: local 300; Meta 128.'],
+  } });
+  const parsed = readScoreImportResponse(raw, 'chord_symbols', 'verified');
+  assert.equal(parsed.verification?.disputedMeasures.length, 300);
+  assert.throws(() => readScoreImportResponse({ ...raw, verification: { ...raw.verification!, metaMeasures: 513 } }, 'chord_symbols', 'verified'));
+});
+
+test('unavailable local comparison is never described as cross-checked', () => {
+  const parsed = readScoreImportResponse(response({ verification: {
+    status: 'local_unavailable', localMeasures: 0, metaMeasures: 2,
+    comparedMeasures: 0, disputedMeasures: [], notes: ['Review every bar.'],
+  } }), 'chord_symbols', 'verified');
+  const status = scoreImportReadyStatus(createScoreImportDraft(parsed, 'score.pdf'), 'verified');
+  assert.match(status, /Local cross-checking was unavailable/);
+  assert.doesNotMatch(status, /compared 2/);
+});
+
+test('Meta failure opens the local reading with unresolved bars ready for editor generation', () => {
+  const raw = response({ analysisSource: 'local', model: null, requestId: null, sections: [],
+    verification: { status: 'local_fallback', localMeasures: 2, metaMeasures: 0, comparedMeasures: 0,
+      disputedMeasures: [], notes: ['Meta unavailable; local analysis recovered the score.'] },
+    measures: [{ chords: ['C'], sourceLabel: '1', needsReview: false, note: '' },
+      { chords: [], sourceLabel: '2', needsReview: true, note: 'Unreadable source' }],
+  });
+  const draft = createScoreImportDraft(readScoreImportResponse(raw, 'chord_symbols', 'verified'), 'score.pdf');
+  assert.equal(validateScoreImportForEditor(draft).valid, true);
+  const song = buildScoreImportForEditor(draft);
