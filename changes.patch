index 0000000000000000000000000000000000000000..df1b491d78e46a20e0406f6ed1a560a652d4cfb6
--- /dev/null
+++ b/frontend/src/store/reviewStore.test.ts
@@ -0,0 +1,242 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { registerHooks } from 'node:module';
+import type { Chord, Measure, SlotAddress, Song } from '../models/types.ts';
+import type { Suggestion } from '../engine/chordGenerator.ts';
+import type { ReviewResult } from './reviewStore.ts';
+
+// The stores import their modules without extensions (Vite resolves them),
+// and songStore reaches the Web Audio stack through engine/playback. Resolve
+// `.ts` for the relative imports under src/ and stand in for playback with
+// the three no-ops songStore uses, so the stores load without a bundler.
+const SRC_URL = new URL('../', import.meta.url).href;
+registerHooks({
+  resolve(specifier, context, nextResolve) {
+    if (context.parentURL?.startsWith(SRC_URL) && /^\.\.?\//.test(specifier) && !/\.\w+$/.test(specifier)) {
+      specifier += '.ts';
+    }
+    return nextResolve(specifier, context);
+  },
+  load(url, context, nextLoad) {
+    if (url === `${SRC_URL}engine/playback.ts`) {
+      return {
+        format: 'module',
+        shortCircuit: true,
+        source: 'export function cancelPendingStart() {}\nexport function setLiveBpm() {}\nexport function stopPlayback() {}\n',
+      };
+    }
+    return nextLoad(url, context);
+  },
+});
+// Node's own localStorage wants a storage file and warns without one; the
+// stores read it while loading, and the session id is kept here. songStore's
+// autosave reaches the timers through window.
+const storage = new Map<string, string>();
+Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: {
+  getItem: (key: string) => storage.get(key) ?? null,
+  setItem: (key: string, value: string) => { storage.set(key, value); },
+} });
+Object.defineProperty(globalThis, 'window', { configurable: true, value: globalThis });
+
+const { buildReviewRequest, reasonFact, rulesSlotCount, useReviewStore } = await import('./reviewStore.ts');
+const { useGenerationStore } = await import('./generationStore.ts');
+const { useSongStore } = await import('./songStore.ts');
+const { captureGenerationComparison } = await import('../engine/generationComparison.ts');
+
+const chord = (root: string, quality: string, bass?: string): Chord =>
+  ({ root, quality, bass, extensions: [], romanNumeral: '', voicing: [] });
+const measure = (index: number, chords: [Chord | null, Chord | null]): Measure => ({ id: `m${index}`, index, chords });
+
+/** A 2-bar verse, then a 2-bar chorus the A/B/C list was generated for, then two empty bars. */
+function chorusSong(): Song {
+  return {
+    id: 'review', title: 'Verse–Chorus', key: 'C major', bpm: 100, genre: 'pop', timeSignature: [4, 4],
+    measures: [
+      measure(0, [chord('C', 'maj7'), chord('A', 'm7')]),
+      measure(1, [chord('F', 'maj7'), chord('G', '7')]),
+      measure(2, [chord('C', 'maj7'), chord('A', 'm7')]),
+      measure(3, [{ ...chord('D', 'm7'), extensions: ['9'] }, chord('G', '7')]),
+      measure(4, [null, null]),
+      measure(5, [null, null]),
+    ],
+    sections: [
+      { id: 'verse', type: 'verse', startMeasure: 0, length: 2 },
+      { id: 'chorus', type: 'chorus', startMeasure: 2, length: 2 },
+    ],
+  };
+}
+
+// The run targeted the chorus from its second slot: slot 2.0 is not the request's
+const TARGET: SlotAddress[] = [{ measureIndex: 2, slotIndex: 1 }, { measureIndex: 3, slotIndex: 0 }, { measureIndex: 3, slotIndex: 1 }];
+const SUGGESTIONS: Suggestion[] = [
+  { label: 'Option A — F1 (conservative)', chords: { 2: ['Cmaj7', 'Am7'], 3: ['Dm7', 'G7'] } },
+  { label: 'Option B — F1 (balanced)', chords: { 2: ['Em7', 'Ab7'], 3: ['Dm7/F', 'G7'] } },
+  { label: 'Option C — F1 (creative)', chords: { 2: ['Cmaj', 'Amin'], 3: ['Bb7', 'Cmaj'] } },
+];
+const RESULT: ReviewResult = {
+  choice: 'C',
+  reasons: [
+    { fact: 'r1Roughness=0.48', factName: 'r1Roughness', value: 0.48, claim: 'The smoothest of the three.', confirmed: true, analyzerValue: 0.484 },
+    { fact: 'changedSlots=1', factName: 'changedSlots', value: 1, claim: 'It keeps the original.', confirmed: false, analyzerValue: 3 },
+  ],
+  facts: [
+    { label: 'A', outOfKeyRatio: 0, changedSlots: 1, repetitionVsPrevious: 0.75, r1Roughness: 0.745, rulesSlots: [2, 3] },
+    { label: 'B', outOfKeyRatio: 0.25, changedSlots: 2, repetitionVsPrevious: 0.5, r1Roughness: 0.831, rulesSlots: [2, 3] },
+    { label: 'C', outOfKeyRatio: 0.25, changedSlots: 3, repetitionVsPrevious: 0.25, r1Roughness: 0.484, rulesSlots: [2, 3] },
+  ],
+  provider: 'meta', model: 'muse-spark-1.3', requestId: 'req_1', costUsd: 0.0027, latencyMs: 1800, source: 'judge',
+};
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+}
+
+/** The chorus list on screen, as a finished Generate leaves it. */
+function showList(sectionChoice: 'auto' | 'bridge' = 'auto'): void {
+  useSongStore.getState().setSong(chorusSong());
+  const { song, songEpoch } = useSongStore.getState();
+  useGenerationStore.setState({
+    suggestions: SUGGESTIONS, targetSlots: TARGET, comparison: captureGenerationComparison(song, TARGET, songEpoch),
+    source: 'ai', showSuggestions: true, activeSuggestionIdx: null, loading: false, generateSectionType: sectionChoice,
+  });
+}
+
+test('the request is the list as Apply would write it, with the previous section from the same offset', () => {
+  const song = chorusSong();
+  const request = buildReviewRequest(song, SUGGESTIONS, captureGenerationComparison(song, TARGET, 0), 'auto');
+  assert.deepEqual(request, {
+    key: 'C major', genre: 'pop', sectionType: 'chorus',
+    // Slot 2.0 keeps the score's Cmaj7 under every candidate; the staff writes 'Cmaj' as C and 'Amin' as Am
+    original: [['Cmaj7', 'Am7'], ['Dm7(9)', 'G7']],
+    candidates: [
+      { label: 'A', chords: [['Cmaj7', 'Am7'], ['Dm7', 'G7']] },
+      { label: 'B', chords: [['Cmaj7', 'Ab7'], ['Dm7/F', 'G7']] },
+      { label: 'C', chords: [['Cmaj7', 'Am'], ['Bb7', 'C']] },
+    ],
+    previousSection: [['Cmaj7', 'Am7'], ['Fmaj7', 'G7']],
+  });
+  // The chorus's second bar compares with the verse's second bar; an explicit pick wins over the section
+  const secondBar: SlotAddress[] = [{ measureIndex: 3, slotIndex: 0 }, { measureIndex: 3, slotIndex: 1 }];
+  const later = buildReviewRequest(song, SUGGESTIONS, captureGenerationComparison(song, secondBar, 0), 'bridge');
+  assert.equal(later.sectionType, 'bridge');
+  assert.deepEqual(later.previousSection, [['Fmaj7', 'G7']]);
+  assert.deepEqual(later.candidates[1].chords, [['Dm7/F', 'G7']]);
+  // A New-from-Song-Form list was generated for its placed section, whatever the dropdown says
+  const placed = captureGenerationComparison(song, TARGET, 0, 'section');
+  assert.equal(buildReviewRequest(song, SUGGESTIONS, placed, 'bridge').sectionType, 'chorus');
+  // Bars outside any section: no rules under Auto and nothing to repeat
+  const loose = { ...song, sections: [] };
+  const plain = buildReviewRequest(loose, SUGGESTIONS, captureGenerationComparison(loose, TARGET, 0), 'auto');
+  assert.equal(plain.sectionType, null);
+  assert.equal(plain.previousSection, null);
+});
+
+test('a review posts the list with the session id and keeps the judge\'s verified answer', async (t) => {
+  showList();
+  const expected = buildReviewRequest(useSongStore.getState().song, SUGGESTIONS, useGenerationStore.getState().comparison!, 'auto');
+  const fetchMock = t.mock.method(globalThis, 'fetch', async (input: RequestInfo | URL, init?: RequestInit) => {
+    assert.equal(input, '/api/review/candidates');
+    assert.equal(init?.method, 'POST');
+    const headers = new Headers(init?.headers);
+    assert.match(headers.get('X-TheArtist-Session') ?? '', /^[0-9a-f-]{36}$/);
+    assert.equal(headers.get('X-TheArtist-Session'), storage.get('theartist-meta-session'));
+    assert.deepEqual(JSON.parse(String(init?.body)), expected);
+    return json(RESULT);
+  });
+  const run = useReviewStore.getState().runReview();
+  assert.equal(useReviewStore.getState().loading, true);
+  await run;
+  const state = useReviewStore.getState();
+  assert.equal(fetchMock.mock.callCount(), 1);
+  assert.deepEqual(state.result, RESULT);
+  assert.deepEqual(state.request, expected);
+  assert.equal(state.loading, false);
+  assert.equal(state.error, null);
+  // A confirmed fact shows the analyzer's value and its rank; a model statement the judge's own value
+  assert.deepEqual(RESULT.reasons.map((reason) => reasonFact(RESULT, reason)), ['roughness 0.484, lowest', 'changed slots 1']);
+  assert.equal(rulesSlotCount(RESULT), 2);
+  assert.equal(reasonFact({ ...RESULT, choice: 'A' }, { ...RESULT.reasons[1], confirmed: true }), 'changed slots 3, fewest');
+  assert.equal(reasonFact(RESULT, { ...RESULT.reasons[0], factName: 'outOfKeyRatio', analyzerValue: 0.25 }), 'out-of-key 0.25');
+  // Nothing was applied
+  assert.equal(useGenerationStore.getState().activeSuggestionIdx, null);
+  assert.equal(useSongStore.getState().song.measures[2].chords[1]?.quality, 'm7');
+});
+
+test('a failed review shows the server\'s detail with its request id and spend; a 429 its reset time', async (t) => {
+  showList();
+  const mock = t.mock.method(globalThis, 'fetch', async () => json({
+    detail: 'meta (muse-spark-1.3) did not answer within 30s',
+    error: { kind: 'timeout', message: 'meta (muse-spark-1.3) did not answer within 30s', requestId: 'req_9' },
+    provider: 'meta', model: 'muse-spark-1.3', costUsd: 0.00552, latencyMs: 30000,
+  }, 504));
+  await useReviewStore.getState().runReview();
+  assert.equal(useReviewStore.getState().error,
+    'Second ear failed: meta (muse-spark-1.3) did not answer within 30s · request req_9 · $0.0055');
+  assert.equal(useReviewStore.getState().result, null);
+  assert.equal(useReviewStore.getState().loading, false);
+  mock.mock.restore();
+
+  const limited = t.mock.method(globalThis, 'fetch', async () => json({ detail: 'This session\'s daily Meta allowance is used '
+    + 'up: $0.99 admitted today + this request\'s worst case $0.03 would pass $1.00. Allowances reset at 00:00 UTC.' }, 429));
+  await useReviewStore.getState().runReview();
+  assert.match(useReviewStore.getState().error ?? '', /^Second ear failed: This session's daily Meta allowance .* reset at 00:00 UTC\.$/);
+  limited.mock.restore();
+
+  const gateway = t.mock.method(globalThis, 'fetch', async () => new Response('Bad gateway', { status: 502 }));
+  await useReviewStore.getState().runReview();
+  assert.equal(useReviewStore.getState().error, 'Second ear failed: Server error (HTTP 502)');
+  gateway.mock.restore();
+
+  t.mock.method(globalThis, 'fetch', async () => { throw new TypeError('Failed to fetch'); });
+  await useReviewStore.getState().runReview();
+  assert.match(useReviewStore.getState().error ?? '', /Could not reach the server/);
+  assert.equal(useReviewStore.getState().result, null);
+});
+
+test('new suggestions, Keep current version and a replaced song drop the review; a late answer is ignored', async (t) => {
+  showList();
+  t.mock.method(globalThis, 'fetch', async () => json(RESULT));
+  await useReviewStore.getState().runReview();
+  assert.notEqual(useReviewStore.getState().result, null);
+  useGenerationStore.setState({ suggestions: [...SUGGESTIONS] });  // a new run's list
+  assert.deepEqual(
+    [useReviewStore.getState().result, useReviewStore.getState().request, useReviewStore.getState().loading],
+    [null, null, false]);
+
+  await useReviewStore.getState().runReview();
+  useGenerationStore.getState().clearSuggestions();  // Keep current version
+  assert.equal(useReviewStore.getState().result, null);
+
+  showList();
+  await useReviewStore.getState().runReview();
+  useSongStore.getState().clearSong();
+  assert.equal(useReviewStore.getState().result, null);
+
+  // A review still in flight when the list changes is aborted and its answer dropped
+  showList();
+  let signal: AbortSignal | undefined;
+  t.mock.method(globalThis, 'fetch', (_input: RequestInfo | URL, init?: RequestInit) => new Promise<Response>((_resolve, reject) => {
+    signal = init?.signal ?? undefined;
+    signal?.addEventListener('abort', () => reject(signal?.reason), { once: true });
+  }));
+  const pending = useReviewStore.getState().runReview();
+  assert.equal(useReviewStore.getState().loading, true);
+  useGenerationStore.setState({ suggestions: [...SUGGESTIONS] });
+  assert.equal(signal?.aborted, true);
+  await pending;
+  assert.deepEqual([useReviewStore.getState().loading, useReviewStore.getState().error, useReviewStore.getState().result],
+    [false, null, null]);
+});
+
+test('no review runs without a comparison, for one candidate or while a generation is in flight', async (t) => {
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => json(RESULT));
+  showList();
+  useGenerationStore.setState({ loading: true });
+  await useReviewStore.getState().runReview();
+  useGenerationStore.setState({ loading: false, suggestions: SUGGESTIONS.slice(0, 1) });
+  await useReviewStore.getState().runReview();
+  useGenerationStore.setState({ suggestions: SUGGESTIONS, comparison: null });
+  await useReviewStore.getState().runReview();
+  assert.equal(fetchMock.mock.callCount(), 0);
+  assert.equal(useReviewStore.getState().loading, false);
+});
diff --git a/frontend/src/store/reviewStore.ts b/frontend/src/store/reviewStore.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c72611ed5f6328d3d7f31f37791ecc7240854df
--- /dev/null
+++ b/frontend/src/store/reviewStore.ts
@@ -0,0 +1,267 @@
+/**
+ * ReviewStore — the "Second ear" over the A/B/C list: one POST
+ * /api/review/candidates, then its result or its failure.
+ *
+ * The request is the list as the comparison shows it: every candidate as
+ * Apply would write it over the captured Original (compareCandidate), the
+ * score's own chords in the slots of those measures the run did not target,
+ * and, when the bars sit in a section, the section before it from the same
+ * offset. The server computes the facts and checks the judge's reasons
+ * against them; nothing here touches the score. New suggestions or a
+ * replaced song drop the review, and an answer for an older list is ignored.
+ */
+import { create } from 'zustand';
+import type { Chord, SectionType, SlotAddress, Song, SongSection } from '../models/types';
+import { parseSuggestionChords, type Suggestion } from '../engine/chordGenerator';
+import { chordToString } from '../engine/chordParser';
+import { formatChordSymbol } from '../engine/chordDisplay';
+import { compareCandidate, slotKey, type GenerationComparison } from '../engine/generationComparison';
+import { metaHeaders } from '../engine/metaSession';
+import { planGenre } from '../engine/planClient';
+import { formatErrorDetail, postJson } from '../engine/httpClient';
+import { sectionContaining } from '../engine/songForm';
+import { useGenerationStore } from './generationStore';
+import { useSongStore } from './songStore';
+
+/** The backend's chord symbol limit (models/review.py). */
+const MAX_SYMBOL_CHARS = 32;
+
+type Bars = Array<[string | null, string | null]>;
+
+/** Body of POST /api/review/candidates (backend/app/models/review.py). */
+export interface ReviewRequest {
+  key: string;
+  genre: string | null;
+  sectionType: SectionType | null;
+  original: Bars;
+  candidates: Array<{ label: string; chords: Bars }>;
+  previousSection: Bars | null;
+}
+
+export type ReviewFactName = 'outOfKeyRatio' | 'changedSlots' | 'repetitionVsPrevious' | 'r1Roughness';
+
+/** What the analyzer computed about one candidate. */
+export interface CandidateFacts {
+  label: string;
+  outOfKeyRatio: number | null;
+  changedSlots: number;
+  repetitionVsPrevious: number | null;
+  r1Roughness: number | null;
+  /** Slots (0-based over the bars) the song-form rules write for the section type. */
+  rulesSlots: number[];
+}
+
+export interface ReviewReason {
+  /** '<factName>=<value>' as the judge stated it. */
+  fact: string;
+  factName: ReviewFactName;
+  value: number | null;
+  claim: string;
+  /** The analyzer's table holds that value for the chosen candidate. */
+  confirmed: boolean;
+  analyzerValue: number | null;
+}
+
+export interface ReviewResult {
+  choice: string;
+  reasons: ReviewReason[];
+  facts: CandidateFacts[];
+  provider: string;
+  model: string;
+  requestId: string | null;
+  costUsd: number;
+  latencyMs: number;
+  source: 'judge';
+}
+
+interface ReviewState {
+  loading: boolean;
+  /** The body of the newest review, as sent. */
+  request: ReviewRequest | null;
+  result: ReviewResult | null;
+  error: string | null;
+  /** Id of the newest review; answers of older ones are ignored. */
+  runId: number;
+  /** Ask the judge about the A/B/C list on screen. */
+  runReview: () => Promise<void>;
+  /** Drop the review, aborting one in flight. */
+  clear: () => void;
+}
+
+/** The chord as the review sends it: the staff's symbol with its extensions, e.g. 'C7(b9)/E'. */
+function reviewSymbol(chord: Chord | null): string | null {
+  if (!chord) return null;
+  const full = formatChordSymbol(chord);
+  return full.length <= MAX_SYMBOL_CHARS ? full : chordToString(chord).slice(0, MAX_SYMBOL_CHARS);
+}
+
+/** The bars of `measures` with each slot's chord from `chordAt`. */
+function barsOf(measures: number[], chordAt: (address: SlotAddress) => Chord | null): Bars {
+  return measures.map((measureIndex) => [
+    reviewSymbol(chordAt({ measureIndex, slotIndex: 0 })),
+    reviewSymbol(chordAt({ measureIndex, slotIndex: 1 })),
+  ]);
+}
+
+/** The section before `section` in measure order, from the same offset and for at most `count` bars;
+ *  null when there is none or it is too short to reach that offset. */
+function previousSectionBars(song: Song, section: SongSection | null, offset: number, count: number): Bars | null {
+  if (!section) return null;
+  const previous = (song.sections ?? [])
+    .filter((s) => s.startMeasure + s.length <= section.startMeasure)
+    .reduce<SongSection | null>((latest, s) => (!latest || s.startMeasure > latest.startMeasure ? s : latest), null);
+  if (!previous || offset >= previous.length) return null;
+  const start = previous.startMeasure + offset;
+  const measures = song.measures.slice(start, start + Math.min(count, previous.length - offset));
+  if (measures.length === 0) return null;
+  return measures.map((measure) => [reviewSymbol(measure.chords[0]), reviewSymbol(measure.chords[1])]);
+}
+
+/** The review's body for the A/B/C list (see the module comment). `sectionChoice` is the
+ *  Section dropdown Generate read: 'auto' is the section containing the bars, if any. */
+export function buildReviewRequest(
+  song: Song,
+  suggestions: readonly Suggestion[],
+  comparison: GenerationComparison,
+  sectionChoice: SectionType | 'auto',
+): ReviewRequest {
+  const measures = [...new Set(comparison.original.map((slot) => slot.address.measureIndex))].sort((a, b) => a - b);
+  if (measures.length === 0) throw new Error('There are no bars to compare');
+  const scoreChord = (address: SlotAddress) => song.measures[address.measureIndex]?.chords[address.slotIndex] ?? null;
+  const captured = new Map(comparison.original.map((slot) => [slotKey(slot.address), slot.chord]));
+  const candidates = suggestions.map((suggestion, index) => {
+    const after = new Map(compareCandidate(comparison, parseSuggestionChords(suggestion))
+      .map((row) => [slotKey(row.address), row.after]));
+    const chordAt = (address: SlotAddress) => after.has(slotKey(address)) ? after.get(slotKey(address))! : scoreChord(address);
+    return { label: String.fromCharCode(65 + index), chords: barsOf(measures, chordAt) };
+  });
+  const section = sectionContaining(song, measures);
+  return {
+    key: song.key,
+    genre: planGenre(song),
+    // A New-from-Song-Form list was generated for its placed section, whatever the Generate dropdown says
+    sectionType: comparison.kind === 'section' || sectionChoice === 'auto' ? section?.type ?? null : sectionChoice,
+    original: barsOf(measures, (address) =>
+      captured.has(slotKey(address)) ? captured.get(slotKey(address))! : scoreChord(address)),
+    candidates,
+    previousSection: previousSectionBars(song, section, section ? measures[0] - section.startMeasure : 0, measures.length),
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function isReviewResult(value: unknown): value is ReviewResult {
+  return isRecord(value) && value.source === 'judge' && typeof value.choice === 'string' &&
+    Array.isArray(value.reasons) && Array.isArray(value.facts) && typeof value.costUsd === 'number';
+}
+
+/** The server's detail, with the request id and the spend of a failed judge call when it reports them. */
+function failureText(status: number, body: unknown): string {
+  const record = isRecord(body) ? body : {};
+  const detail = formatErrorDetail(record.detail) ??
+    (status >= 500 ? `Server error (HTTP ${status})` : `Request failed (HTTP ${status})`);
+  const requestId = isRecord(record.error) && typeof record.error.requestId === 'string' ? record.error.requestId : null;
+  const cost = typeof record.costUsd === 'number' && record.costUsd > 0 ? `$${record.costUsd.toFixed(4)}` : null;
+  return [detail, requestId && `request ${requestId}`, cost].filter(Boolean).join(' · ');
+}
+
+/** POST the review with the browser's session id. Rejects with the server's failure (a 429
+ *  says when the allowance resets), an unreachable server, or an answer that is not a review. */
+export async function requestReview(request: ReviewRequest, signal?: AbortSignal): Promise<ReviewResult> {
+  const res = await postJson('/api/review/candidates', request, {
+    signal, headers: metaHeaders(),
+    describeError: async (response) => failureText(response.status, await response.json().catch(() => null)),
+  });
+  const body: unknown = await res.json().catch(() => null);
+  if (!isReviewResult(body)) throw new Error('The server sent an invalid review');
+  return body;
+}
+
+const FACT_LABELS: Record<ReviewFactName, string> = {
+  outOfKeyRatio: 'out-of-key',
+  changedSlots: 'changed slots',
+  repetitionVsPrevious: 'repeats previous',
+  r1Roughness: 'roughness',
+};
+
+/** 'lowest' or 'highest' (for slots: 'fewest' or 'most') when the chosen candidate alone holds that extreme. */
+function factRank(result: ReviewResult, name: ReviewFactName): string | null {
+  const rows = result.facts.filter((row) => row[name] !== null);
+  const chosen = rows.find((row) => row.label === result.choice);
+  if (!chosen || rows.length < 2) return null;
+  const value = chosen[name] as number;
+  const others = rows.filter((row) => row !== chosen).map((row) => row[name] as number);
+  if (others.every((other) => value < other)) return name === 'changedSlots' ? 'fewest' : 'lowest';
+  if (others.every((other) => value > other)) return name === 'changedSlots' ? 'most' : 'highest';
+  return null;
+}
+
+/** A reason's fact as the line shows it: 'out-of-key 0' or 'roughness 0.412, lowest'. A confirmed
+ *  fact shows the analyzer's value and its rank among the candidates; any other the judge's value. */
+export function reasonFact(result: ReviewResult, reason: ReviewReason): string {
+  const label = FACT_LABELS[reason.factName] ?? reason.factName;
+  const value = reason.confirmed ? reason.analyzerValue : reason.value;
+  const text = `${label} ${value === null ? '?' : String(Number(value.toFixed(3)))}`;
+  const rank = reason.confirmed ? factRank(result, reason.factName) : null;
+  return rank ? `${text}, ${rank}` : text;
+}
+
+/** How many slots of the chosen candidate the song-form rules write; 0 when none. */
+export function rulesSlotCount(result: ReviewResult): number {
+  return result.facts.find((row) => row.label === result.choice)?.rulesSlots.length ?? 0;
+}
+
+/** Module-level because it is not UI state. */
+let controller: AbortController | null = null;
+
+export const useReviewStore = create<ReviewState>((set, get) => ({
+  loading: false,
+  request: null,
+  result: null,
+  error: null,
+  runId: 0,
+
+  runReview: async () => {
+    const { suggestions, comparison, generateSectionType, loading } = useGenerationStore.getState();
+    if (!comparison || suggestions.length < 2 || suggestions.length > 3 || loading) return;
+    controller?.abort();
+    const current = new AbortController();
+    controller = current;
+    const runId = get().runId + 1;
+    set({ runId, loading: true, request: null, result: null, error: null });
+    try {
+      const request = buildReviewRequest(useSongStore.getState().song, suggestions, comparison, generateSectionType);
+      set({ request });
+      const result = await requestReview(request, current.signal);
+      if (get().runId === runId) set({ result, loading: false });
+    } catch (err) {
+      if (get().runId !== runId || current.signal.aborted) return;
+      set({ error: `Second ear failed: ${err instanceof Error ? err.message : String(err)}`, loading: false });
+    } finally {
+      if (controller === current) controller = null;
+    }
+  },
+
+  clear: () => {
+    controller?.abort();
+    controller = null;
+    set((state) => ({ loading: false, request: null, result: null, error: null, runId: state.runId + 1 }));
+  },
+}));
+
+function dropReview(): void {
+  const { loading, request, result, error, clear } = useReviewStore.getState();
+  if (loading || request || result || error) clear();
+}
+
+// New suggestions (a new run, a failed one, Keep current version) or a replaced
+// song make the review meaningless. Dropped here, not in a component, so it
+// also happens while the Generate panel is not mounted.
+useGenerationStore.subscribe((state, prev) => {
+  if (state.suggestions !== prev.suggestions || state.comparison !== prev.comparison) dropReview();
+});
+useSongStore.subscribe((state, prev) => {
+  if (state.songEpoch !== prev.songEpoch) dropReview();
+});
diff --git a/frontend/src/store/sessionStorage.test.ts b/frontend/src/store/sessionStorage.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a3a23acc9f2afcaec81106ae1aeeced2628649e
--- /dev/null
+++ b/frontend/src/store/sessionStorage.test.ts
@@ -0,0 +1,399 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import type { SavedSession } from '../models/types.ts';
+import { DEFAULT_PLAY_SETTINGS, enginePlayConfig, playSettingsFromSession } from '../engine/playSettings.ts';
+import { saveAll, loadAll, removeSavedSessions } from './sessionStorage.ts';
+import { readScoreImportResponse, createScoreImportDraft, buildImportedSong, buildScoreImportForEditor } from '../engine/scoreImport.ts';
+import { withoutImportedContent } from '../engine/importRetention.ts';
+import { useImportCleanupStore } from './importCleanupStore.ts';
+
+interface StorageMemory { stored: string; writes: number; failWrites: boolean }
+
+function withStoredProjects<T>(sessions: unknown[], run: (memory: StorageMemory) => T): T {
+  const descriptor = Object.getOwnPropertyDescriptor(globalThis, 'localStorage');
+  const memory: StorageMemory = { stored: JSON.stringify({ version: 1, sessions }), writes: 0, failWrites: false };
+  Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: {
+    setItem(_key: string, value: string) {
+      memory.writes++;
+      if (memory.failWrites) throw new Error('quota');
+      memory.stored = value;
+    },
+    getItem() { return memory.stored; },
+  } });
+  try { return run(memory); }
+  finally {
+    if (descriptor) Object.defineProperty(globalThis, 'localStorage', descriptor);
+    else Reflect.deleteProperty(globalThis, 'localStorage');
+  }
+}
+
+function reloadProjects(sessions: unknown[]): SavedSession[] {
+  return withStoredProjects(sessions, () => loadAll());
+}
+
+function roundTripProjects(sessions: SavedSession[]): SavedSession[] {
+  return withStoredProjects([], () => {
+    saveAll(sessions);
+    return loadAll();
+  });
+}
+
+test('invalid saved projects are skipped while valid neighboring projects remain available', () => {
+  const malformed = {
+    id: 'bad', name: 'Bad', createdAt: 0, starred: false,
+    song: {}, generation: { model: 'ft_f1', genre: null },
+  };
+  assert.deepEqual(reloadProjects([malformed, importedProject]), [importedProject]);
+});
+
+test('storage failure is reported to the caller instead of pretending the project was saved', () => {
+  const descriptor = Object.getOwnPropertyDescriptor(globalThis, 'localStorage');
+  Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: { setItem() { throw new Error('quota'); } } });
+  try { assert.throws(() => saveAll([]), /could not save/); }
+  finally {
+    if (descriptor) Object.defineProperty(globalThis, 'localStorage', descriptor);
+    else Reflect.deleteProperty(globalThis, 'localStorage');
+  }
+});
+
+const importedProject: SavedSession = {
+  id: 'imported-project', name: '봄의 변형', createdAt: 0, starred: true,
+  song: {
+    id: 'imported-score', title: '봄의 변형', key: 'C major', genre: 'jazz', bpm: 90, timeSignature: [6, 8], autoTitle: false,
+    measures: [{ id: 'bar-1', index: 0, chords: [
+      { root: 'F', quality: 'maj', bass: 'C', romanNumeral: 'IV', voicing: [48, 53, 57], extensions: [] }, null,
+    ] }],
+    sections: [{ id: 'region-1', type: null, label: 'Repeated region', origin: 'inferred', startMeasure: 0, length: 1 }],
+    importSource: { filename: '', model: 'muse-spark-1.3', requestId: 'sample-request' },
+  },
+  generation: { model: 'ft_f1', genre: 'jazz', ...DEFAULT_PLAY_SETTINGS, bassVolume: 0 },
+  arrangement: { bassPattern: [0, 2], bassInstrument: 'contrabass', beatsPerMeasure: 6 },
+};
+
+test('browser save and reload retain real chords, uncertain sections, source and a muted part', () => {
+  assert.deepEqual(roundTripProjects([importedProject])[0], importedProject);
+});
+
+test('bulk deletion saves once, ignores stale and duplicate selections, and preserves unselected projects', () => {
+  const sessions = [importedProject, { ...structuredClone(importedProject), id: 'second' },
+    { ...structuredClone(importedProject), id: 'third' }];
+  withStoredProjects(sessions, (memory) => {
