+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { PDF_HEIGHT, PDF_WIDTH, pdfMeasureLayout, pdfPageRanges, withoutPdfCreationDate } from './pdfLayout.ts';
+
+test('PDF pagination keeps every bar once and never adds a trailing empty page', () => {
+  assert.deepEqual(pdfPageRanges(28), [{ start: 0, end: 28 }]);
+  assert.deepEqual(pdfPageRanges(29), [{ start: 0, end: 28 }, { start: 28, end: 29 }]);
+  assert.deepEqual(pdfPageRanges(56), [{ start: 0, end: 28 }, { start: 28, end: 56 }]);
+  for (const count of [1, 4, 8, 27, 28, 29, 55, 56, 57, 64, 512]) {
+    const pages = pdfPageRanges(count);
+    const indexes = pages.flatMap(({ start, end }) => Array.from({ length: end - start }, (_, i) => start + i));
+    assert.deepEqual(indexes, Array.from({ length: count }, (_, i) => i));
+    assert.ok(pages.every(({ start, end }) => end > start && end - start <= 28));
+  }
+  assert.throws(() => pdfPageRanges(0));
+  assert.throws(() => pdfPageRanges(513));
+});
+
+test('seven rows fit on A4 with a title area and page footer', () => {
+  for (let i = 0; i < 28; i++) {
+    const layout = pdfMeasureLayout(i);
+    assert.ok(layout.y >= 100);
+    assert.ok(layout.x >= 0 && layout.x + layout.width <= PDF_WIDTH - 10);
+    assert.ok(layout.y + 120 < PDF_HEIGHT - 40);
+  }
+  assert.equal(pdfMeasureLayout(3).y, pdfMeasureLayout(0).y);
+  assert.ok(pdfMeasureLayout(4).y > pdfMeasureLayout(3).y);
+});
+
+test('PDF work timestamp is removed without changing byte offsets or other document bytes', () => {
+  const text = '%PDF\n3 0 obj\n<< /Title (Sketch)\n/CreationDate (D:20000101000000+00\'00\')\n>>\nendobj\nxref';
+  const input = new TextEncoder().encode(text);
+  const output = withoutPdfCreationDate(input.buffer);
+  const decoded = new TextDecoder().decode(output);
+  assert.equal(output.length, input.length);
+  assert.equal(decoded.includes('CreationDate'), false);
+  assert.equal(decoded.includes('20000101'), false);
+  assert.equal(decoded.indexOf('xref'), text.indexOf('xref'));
+  assert.ok(decoded.includes('/Title (Sketch)'));
+  assert.equal(new TextDecoder().decode(input), text);
+});
diff --git a/frontend/src/engine/pdfLayout.ts b/frontend/src/engine/pdfLayout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..432b994d59a4b0ea1da3efd3dc4bd25596151b6a
--- /dev/null
+++ b/frontend/src/engine/pdfLayout.ts
@@ -0,0 +1,41 @@
+import { SCORE_MEASURES_PER_ROW, scoreMeasureLayout } from './scoreLayout.ts';
+
+/** Page canvas size, in the proportions of the 186 × 273 mm image that
+ *  pdf.ts places on each A4 page. */
+export const PDF_WIDTH = 960;
+export const PDF_HEIGHT = 1409;
+const PDF_ROWS_PER_PAGE = 7;
+export const PDF_BARS_PER_PAGE = SCORE_MEASURES_PER_ROW * PDF_ROWS_PER_PAGE;
+/** Room above the first row for the title and the song details. */
+export const PDF_SCORE_TOP = 110;
+
+export function pdfPageRanges(measureCount: number): { start: number; end: number }[] {
+  if (!Number.isInteger(measureCount) || measureCount < 1 || measureCount > 512) {
+    throw new Error('PDF export supports 1–512 bars.');
+  }
+  return Array.from({ length: Math.ceil(measureCount / PDF_BARS_PER_PAGE) }, (_, page) => ({
+    start: page * PDF_BARS_PER_PAGE, end: Math.min(measureCount, (page + 1) * PDF_BARS_PER_PAGE),
+  }));
+}
+
+export function pdfMeasureLayout(indexOnPage: number) {
+  return scoreMeasureLayout(indexOnPage, PDF_WIDTH, { top: PDF_SCORE_TOP });
+}
+
+const CREATION_DATE_PREFIX = Array.from('/CreationDate (', (char) => char.charCodeAt(0));
+const CLOSING_PAREN = 0x29;
+const SPACE = 0x20;
+
+/** Remove jsPDF's automatic work timestamp without moving any PDF xref offsets. */
+export function withoutPdfCreationDate(buffer: ArrayBuffer): Uint8Array<ArrayBuffer> {
+  const bytes = new Uint8Array(buffer.slice(0));
+  for (let start = 0; start <= bytes.length - CREATION_DATE_PREFIX.length; start++) {
+    if (bytes[start] !== CREATION_DATE_PREFIX[0] ||
+        !CREATION_DATE_PREFIX.every((byte, offset) => bytes[start + offset] === byte)) continue;
+    let end = start + CREATION_DATE_PREFIX.length;
+    while (end < bytes.length && bytes[end] !== CLOSING_PAREN) end++;
+    // Blank the whole entry with spaces, so every later byte keeps its offset.
+    if (end < bytes.length) bytes.fill(SPACE, start, end + 1);
+  }
+  return bytes;
+}
diff --git a/frontend/src/engine/planClient.test.ts b/frontend/src/engine/planClient.test.ts
