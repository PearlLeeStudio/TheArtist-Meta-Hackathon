+    def test_fact_rank_is_strict_like_the_editor(self):
+        facts = [{"label": "A", "r1Roughness": 0.4, "outOfKeyRatio": 0.0, "repetitionVsPrevious": None},
+                 {"label": "B", "r1Roughness": 0.5, "outOfKeyRatio": 0.0, "repetitionVsPrevious": None},
