+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import type { Chord, Song } from '../models/types.ts';
+import { transposeSongKey } from './songTranspose.ts';
+import { NOTE_VALUES } from './constants.ts';
+
+const chord = (root: string, quality = 'maj', bass?: string): Chord => ({
+  root, quality, bass, extensions: [], voicing: [], romanNumeral: '',
+});
+function songWith(chords: [Chord | null, Chord | null]): Song {
+  return { id: 'transpose-score', title: 'Scale degrees', key: 'C major', bpm: 80,
+    genre: null, timeSignature: [4, 4], measures: [{ id: 'bar-1', index: 0, chords }] };
+}
+
+test('the Key control still transposes actual pitches while preserving tonic and leading-tone degrees', () => {
+  const original = songWith([chord('C'), chord('B', 'dim')]);
+  const before = structuredClone(original);
+  const moved = transposeSongKey(original, 'D major');
+  assert.deepEqual(moved.measures[0].chords.map((c) => [c?.root, c?.romanNumeral]), [['D', 'I'], ['C#', 'vii°']]);
+  assert.ok(moved.measures[0].chords.every((c) => c!.voicing.length > 0));
+  assert.deepEqual(original, before);
+});
+
+test('sharp and flat keys keep E-sharp and C-flat playable with the right scale degree', () => {
+  const original = songWith([chord('C'), chord('B', 'dim')]);
+  const sharp = transposeSongKey(original, 'F# major');
+  assert.deepEqual(sharp.measures[0].chords.map((c) => [c?.root, c?.romanNumeral]), [['F#', 'I'], ['E#', 'vii°']]);
+  assert.equal(sharp.measures[0].chords[1]?.voicing[0] % 12, 5);
+  const flat = transposeSongKey(songWith([chord('F'), chord('G', '7')]), 'Gb major');
+  assert.deepEqual(flat.measures[0].chords.map((c) => [c?.root, c?.romanNumeral]), [['Cb', 'IV'], ['Db', 'V7']]);
+  assert.equal(flat.measures[0].chords[0]?.voicing[0] % 12, 11);
+});
+
+test('slash bass transposes in tune and rests and song metadata survive', () => {
+  const original = songWith([chord('F', 'maj', 'A'), null]);
+  const moved = transposeSongKey(original, 'D major');
+  const result = moved.measures[0].chords[0]!;
+  assert.equal(result.root, 'G');
+  assert.equal(result.bass, 'B');
+  assert.equal(result.romanNumeral, 'IV');
+  assert.equal(result.voicing[0] % 12, NOTE_VALUES.B);
+  assert.equal(moved.measures[0].chords[1], null);
+  assert.equal(moved.title, original.title);
+  assert.equal(moved.id, original.id);
+});
+
+test('changing major/minor mode at the same root reanalyzes without moving chord pitches', () => {
+  const original = songWith([chord('A', 'min'), chord('G', '7')]);
+  const moved = transposeSongKey(original, 'C minor');
+  assert.deepEqual(moved.measures[0].chords.map((c) => [c?.root, c?.romanNumeral]), [['A', '#vi'], ['G', 'V7']]);
+});
diff --git a/frontend/src/engine/songTranspose.ts b/frontend/src/engine/songTranspose.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1c6194aa0c1281eda2fb37de25ae3da6ba70af9
--- /dev/null
+++ b/frontend/src/engine/songTranspose.ts
@@ -0,0 +1,51 @@
+import type { Chord, Song } from '../models/types.ts';
+import { NOTE_VALUES, VALUE_TO_FLAT_NAME } from './constants.ts';
+import { calculateRomanNumeral } from './romanNumeral.ts';
+import { generatePianoVoicing } from './voicingEngine.ts';
+
+const LETTERS = ['C', 'D', 'E', 'F', 'G', 'A', 'B'];
+
+/** Move `note` up by `semitones` and its letter name up by `letterSteps`, so
+ *  the new spelling keeps the note's scale degree. */
+function transposeNote(note: string, semitones: number, letterSteps: number): string {
+  const pitch = NOTE_VALUES[note];
+  if (pitch === undefined) return note;
+  const nextPitch = (pitch + semitones) % 12;
+  const letter = LETTERS[(LETTERS.indexOf(note[0]) + letterSteps + 7) % 7];
+  const spelled = [letter, `${letter}#`, `${letter}b`].find((name) => NOTE_VALUES[name] === nextPitch);
+  // The editor/export contract supports single accidentals. Retain the
+  // existing enharmonic fallback for a double-accidental spelling.
+  return spelled ?? VALUE_TO_FLAT_NAME[nextPitch];
+}
+
+/** The chord moved into `key`, with its Roman numeral and voicing recomputed. */
+function transposeChord(chord: Chord, semitones: number, letterSteps: number, key: string): Chord {
+  const transposed: Chord = {
+    ...chord,
+    root: transposeNote(chord.root, semitones, letterSteps),
+    ...(chord.bass ? { bass: transposeNote(chord.bass, semitones, letterSteps) } : {}),
+  };
+  return {
+    ...transposed,
+    romanNumeral: calculateRomanNumeral(transposed, key),
+    voicing: generatePianoVoicing(transposed),
+  };
+}
+
+/** The existing Key control transposes the score, retaining note-letter
+ *  relationships as well as pitch, so vii° does not become a flattened I. */
+export function transposeSongKey(song: Song, key: string): Song {
+  const oldRoot = song.key.split(' ')[0];
+  const newRoot = key.split(' ')[0];
+  const semitones = ((NOTE_VALUES[newRoot] ?? 0) - (NOTE_VALUES[oldRoot] ?? 0) + 12) % 12;
+  const letterSteps = (LETTERS.indexOf(newRoot[0]) - LETTERS.indexOf(oldRoot[0]) + 7) % 7;
+  return {
+    ...song,
+    key,
+    measures: song.measures.map((measure) => ({
+      ...measure,
+      chords: measure.chords.map((chord) =>
+        chord ? transposeChord(chord, semitones, letterSteps, key) : null) as [Chord | null, Chord | null],
+    })),
+  };
+}
diff --git a/frontend/src/engine/sseStream.test.ts b/frontend/src/engine/sseStream.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09e16192edcb754e0385e74a7cf0136b0b08bd8a
--- /dev/null
+++ b/frontend/src/engine/sseStream.test.ts
@@ -0,0 +1,91 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readSSEFrames } from './sseStream.ts';
+
+const encode = (value: string) => new TextEncoder().encode(value);
+const frame = 'event: result\ndata: {"label":"후렴 ♭"}\n\n';
+
+test('fragmented UTF-8 frames retain their text and release the reader at EOF', async () => {
+  const response = new Response(new ReadableStream({
+    start(controller) {
+      for (const byte of encode(frame + frame)) controller.enqueue(new Uint8Array([byte]));
+      controller.close();
+    },
+  }));
+  const frames = [];
+  for await (const value of readSSEFrames(response)) frames.push(value);
+  assert.deepEqual(frames, [
+    { event: 'result', data: { label: '후렴 ♭' } },
+    { event: 'result', data: { label: '후렴 ♭' } },
+  ]);
+  assert.equal(response.body?.locked, false);
+});
+
+test('an incomplete frame is not treated as a result', async () => {
+  const response = new Response(frame.slice(0, -1));
+  const frames = [];
+  for await (const value of readSSEFrames(response)) frames.push(value);
+  assert.deepEqual(frames, []);
+  assert.equal(response.body?.locked, false);
+});
+
+test('stopping after a frame cancels the open response and releases its lock', async () => {
+  let cancelled = false;
+  const response = new Response(new ReadableStream({
