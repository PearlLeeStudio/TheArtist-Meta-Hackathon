+"""Second ear: the judge role picks one of the A/B/C candidates of a Generate, on facts code computed.
+
+Code builds a fact table per candidate (chords outside the key, slots changed from the
+original, repetition of the previous section, mean Sethares roughness, the slots the
+song-form rules write). One judge call under a strict schema (enums for the choice and the
+fact names) returns the choice and at most two reasons, each citing one fact of the chosen
+candidate; code checks every cited value against the table and marks the reason confirmed
+or not (a model statement). Any failure is raised as a ReviewFailure with the planner's
+kinds; nothing falls back to the R1 order.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import re
+import time
+from typing import Any
+
+from app.models.review import (
+    FACT_NAMES,
+    MAX_CLAIM_CHARS,
+    MAX_REASONS,
+    CandidateFacts,
+    ReviewReason,
+    ReviewRequest,
+    ReviewResponse,
+)
+from app.services import inference
+from app.services.llm import LLMClient, LLMError, LLMResult, get_client
+from app.services.env_flags import meta_budget_unlimited
+from app.services.planner import DIATONIC_GENRES, _in_key, _key_collection, _kind, _message, _symbol
+from app.services.song_form import rule_slots
+
+log = logging.getLogger(__name__)
+
+REVIEW_LABEL = "review"
+REVIEW_SCHEMA_NAME = "candidate_review"
+REVIEW_EFFORT = "low"
+REVIEW_TIMEOUT_S = 30.0
+REVIEW_MAX_USD = 0.03        # the limiter's worst case, and the cap on the call's reservations
+# Reasoning tokens count toward it. Real low-effort judgments ran out of 1024 and used up to 1656;
+# 4096 would push an open-weight judge's doubled worst case past REVIEW_MAX_USD
+REVIEW_MAX_TOKENS = 2048
+_COUNT_FACTS = frozenset({"changedSlots"})
+# A cited ratio or roughness may be rounded to two decimals; counts must match exactly
+_TOLERANCE = 0.005
+_RELATIVE_TOLERANCE = 0.01
+
+REVIEW_SYSTEM_PROMPT = f"""You are the second ear in a chord editor. The chord model wrote two or three candidates for the
+same bars of a song and the user will pick one. For each candidate an analyzer computed facts over its
+chords as they would land on the score:
+- outOfKeyRatio: share of its chords with a tone outside the song's key (null without chords)
+- changedSlots: chord slots that differ from the original bars
+- repetitionVsPrevious: share of its chords equal to the previous section's chord in the same slot (null
+  without a previous section)
+- r1Roughness: mean Sethares sensory roughness per chord, lower is more consonant (null when not computed)
+- rulesSlots: slots the song-form rules write for the section type (its cadence); they are the rules'
+  choice, not the model's, so never credit a candidate for them
+Pick the candidate that suits the genre, key and section best. Genres that usually stay in key:
+{", ".join(DIATONIC_GENRES)}; jazz, bossa, blues, funk and R&B welcome chromatic chords. A section that
+repeats the previous one adds little contrast unless it is meant to return. Give one or two reasons; each
+cites one fact of the candidate you chose, its factName and its value exactly as the table gives it,
+with a claim of one short sentence (at most {MAX_CLAIM_CHARS} characters). Reply with one JSON object
+{{"choice", "reasons": [{{"factName", "value", "claim"}}]}} and nothing else."""
+
+# The editor's quality aliases (frontend chordParser.ts), so 'C' and 'Cmaj' or 'Am' and 'Amin'
+# are one chord there and here; any other quality text is compared as written
+_QUALITY_ALIASES = {"": "maj", "M": "maj", "major": "maj", "m": "min", "minor": "min", "M7": "maj7",
+                    "min7": "m7", "o7": "dim7", "ø7": "m7b5", "+": "aug", "+7": "aug7", "7#5": "aug7",
+                    "sus": "sus4"}
+_NOTE_NAMES = frozenset("C C# Db D D# Eb E F F# Gb G G# Ab A A# Bb B B# Cb E# Fb".split())
+_EXTENSIONS = re.compile(r"\(([^)]+)\)")
+_ALTERED_TRIAD = re.compile(r"\A([A-G][#b]?)\([^)]*\)")
+
+
+class ReviewFailure(Exception):
+    """A review that ended without a choice: kind and message become the response's error."""
+
+    def __init__(self, kind: str, message: str, request_id: str | None = None, *, provider: str | None = None,
+                 model: str | None = None, cost_usd: float = 0.0, latency_ms: int = 0) -> None:
+        super().__init__(message)
+        self.kind = kind
+        self.message = message
+        self.request_id = request_id
+        self.provider = provider
+        self.model = model
+        self.cost_usd = cost_usd
+        self.latency_ms = latency_ms
+
+
+# --- Facts ---
+
+
+def _slot(symbol: str | None) -> str | None:
+    return (symbol or "").strip() or None
+
+
+def _flat(bars: list[list[str | None]]) -> list[str | None]:
+    return [_slot(symbol) for measure in bars for symbol in measure]
+
+
+def _chord_key(symbol: str | None, with_bass: bool = True) -> tuple | str | None:
+    """A chord as the editor compares two chords (generationComparison.ts): root and slash bass as
+    spelled, the quality under the editor's aliases, the extensions in parentheses; text it cannot
+    read stays text."""
+    text = _slot(symbol)
+    if text is None:
+        return None
+    head, bass = text, ""
+    cut = text.rfind("/")
+    if cut > 0 and text[cut + 1:] in _NOTE_NAMES:
+        head, bass = text[:cut], text[cut + 1:]
+    root_len = 2 if len(head) >= 2 and head[1] in "#b" else 1
+    root, rest = head[:root_len], head[root_len:]
+    if root not in _NOTE_NAMES:
+        return text
+    extensions: tuple[str, ...] = ()
+    if match := _EXTENSIONS.search(rest):
+        extensions = tuple(sorted(part.strip() for part in match[1].split(",")))
+        rest = rest.replace(match[0], "", 1)
+    return root, _QUALITY_ALIASES.get(rest, rest or "maj"), extensions, bass if with_bass else ""
+
+
+def _music21_symbol(symbol: str) -> str:
+    """The editor's symbol as the physics code reads it: extensions without parentheses (C7(b9) -> C7b9),
+    which music21 does not voice; ai/physics respells flats itself."""
+    # An alteration right after a bare root ('C(b9)') would otherwise read as a flat root ('Cb9'): drop it
+    bare = _ALTERED_TRIAD.sub(r"\1", symbol)
+    return bare.replace("(", "").replace(")", "").replace(",", "")
+
+
+def _outside_key(chord: str, collection: frozenset[int]) -> bool:
+    """A chord with a tone outside the key, without its slash bass as the planner reads it; a
+    symbol the parser cannot read counts as outside."""
+    core = _symbol(chord)
+    return core is None or not _in_key(core, collection)
+
+
+def _mean_roughness(chords: list[str]) -> float | None:
+    """R1 as inference's rerank computes it (ai/physics), over every chord music21 can voice."""
+    if not inference.PHYSICS_AVAILABLE or not chords:
+        return None
+    total, scored = inference.sequence_roughness([_music21_symbol(chord) for chord in chords])
+    return round(total / scored, 3) if scored else None
+
+
+def candidate_facts(request: ReviewRequest) -> list[CandidateFacts]:
+    """One row per candidate, in request order. Every ratio counts the candidate's filled slots."""
+    original = _flat(request.original)
+    previous = _flat(request.previousSection) if request.previousSection is not None else None
+    collection = _key_collection(request.key)
+    rules = rule_slots(request.sectionType, len(original)) if request.sectionType else []
+    rows = []
+    for candidate in request.candidates:
+        chords = _flat(candidate.chords)
+        filled = [chord for chord in chords if chord]
+        outside = sum(1 for chord in filled if _outside_key(chord, collection))
+        changed = sum(1 for mine, theirs in zip(chords, original) if _chord_key(mine) != _chord_key(theirs))
+        repetition = None
+        if previous is not None:
+            placed = [i for i, chord in enumerate(chords[:len(previous)]) if chord]
+            same = sum(1 for i in placed if _chord_key(chords[i], False) == _chord_key(previous[i], False))
+            repetition = round(same / len(placed), 3) if placed else None
+        rows.append(CandidateFacts(
+            label=candidate.label,
+            outOfKeyRatio=round(outside / len(filled), 3) if filled else None,
+            changedSlots=changed, repetitionVsPrevious=repetition, r1Roughness=_mean_roughness(filled),
+            rulesSlots=list(rules),
+        ))
+    return rows
+
+
+# --- The judge call ---
+
+
+def review_schema(labels: list[str], fact_names: list[str]) -> dict[str, Any]:
+    """The strict reply schema: the choice among `labels`, one or two reasons citing `fact_names`."""
+    return {
+        "type": "object",
+        "properties": {
+            "choice": {"type": "string", "enum": list(labels)},
+            "reasons": {
+                "type": "array", "minItems": 1, "maxItems": MAX_REASONS,
+                "items": {"type": "object", "properties": {
+                    "factName": {"type": "string", "enum": list(fact_names)},
+                    "value": {"type": "number"},
+                    "claim": {"type": "string", "maxLength": MAX_CLAIM_CHARS},
+                }},
+            },
+        },
+    }
+
+
+def _messages(request: ReviewRequest, facts: list[CandidateFacts]) -> list[dict[str, str]]:
+    payload = {
+        "key": request.key, "genre": request.genre, "sectionType": request.sectionType,
+        "original": request.original, "previousSection": request.previousSection,
+        "candidates": [{"label": candidate.label, "chords": candidate.chords,
+                        "facts": row.model_dump(exclude={"label"})}
+                       for candidate, row in zip(request.candidates, facts)],
+    }
+    return [{"role": "system", "content": REVIEW_SYSTEM_PROMPT},
+            {"role": "user", "content": json.dumps(payload, ensure_ascii=False, separators=(",", ":"))}]
+
+
+def _client() -> LLMClient:
+    """The judge role's shared client, or the failure that stands for its missing configuration."""
+    try:
+        client = get_client("judge")
+    except LLMError as exc:
+        raise ReviewFailure(_kind(exc), _message(exc)) from None
+    if not client.config.api_key:
+        raise ReviewFailure("config", f"{client.config.key_source} is not set, so provider "
+                                      f"{client.config.provider} cannot be called")
+    return client
+
+
+def _call(client: LLMClient, messages: list[dict[str, str]], schema: dict[str, Any]) -> tuple[LLMResult, float, int]:
+    """One ledgered judge call: (result, settled cost of every attempt, wall-clock ms), or a ReviewFailure."""
+    cfg = client.config
+    # A provider configured without a reasoning mode (ollama, custom) gets no effort field
+    effort = REVIEW_EFFORT if cfg.reasoning_effort is not None else None
+    options = dict(name=REVIEW_SCHEMA_NAME, max_completion_tokens=REVIEW_MAX_TOKENS, timeout_s=REVIEW_TIMEOUT_S,
+                   max_request_usd=REVIEW_MAX_USD, reasoning_effort=effort)
+    try:
+        prepared = client.prepare(messages, schema, **options)
+    except LLMError as exc:
+        raise ReviewFailure(_kind(exc), _message(exc), exc.request_id, provider=cfg.provider,
+                            model=cfg.model) from None
+    # The limiter admitted REVIEW_MAX_USD; an open-weight provider may reserve twice (its one JSON-guard retry)
+    worst_case = prepared.reserve_usd * (1 if cfg.provider == "meta" else 2)
+    if not meta_budget_unlimited() and worst_case > REVIEW_MAX_USD + 1e-9:
+        # The editor shows this text, so the figures go to the server log only
+        log.info("review cap: worst case $%.4f would pass $%.2f", worst_case, REVIEW_MAX_USD)
+        raise ReviewFailure("budget", "this review would pass its Meta cost limit; it was not sent to Meta",
+                            provider=cfg.provider, model=cfg.model)
+    started = time.perf_counter()
+    try:
+        result = client.chat_json(messages, schema, label=REVIEW_LABEL, **options)
+    except LLMError as exc:
+        raise ReviewFailure(_kind(exc), _message(exc), exc.request_id, provider=cfg.provider, model=cfg.model,
+                            cost_usd=round(exc.cost_usd, 8), latency_ms=_elapsed_ms(started)) from None
+    latency = _elapsed_ms(started)
+    cost = result.cost_usd
+    return result, round(cost, 8), latency
+
+
+def _elapsed_ms(started: float) -> int:
+    return round((time.perf_counter() - started) * 1000)
+
+
+def _matches(name: str, value: float, actual: float) -> bool:
+    if name in _COUNT_FACTS:
+        return value == actual
+    return abs(value - actual) <= max(_TOLERANCE, _RELATIVE_TOLERANCE * abs(actual))
+
+
+def verify_reason(reason: dict[str, Any], row: CandidateFacts) -> ReviewReason:
+    """A judge reason checked against the chosen candidate's row: confirmed when its fact has that
+    value there (within the tolerance), else it stays the model's statement."""
+    name, raw = reason["factName"], reason["value"]
+    value = float(raw) if isinstance(raw, (int, float)) and math.isfinite(raw) else None
+    actual = getattr(row, name)
+    confirmed = value is not None and actual is not None and _matches(name, value, actual)
+    return ReviewReason(fact=f"{name}={raw:g}" if value is not None else f"{name}={raw}", factName=name, value=value,
+                        claim=str(reason["claim"]).strip()[:MAX_CLAIM_CHARS], confirmed=confirmed,
+                        analyzerValue=actual)
+
+
+def review_candidates(request: ReviewRequest, client: LLMClient | None = None) -> ReviewResponse:
+    """The facts, one judge call and the verified reasons; raises ReviewFailure on any LLM failure.
+    An explicit client (evaluation scripts) is used as given instead of the judge role's shared one."""
+    client = client if client is not None else _client()
+    facts = candidate_facts(request)
+    citable = [name for name in FACT_NAMES if any(getattr(row, name) is not None for row in facts)]
+    schema = review_schema([row.label for row in facts], citable)
+    result, cost, latency = _call(client, _messages(request, facts), schema)
+    choice = result.data["choice"]
+    row = next(row for row in facts if row.label == choice)
+    return ReviewResponse(
+        choice=choice, reasons=[verify_reason(reason, row) for reason in result.data["reasons"]], facts=facts,
+        provider=result.provider, model=result.model, requestId=result.request_id, costUsd=cost, latencyMs=latency,
+    )
diff --git a/backend/app/services/score_analysis.py b/backend/app/services/score_analysis.py
new file mode 100644
index 0000000000000000000000000000000000000000..b52663bfbb9358f96f06b5b3e29d32d3a41044d0
--- /dev/null
+++ b/backend/app/services/score_analysis.py
@@ -0,0 +1,248 @@
+"""Local vector-score reading and deterministic harmonic analysis.
+
+No API client, key or network is used here. PDF reading and harmonic inference
+are separate boundaries, so unread notation never turns into invented notes.
+"""
+
+from __future__ import annotations
+
+import base64
+import re
+from typing import TYPE_CHECKING
+
+from app.models.score_import import (
+    MAX_CHORDS_PER_MEASURE, MAX_NOTE_CHARS, MAX_PITCH_NAMES, MAX_SCORE_WARNINGS, MAX_TITLE_CHARS,
+    ImportedMeasure, ScoreImportRequest, ScoreImportResponse,
+)
+
+if TYPE_CHECKING:
+    from app.services.harmony_analysis import NoteEvent
+    from app.services.score_pdf import NoteEvent as ReadNote, ParsedScore, ScoreMeasure
+
+_OCTAVE_SUFFIX = re.compile(r"-?\d+$")
+
+
+class LocalScoreUnsupported(ValueError):
+    """The local reader cannot establish the requested score evidence."""
+
+
+def _without_octave(spelling: str) -> str:
+    return _OCTAVE_SUFFIX.sub("", spelling)
+
+
+def _note_name(midi: int, spelling: str) -> str:
+    """The spelling's letter and accidentals with the octave of the MIDI pitch, e.g. B#3 for MIDI 60."""
+    root = _without_octave(spelling)
+    natural = {"C": 0, "D": 2, "E": 4, "F": 5, "G": 7, "A": 9, "B": 11}[root[0]]
+    alteration = root.count("#") - root.count("b") + 2 * root.count("x")
+    octave = (midi - natural - alteration) // 12 - 1
+    return f"{root}{octave}"
+
+
+def _written_name(note: ReadNote) -> str:
+    """The pitch as written before an octave-span shift; an unshifted note is written as it sounds."""
+    written_midi = getattr(note, "written_midi", None)
+    return _note_name(written_midi if written_midi is not None else note.midi,
+                      getattr(note, "written_spelling", None) or note.spelling)
+
+
+def _harmonic_spelling(spelling: str) -> str | None:
+    root = _without_octave(spelling)
+    # The evidence retains double accidentals. Candidate naming uses an
+    # enharmonic name when the harmonic engine's single-accidental vocabulary
+    # cannot preserve that spelling; MIDI pitch is never changed.
+    return root if re.fullmatch(r"[A-G][#b]?", root) else None
+
+
+def _beats(time_signature: tuple[int, int]) -> float:
+    """Quarter-note beats in one measure."""
+    return time_signature[0] * 4 / time_signature[1]
+
+
+def _bass_evidence(notes: list[ReadNote]) -> list[str]:
+    """Lowest read active pitches, independent of staff order or crossed voices."""
+    result: list[str] = []
+    boundaries = {note.onset for note in notes}
+    boundaries.update(note.onset + note.duration for note in notes if note.duration is not None)
+    for onset in sorted(boundaries):
+        active = [note for note in notes if note.onset <= onset and
+                  ((note.duration is not None and note.onset + note.duration > onset) or note.onset == onset)]
+        if active:
+            note = min(active, key=lambda item: item.midi)
+            name = _note_name(note.midi, note.spelling)
+            if name not in result:
+                result.append(name)
+    return result[:MAX_PITCH_NAMES]
+
+
+def _bounded_warnings(messages: list[str]) -> list[str]:
+    """Unique, nonempty warnings cut to the note length; past the response bound, a count replaces the rest."""
+    unique = list(dict.fromkeys(message[:MAX_NOTE_CHARS] for message in messages if message))
+    if len(unique) <= MAX_SCORE_WARNINGS:
+        return unique
+    kept = MAX_SCORE_WARNINGS - 1
+    return [*unique[:kept], f"Additional reading issues: {len(unique) - kept}. Check the source measure evidence before importing."]
+
+
+def _score_events(score: ParsedScore) -> list[NoteEvent]:
+    """Every read note on one continuous beat clock, for the whole-score key estimate.
+
+    Raises LocalScoreUnsupported past harmony_analysis.MAX_NOTE_EVENTS note events.
+    """
+    from app.services.harmony_analysis import MAX_NOTE_EVENTS, NoteEvent
+
+    events: list[NoteEvent] = []
+    cursor = 0.0
+    for bar in score.measures:
+        beats = _beats(bar.time_signature)
+        for note in bar.notes:
+            duration = note.duration if note.duration is not None and note.duration > 0 else min(1.0, beats)
+            spelling = _harmonic_spelling(note.spelling)
+            events.append(NoteEvent(note.midi, cursor + max(0.0, note.onset), duration,
+                                    bar.index, staff=str(note.staff), spelling=spelling))
+            if len(events) > MAX_NOTE_EVENTS:
+                raise LocalScoreUnsupported("The score exceeds the local note-event limit; split it into shorter parts.")
+        cursor += beats
+    return events
+
+
+def _inferred_harmony(bar: ScoreMeasure, key: str | None, notes: list[str], evidence: str, label: str,
+                      warnings: list[str]) -> tuple[list[str], str, str, str]:
+    """Chords proposed from one bar's read notes, as (chords, basis, confidence, evidence).
+
+    A bar with more than MAX_CHORDS_PER_MEASURE changes is reported in warnings and left unresolved.
+    """
+    from app.services.harmony_analysis import NoteEvent, analyze_harmony
+
+    beats = _beats(bar.time_signature)
+    events: list[NoteEvent] = []
+    for note in bar.notes:
+        onset = min(max(0.0, note.onset), max(0.0, beats - 0.01))
+        duration = note.duration if note.duration is not None and note.duration > 0 else min(1.0, beats - onset)
+        duration = min(duration, beats - onset)
+        if duration <= 0:
+            continue
+        events.append(NoteEvent(note.midi, onset, duration, bar.index,
+                                staff=str(note.staff), spelling=_harmonic_spelling(note.spelling)))
+    analysis = analyze_harmony(events, key=key, time_signature=bar.time_signature,
+                               total_duration=beats, timing_is_estimated=not bar.rhythm_exact)
+    chords: list[str] = []
+    reasons: list[str] = []
+    scores: list[float] = []
+    unresolved_segments = 0
+    for segment in analysis.segments:
+        if segment.candidates:
+            candidate = segment.candidates[0]
+            if not chords or candidate.symbol != chords[-1]:
+                chords.append(candidate.symbol)
+            alternatives = " / ".join(option.symbol for option in segment.candidates[:3])
+            reasons.append(f"Candidates {alternatives}: {candidate.evidence}")
+            scores.append(candidate.confidence)
+        elif segment.kind == "insufficient":
+            unresolved_segments += 1
+    if len(chords) > MAX_CHORDS_PER_MEASURE:
+        warnings.append(f"{label} has more than {MAX_CHORDS_PER_MEASURE} harmonic changes; review a shorter passage.")
+        chords = []
+    basis = "inferred" if chords else "unreadable"
+    confidence = "medium" if scores and min(scores) >= .65 and bar.rhythm_exact else "low"
+    evidence = (("Reading limits: " + evidence + " " if evidence else "") +
+                "Read notes: " + ", ".join(notes[:16]) + ". " + " ".join(reasons[:3])).strip()
+    if not chords:
+        evidence = (evidence + " Insufficient simultaneous note evidence for a chord; no harmony was invented.").strip()
+    elif unresolved_segments:
+        evidence = (f"{unresolved_segments} time slices have insufficient harmony evidence. " + evidence).strip()
+        confidence = "low"
+    if not bar.rhythm_exact:
+        evidence = ("Timing is approximate; check notation and chord changes. " + evidence).strip()
+    return chords, basis, confidence, evidence
+
+
+def _import_measure(mode: str, bar: ScoreMeasure, key: str | None, previous: ImportedMeasure | None,
+                    warnings: list[str]) -> ImportedMeasure:
+    """One source bar for review: its printed chords, a written repeat of the previous bar, or analyzed notes."""
+    notes = list(dict.fromkeys(_note_name(note.midi, note.spelling) for note in bar.notes))[:MAX_PITCH_NAMES]
+    written = list(dict.fromkeys(_written_name(note) for note in bar.notes))[:MAX_PITCH_NAMES]
+    bass = _bass_evidence(bar.notes)
+    label = f"Page {bar.page}, system {bar.system}, bar {bar.number}"
+    chords = [chord.symbol for chord in bar.chords]
+    no_chord = bool(bar.no_chord)
+    evidence = " ".join(bar.warnings)
+    basis = "printed"
+    confidence = "high"
+    needs_review = bool(bar.warnings)
+
+    # A written repeat-measure sign reuses the previous written measure;
+    # D.C./D.S./ending jumps never expand the score's written order.
+    if not chords and not no_chord and any(marker in ("%", "repeat_measure") for marker in bar.repeat_markers):
+        if previous is not None and (previous.chords or previous.noChord):
+            chords = list(previous.chords)
+            no_chord = previous.noChord
+            basis = previous.chordBasis
+            confidence = previous.confidence
+            needs_review = needs_review or previous.needsReview
+            evidence += " Written repeat-measure sign reuses the preceding measure's chord symbols."
+        else:
+            evidence += " Repeat-measure sign has no preceding readable harmony."
+
+    if mode == "infer_harmony" and not chords and not no_chord:
+        chords, basis, confidence, evidence = _inferred_harmony(bar, key, notes, evidence, label, warnings)
+        needs_review = True
+
+    if not chords and not no_chord:
+        basis, confidence, needs_review = "unreadable", "low", True
+    if len(chords) > 2:
+        needs_review = True
+    return ImportedMeasure(chords=chords, sourceLabel=label, needsReview=needs_review,
+                           note=evidence[:MAX_NOTE_CHARS], chordBasis=basis, confidence=confidence,
+                           notes=notes, writtenNotes=written, bassNotes=bass, noChord=no_chord,
+                           timeSignature=list(bar.time_signature), analysisSource="local")
+
+
+def analyze_local_score(req: ScoreImportRequest) -> ScoreImportResponse:
+    if req.mimeType != "application/pdf":
+        raise LocalScoreUnsupported("Local reading currently requires a vector PDF with extractable music symbols; raster images need an optical reader.")
+    # Imported per call: tests substitute the parser module and patch the engine's functions.
+    from app.services.score_pdf import ScorePDFError, parse_vector_score
+    from app.services.harmony_analysis import estimate_key
+
+    try:
+        score = parse_vector_score(base64.b64decode(req.dataBase64, validate=True))
+    except ScorePDFError as exc:
+        raise LocalScoreUnsupported(str(exc)) from None
+    if not score.supported or not score.measures:
+        raise LocalScoreUnsupported("No supported vector music notation or printed chord measures were found in this PDF.")
+    if not score.complete:
+        raise LocalScoreUnsupported("The complete written measure order could not be established. Split the PDF into shorter parts or use the API reader.")
+
+    key_events = _score_events(score)
+    estimated_timing = any(not bar.rhythm_exact for bar in score.measures)
+    key_estimate = estimate_key(key_events, key=score.key, key_signature=score.key_signature,
+                                time_signature=score.time_signature or (4, 4),
+                                timing_is_estimated=estimated_timing)
+    key = key_estimate.key
+    warnings = list(score.warnings)
+    if estimated_timing:
+        warnings.append("Some rhythmic durations could not be decoded exactly. Duration weights and harmonic timing are approximate, and confidence is limited.")
+    if key_estimate.source == "inferred":
+        alternatives = ", ".join(candidate.key for candidate in key_estimate.alternatives[:3])
+        warnings.append(f"The tonal key is inferred from note durations and key signature. Confirm {key or 'the key'}; alternatives: {alternatives}.")
+
+    measures: list[ImportedMeasure] = []
+    for bar in score.measures:
+        previous = measures[-1] if measures else None
+        measures.append(_import_measure(req.mode, bar, key, previous, warnings))
+
+    if not any(measure.chords or measure.noChord for measure in measures):
+        if req.mode == "infer_harmony" and key_events:
+            warnings.insert(0, "Notes were read, but no sufficiently supported harmony was established. The passages remain unresolved; explicit Meta assistance can propose interpretations from these read notes.")
+        else:
+            message = "No printed chords were found. Choose Analyze notes (no chords) to analyze the read notes." if req.mode == "chord_symbols" else "No supported note or harmony evidence could be read from this score."
+            raise LocalScoreUnsupported(message)
+    meters = {tuple(measure.timeSignature) for measure in measures if measure.timeSignature}
+    if len(meters) > 1:
+        warnings.append("The source changes meter between measures. The chord editor uses one global meter; source meters are retained for review and its playback is a harmonic sketch.")
+    warnings.extend(score.unresolved)
+    return ScoreImportResponse(title=score.title[:MAX_TITLE_CHARS], key=key,
+                               timeSignature=list(score.time_signature) if score.time_signature else None,
+                               measures=measures, sections=[], warnings=_bounded_warnings(warnings),
+                               mode=req.mode, model=None, requestId=None, analysisSource="local")
