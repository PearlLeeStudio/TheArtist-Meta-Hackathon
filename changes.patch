@@ -0,0 +1,14 @@
+import { Stave } from 'vexflow/bravura';
+import { scoreMeasureLayout } from './scoreLayout.ts';
+import type { ScoreMeasureLayout } from './scoreLayout.ts';
+
+export interface ScoreStaveLayout extends ScoreMeasureLayout {
+  midLineY: number;
+}
+
+/** VexFlow's line geometry is available before drawing, without an animation frame. */
+export function scoreStaveLayout(index: number, width: number): ScoreStaveLayout {
+  const layout = scoreMeasureLayout(index, width);
+  const stave = new Stave(layout.x, layout.y, layout.width);
+  return { ...layout, midLineY: stave.getYForLine(2) };
+}
diff --git a/frontend/src/engine/songForm.test.ts b/frontend/src/engine/songForm.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f62c3c74a06cb0dab781065ee48f7283b85304cb
--- /dev/null
+++ b/frontend/src/engine/songForm.test.ts
@@ -0,0 +1,254 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync, readFileSync } from 'node:fs';
+import type { Measure, Song, SongSection } from '../models/types.ts';
+import {
+  SECTION_INFO,
+  SECTION_TYPES,
+  MAX_SECTION_BARS,
+  autoTitle,
+  barsForChords,
+  barCountSummary,
+  checkBarCount,
+  checkSectionRanges,
+  defaultSectionBars,
+  sectionAt,
+  sectionContaining,
+  sectionPlacement,
+  sectionTitle,
+  sectionDisplayLabel,
+  sectionsInGroup,
+  withAutoTitle,
+  withSongFormDefaults,
+} from './songForm.ts';
+
+function measures(count: number, withChords: number[] = []): Measure[] {
+  return Array.from({ length: count }, (_, i) => ({
+    id: `m${i}`,
+    index: i,
+    chords: withChords.includes(i)
+      ? [{ root: 'C', quality: 'maj7', romanNumeral: '', voicing: [], extensions: [] }, null]
+      : [null, null],
+  }));
+}
+
+function song(overrides: Partial<Song> = {}): Song {
+  return {
+    id: 'song',
+    title: 'Untitled',
+    bpm: 80,
+    key: 'C major',
+    genre: null,
+    timeSignature: [4, 4],
+    measures: measures(4),
+    sections: [],
+    autoTitle: true,
+    ...overrides,
+  };
+}
+
+function section(type: SongSection['type'], startMeasure: number, length: number): SongSection {
+  return { id: `${type}-${startMeasure}`, type, startMeasure, length };
+}
+
+test('imported uncertain sections retain their label and uncertainty after loading', () => {
+  const region: SongSection = { id: 'region', type: null, label: 'Repeated region', origin: 'inferred', startMeasure: 0, length: 4 };
+  const loaded = withSongFormDefaults(song({ sections: [region], title: 'Imported', autoTitle: false }));
+  assert.deepEqual(loaded.sections, [region]);
+  assert.equal(sectionDisplayLabel(region), 'Repeated region');
+  assert.equal(sectionContaining(loaded, [0, 3])?.type, null);
+  assert.equal(loaded.title, 'Imported');
+});
+
+test('editing section boundaries rejects overlaps, fractions and out-of-score ranges', () => {
+  assert.equal(checkSectionRanges([section('verse', 0, 2), section('chorus', 2, 2)], 4), null);
+  assert.match(checkSectionRanges([section('verse', 0, 3), section('chorus', 2, 2)], 4)!, /overlap/);
+  assert.match(checkSectionRanges([section('verse', 2, 3)], 4)!, /last bar/);
+  assert.match(checkSectionRanges([section('verse', 0.5, 2)], 4)!, /valid/);
+  assert.match(checkSectionRanges([section('verse', 0, 0)], 4)!, /valid/);
+});
+
+test('vocabulary: 17 ids in three groups', () => {
+  assert.equal(SECTION_TYPES.length, 17);
+  assert.deepEqual(sectionsInGroup('common'), ['intro', 'verse', 'pre_chorus', 'chorus', 'post_chorus', 'bridge', 'outro']);
+  assert.deepEqual(sectionsInGroup('instrumental'), ['interlude', 'solo', 'breakdown', 'drop', 'vamp', 'turnaround', 'tag']);
+  assert.deepEqual(sectionsInGroup('jazz'), ['head', 'a_section', 'b_section']);
+  assert.equal(MAX_SECTION_BARS, 64);
+});
+
+test('vocabulary matches backend/app/models/sections.py', (t) => {
+  const pyPath = new URL('../../../backend/app/models/sections.py', import.meta.url);
+  if (!existsSync(pyPath)) {
+    t.skip('backend checkout not present');
+    return;
+  }
+  const source = readFileSync(pyPath, 'utf8');
+  const entries = [...source.matchAll(/^\s*"(\w+)": \("([^"]+)", "(\w+)", (\d+)\),$/gm)];
+  const backend = Object.fromEntries(
+    entries.map(([, id, label, group, chords]) => [id, { label, group, defaultChords: Number(chords) }]),
+  );
+  assert.deepEqual(backend, SECTION_INFO);
+  assert.deepEqual(entries.map(([, id]) => id), SECTION_TYPES);
+});
+
+test('barsForChords: two chords per bar, rounded up', () => {
+  assert.equal(barsForChords(16), 8);
+  assert.equal(barsForChords(15), 8);
+  assert.equal(barsForChords(2), 1);
+  assert.equal(barsForChords(128), 64);
+});
+
+test('sectionTitle: em dash with spaces, singular bar', () => {
+  assert.equal(sectionTitle('chorus', 8), 'Chorus — 8 bars');
+  assert.equal(sectionTitle('pre_chorus', 4), 'Pre-Chorus — 4 bars');
+  assert.equal(sectionTitle('vamp', 1), 'Vamp — 1 bar');
+});
+
+test('autoTitle: none, one, several, and truncation after six labels', () => {
+  assert.equal(autoTitle([]), 'Untitled');
+  assert.equal(autoTitle([section('chorus', 0, 8)]), 'Chorus — 8 bars');
+  assert.equal(
+    autoTitle([section('intro', 0, 4), section('verse', 4, 8), section('chorus', 12, 8)]),
+    'Intro–Verse–Chorus',
+  );
+  // Labels follow song order, not insertion order.
+  assert.equal(autoTitle([section('chorus', 8, 8), section('verse', 0, 8)]), 'Verse–Chorus');
+  const seven = ['intro', 'verse', 'pre_chorus', 'chorus', 'verse', 'chorus', 'outro'] as const;
+  const sections = seven.map((type, i) => section(type, i * 8, 8));
+  assert.equal(autoTitle(sections), 'Intro–Verse–Pre-Chorus–Chorus–Verse–Chorus…');
+  assert.equal(autoTitle(sections.slice(0, 6)), 'Intro–Verse–Pre-Chorus–Chorus–Verse–Chorus');
+});
+
+test('withAutoTitle only rewrites automatic titles', () => {
+  const sections = [section('bridge', 0, 8)];
+  assert.equal(withAutoTitle(song({ sections, autoTitle: true })).title, 'Bridge — 8 bars');
+  assert.equal(withAutoTitle(song({ sections, title: 'Mine', autoTitle: false })).title, 'Mine');
+});
+
+test('sectionPlacement: empty 4-bar song starts at 0 and grows as needed', () => {
+  assert.deepEqual(sectionPlacement(song(), 8), { startMeasure: 0, measuresToAdd: 4 });
+  assert.deepEqual(sectionPlacement(song(), 4), { startMeasure: 0, measuresToAdd: 0 });
+  assert.deepEqual(sectionPlacement(song(), 2), { startMeasure: 0, measuresToAdd: 0 });
+});
+
+test('sectionPlacement: starts after the last measure with a chord', () => {
+  const s = song({ measures: measures(4, [0, 1]) });
+  assert.deepEqual(sectionPlacement(s, 2), { startMeasure: 2, measuresToAdd: 0 });
+  assert.deepEqual(sectionPlacement(s, 4), { startMeasure: 2, measuresToAdd: 2 });
+  // A gap before the last chord is not reused.
+  assert.deepEqual(sectionPlacement(song({ measures: measures(4, [2]) }), 1), { startMeasure: 3, measuresToAdd: 0 });
+});
+
+test('sectionPlacement: an existing section counts as used even without chords', () => {
+  const s = song({ measures: measures(8), sections: [section('verse', 0, 8)] });
+  assert.deepEqual(sectionPlacement(s, 8), { startMeasure: 8, measuresToAdd: 8 });
+  const withChordsAfter = song({ measures: measures(12, [9]), sections: [section('verse', 0, 8)] });
+  assert.deepEqual(sectionPlacement(withChordsAfter, 4), { startMeasure: 10, measuresToAdd: 2 });
+});
+
+test('sectionAt and sectionContaining', () => {
+  const s = song({ measures: measures(16), sections: [section('intro', 0, 4), section('chorus', 4, 8)] });
+  assert.equal(sectionAt(s, 0)?.type, 'intro');
+  assert.equal(sectionAt(s, 3)?.type, 'intro');
+  assert.equal(sectionAt(s, 4)?.type, 'chorus');
+  assert.equal(sectionAt(s, 11)?.type, 'chorus');
+  assert.equal(sectionAt(s, 12), null);
+  assert.equal(sectionAt(song({ sections: undefined }), 0), null);
+  assert.equal(sectionContaining(s, [5, 6, 7])?.type, 'chorus');
+  assert.equal(sectionContaining(s, [3, 4]), null);
+  assert.equal(sectionContaining(s, [10, 12]), null);
+  assert.equal(sectionContaining(s, []), null);
+});
+
+test('withSongFormDefaults: old songs load with no sections and a derived autoTitle', () => {
+  const legacy = (title: string) => {
+    const s = song({ title });
+    delete s.sections;
+    delete s.autoTitle;
+    return withSongFormDefaults(s);
+  };
+  assert.deepEqual(legacy('Untitled').sections, []);
+  assert.equal(legacy('Untitled').autoTitle, true);
+  assert.equal(legacy('').autoTitle, true);
+  assert.equal(legacy('Blue Bossa').autoTitle, false);
+  // Stored values win; malformed sections are dropped.
+  assert.equal(withSongFormDefaults(song({ title: 'Untitled', autoTitle: false })).autoTitle, false);
+  const bad = [section('verse', 0, 8), { id: 'x', type: 'nope', startMeasure: 0, length: 4 }] as SongSection[];
+  assert.deepEqual(withSongFormDefaults(song({ sections: bad })).sections, [section('verse', 0, 8)]);
+});
+
+test('withSongFormDefaults: a section still pending when saved goes, with the measures added for it', () => {
+  const pendingSection = (
+    type: SongSection['type'], startMeasure: number, length: number, addedMeasures: number,
+  ): SongSection => ({ ...section(type, startMeasure, length), pending: { addedMeasures } });
+
+  // The empty 4-bar song right after New from Song Form placed an 8-bar
+  // Verse (4 measures appended), autosaved before the chords came back.
+  const onEmpty = withSongFormDefaults(song({
+    title: 'Verse — 8 bars',
+    measures: measures(8),
+    sections: [pendingSection('verse', 0, 8, 4)],
+  }));
+  assert.deepEqual(onEmpty.sections, []);
+  assert.equal(onEmpty.measures.length, 4);
+  assert.equal(onEmpty.title, 'Untitled');
+
+  // A kept section stays, and the automatic title stops naming the pending one.
+  const intro = section('intro', 0, 4);
+  const afterIntro = withSongFormDefaults(song({
+    title: 'Intro–Chorus',
+    measures: measures(12, [0, 1, 2, 3]),
+    sections: [intro, pendingSection('chorus', 4, 8, 8)],
+  }));
+  assert.deepEqual(afterIntro.sections, [intro]);
+  assert.equal(afterIntro.measures.length, 4);
+  assert.equal(afterIntro.title, 'Intro — 4 bars');
+
+  // Placed over blank measures the song already had: those stay.
+  const intoBlank = withSongFormDefaults(song({
+    title: 'Verse — 4 bars',
+    measures: measures(8, [0, 1]),
+    sections: [pendingSection('verse', 2, 4, 0)],
+  }));
+  assert.deepEqual(intoBlank.sections, []);
+  assert.equal(intoBlank.measures.length, 8);
+  assert.equal(intoBlank.title, 'Untitled');
+
+  // A typed title is kept, and a measure with a chord is never dropped.
+  const typed = withSongFormDefaults(song({
+    title: 'Blue Bossa',
+    autoTitle: false,
+    measures: measures(8, [6]),
+    sections: [pendingSection('verse', 0, 8, 4)],
+  }));
+  assert.equal(typed.title, 'Blue Bossa');
+  assert.equal(typed.measures.length, 7);
+
+  // An unreadable pending record still drops the section, but no measures.
+  const unreadable = { ...section('verse', 0, 8), pending: true } as unknown as SongSection;
+  const odd = withSongFormDefaults(song({ measures: measures(8), sections: [unreadable] }));
+  assert.deepEqual(odd.sections, []);
+  assert.equal(odd.measures.length, 8);
+
+  // Nothing pending: the song loads as saved, trailing blank measures and a
+  // never-set '' title included.
+  const asSaved = withSongFormDefaults(song({ title: '', measures: measures(12) }));
+  assert.equal(asSaved.measures.length, 12);
+  assert.equal(asSaved.title, '');
+});
+
+test('checkBarCount: whole numbers of bars from 1 to 64, two chords each', () => {
+  assert.deepEqual(checkBarCount('8'), { ok: true, bars: 8, count: 16 });
+  assert.deepEqual(checkBarCount(' 1 '), { ok: true, bars: 1, count: 2 });
+  assert.deepEqual(checkBarCount('64'), { ok: true, bars: 64, count: 128 });
+  for (const bad of ['', 'abc', '0', '65', '1.5', '-4', '4 4']) {
+    assert.equal(checkBarCount(bad).ok, false, `expected '${bad}' to be rejected`);
+  }
+});
+
+test('barCountSummary and the default bars of a section', () => {
+  assert.equal(barCountSummary(8), '16 chords, two per bar');
+  assert.equal(defaultSectionBars('verse'), 8);
+  assert.equal(defaultSectionBars('vamp'), 2);
+  assert.equal(defaultSectionBars('head'), 32);
+});
diff --git a/frontend/src/engine/songForm.ts b/frontend/src/engine/songForm.ts
new file mode 100644
index 0000000000000000000000000000000000000000..252c48b4a9e9c3c66d179e8b97894b7fea87b068
--- /dev/null
+++ b/frontend/src/engine/songForm.ts
@@ -0,0 +1,272 @@
+/**
+ * Song-form sections: the vocabulary shared with the backend
+ * (backend/app/models/sections.py — keep the two lists identical) plus the
+ * pure helpers the stores and the score view use to title, place and look
+ * up sections.
+ *
+ * Type-only imports on purpose: `node --test` runs songForm.test.ts against
+ * this file directly, without a bundler.
+ */
+import type { Song, SongSection, SectionType } from '../models/types';
+
+export type SectionGroup = 'common' | 'instrumental' | 'jazz';
+
+export interface SectionInfo {
+  label: string;
+  group: SectionGroup;
+  /** Chord count the "Build from Song Form" dialog starts from. */
+  defaultChords: number;
+}
+
+export const SECTION_INFO: Record<SectionType, SectionInfo> = {
+  intro:       { label: 'Intro',       group: 'common',       defaultChords: 8 },
+  verse:       { label: 'Verse',       group: 'common',       defaultChords: 16 },
+  pre_chorus:  { label: 'Pre-Chorus',  group: 'common',       defaultChords: 8 },
+  chorus:      { label: 'Chorus',      group: 'common',       defaultChords: 16 },
+  post_chorus: { label: 'Post-Chorus', group: 'common',       defaultChords: 8 },
+  bridge:      { label: 'Bridge',      group: 'common',       defaultChords: 16 },
+  outro:       { label: 'Outro',       group: 'common',       defaultChords: 8 },
+  interlude:   { label: 'Interlude',   group: 'instrumental', defaultChords: 8 },
+  solo:        { label: 'Solo',        group: 'instrumental', defaultChords: 16 },
+  breakdown:   { label: 'Breakdown',   group: 'instrumental', defaultChords: 16 },
+  drop:        { label: 'Drop',        group: 'instrumental', defaultChords: 16 },
+  vamp:        { label: 'Vamp',        group: 'instrumental', defaultChords: 4 },
+  turnaround:  { label: 'Turnaround',  group: 'instrumental', defaultChords: 4 },
+  tag:         { label: 'Tag',         group: 'instrumental', defaultChords: 8 },
+  head:        { label: 'Head',        group: 'jazz',         defaultChords: 64 },
+  a_section:   { label: 'A Section',   group: 'jazz',         defaultChords: 16 },
+  b_section:   { label: 'B Section',   group: 'jazz',         defaultChords: 16 },
+};
+
+/** Every section id, in dropdown order. */
+export const SECTION_TYPES = Object.keys(SECTION_INFO) as SectionType[];
+
+/** Dropdown <optgroup>s, in order. */
+export const SECTION_GROUPS: ReadonlyArray<{ id: SectionGroup; label: string }> = [
+  { id: 'common', label: 'Common' },
+  { id: 'instrumental', label: 'Instrumental' },
+  { id: 'jazz', label: 'Jazz' },
+];
+
+/** The editor has two chord slots per measure. */
+export const CHORDS_PER_BAR = 2;
+/** Cap on one generate request on every path: 128 chords = 64 bars. */
+export const MAX_SECTION_CHORDS = 128;
+export const MAX_SECTION_BARS = MAX_SECTION_CHORDS / CHORDS_PER_BAR;
+
+/** Title of a song with no sections that nobody has named. */
+export const DEFAULT_SONG_TITLE = 'Untitled';
+/** autoTitle lists at most this many section labels, then an ellipsis. */
+const AUTO_TITLE_MAX_LABELS = 6;
+
+export function isSectionType(value: unknown): value is SectionType {
+  return typeof value === 'string' && Object.hasOwn(SECTION_INFO, value);
+}
+
+export function sectionLabel(type: SectionType | null): string {
+  return type === null ? 'Section' : SECTION_INFO[type].label;
+}
+
+export function sectionDisplayLabel(section: SongSection): string {
+  return section.label?.trim() || sectionLabel(section.type);
+}
+
+/** Index of the first measure after `section`. */
+function sectionEnd(section: SongSection): number {
+  return section.startMeasure + section.length;
+}
+
+/** Keep imported regions editable without pretending their musical role is known. */
+export function checkSectionRanges(sections: readonly SongSection[], measureCount: number): string | null {
+  const ids = new Set<string>();
+  let previousEnd = 0;
+  for (const section of [...sections].sort((a, b) => a.startMeasure - b.startMeasure)) {
+    if (!isValidSection(section) || ids.has(section.id)) return 'Each section needs a valid, unique range.';
+    ids.add(section.id);
+    if (sectionEnd(section) > measureCount) return 'A section extends past the last bar.';
+    if (section.startMeasure < previousEnd) return 'Sections must not overlap.';
+    if (section.label !== undefined && (typeof section.label !== 'string' || section.label.length > 80)) {
+      return 'Section names must be 80 characters or fewer.';
+    }
+    previousEnd = sectionEnd(section);
+  }
+  return null;
+}
+
+export function sectionColor(type: SectionType | null): string {
+  if (type === 'chorus' || type === 'post_chorus' || type === 'drop') return '#d29b45';
+  if (type === 'verse' || type === 'head' || type === 'a_section') return '#6a9fc2';
+  if (type === 'bridge' || type === 'b_section' || type === 'solo') return '#a28abc';
+  if (type === 'pre_chorus' || type === 'breakdown' || type === 'turnaround') return '#b58077';
+  if (type === null) return '#929292';
+  return '#79a58a';
+}
+
+export function sectionsInGroup(group: SectionGroup): SectionType[] {
+  return SECTION_TYPES.filter((type) => SECTION_INFO[type].group === group);
+}
+
+export function barsForChords(chordCount: number): number {
+  return Math.ceil(chordCount / CHORDS_PER_BAR);
+}
+
+/** '1 bar', '8 bars'. */
+function barsLabel(bars: number): string {
+  return `${bars} ${bars === 1 ? 'bar' : 'bars'}`;
+}
+
+/** Single-section title, e.g. 'Chorus — 8 bars' (em dash, as the backend writes it). */
+export function sectionTitle(type: SectionType, bars: number): string {
+  return `${sectionLabel(type)} — ${barsLabel(bars)}`;
+}
+
+/**
+ * Title of a song built from sections. One section gives its sectionTitle;
+ * several give their labels in song order joined by en dashes, without
+ * spaces ('Intro–Verse–Chorus'), at most six labels and then an ellipsis.
+ * No sections gives DEFAULT_SONG_TITLE.
+ */
+export function autoTitle(sections: readonly SongSection[]): string {
+  if (sections.length === 0) return DEFAULT_SONG_TITLE;
+  const ordered = [...sections].sort((a, b) => a.startMeasure - b.startMeasure);
+  if (ordered.length === 1) {
+    const only = ordered[0];
+    return `${sectionDisplayLabel(only)} — ${barsLabel(only.length)}`;
+  }
+  const labels = ordered.slice(0, AUTO_TITLE_MAX_LABELS).map(sectionDisplayLabel);
+  // U+2013 en dash between labels, U+2026 ellipsis when some are left out.
+  return labels.join('–') + (ordered.length > AUTO_TITLE_MAX_LABELS ? '…' : '');
+}
+
+/** While the song's title is automatic, recompute it from its sections. */
+export function withAutoTitle(song: Song): Song {
+  return song.autoTitle ? { ...song, title: autoTitle(song.sections ?? []) } : song;
+}
+
+/**
+ * Where a new section of `bars` measures goes: right after the last measure
+ * that has any chord or belongs to a section (measure 0 on an empty song),
+ * and how many measures must be appended for it to fit.
+ */
+export function sectionPlacement(
+  song: Pick<Song, 'measures' | 'sections'>,
+  bars: number,
+): { startMeasure: number; measuresToAdd: number } {
+  let lastUsed = -1;
+  song.measures.forEach((measure, i) => {
+    if (measure.chords.some(Boolean)) lastUsed = i;
+  });
+  for (const section of song.sections ?? []) {
+    lastUsed = Math.max(lastUsed, sectionEnd(section) - 1);
+  }
+  const startMeasure = lastUsed + 1;
+  return {
+    startMeasure,
+    measuresToAdd: Math.max(0, startMeasure + bars - song.measures.length),
+  };
+}
+
+/** The section covering `measureIndex`, or null. */
+export function sectionAt(
+  song: Pick<Song, 'sections'>,
+  measureIndex: number,
+): SongSection | null {
+  return (song.sections ?? []).find(
+    (s) => measureIndex >= s.startMeasure && measureIndex < sectionEnd(s),
+  ) ?? null;
+}
+
+/** The section that contains every one of `measureIndices`, or null. */
+export function sectionContaining(
+  song: Pick<Song, 'sections'>,
+  measureIndices: readonly number[],
+): SongSection | null {
+  if (measureIndices.length === 0) return null;
+  const section = sectionAt(song, Math.min(...measureIndices));
+  if (!section) return null;
+  return Math.max(...measureIndices) < sectionEnd(section) ? section : null;
+}
+
+function isValidSection(value: unknown): value is SongSection {
+  if (typeof value !== 'object' || value === null) return false;
+  const s = value as Record<string, unknown>;
+  return (
+    typeof s.id === 'string' &&
+    (s.type === null || isSectionType(s.type)) &&
+    Number.isInteger(s.startMeasure) && (s.startMeasure as number) >= 0 &&
+    Number.isInteger(s.length) && (s.length as number) >= 1
+  );
+}
+
+/** Measures appended for a pending section; 0 when the record is unreadable. */
+function addedMeasures(section: SongSection): number {
+  const count = section.pending?.addedMeasures;
+  return typeof count === 'number' && count > 0 ? Math.floor(count) : 0;
+}
+
+/**
+ * Take back a placement whose generation never finished (the page was
+ * reloaded or closed while "New from Song Form" ran): drop the pending
+ * sections and the measures appended only for them, i.e. at most
+ * `addedMeasures` trailing measures that have no chord and no other
+ * section. An automatic title then stops naming them.
+ */
+function withoutPendingSections(song: Song): Song {
+  const all = song.sections ?? [];
+  const sections = all.filter((s) => !s.pending);
+  if (sections.length === all.length) return song;
+  const added = all.reduce((sum, s) => sum + addedMeasures(s), 0);
+  const floor = Math.max(0, song.measures.length - added);
+  let end = song.measures.length;
+  while (
+    end > floor &&
+    !song.measures[end - 1].chords.some(Boolean) &&
+    !sectionAt({ sections }, end - 1)
+  ) {
+    end--;
+  }
+  return withAutoTitle({ ...song, measures: song.measures.slice(0, end), sections });
+}
+
+/**
+ * Fill in the song-form fields that songs saved before sections existed
+ * lack: no sections, and an automatic title only when the title was never
+ * set ('' or 'Untitled'). A section still pending when the song was saved
+ * is taken back (see withoutPendingSections).
+ */
+export function withSongFormDefaults(song: Song): Song {
+  const sections = Array.isArray(song.sections) ? song.sections.filter(isValidSection) : [];
+  const title = (song.title ?? '').trim();
+  const auto = typeof song.autoTitle === 'boolean'
+    ? song.autoTitle
+    : title === '' || title === DEFAULT_SONG_TITLE;
+  return withoutPendingSections({ ...song, sections, autoTitle: auto });
+}
+
+/** `count` is the chords the section API takes, two per bar. */
+export type BarCountCheck =
+  | { ok: true; bars: number; count: number }
+  | { ok: false; message: string };
+
+/** Bars a section type starts with in the dialog: its default chord count, two per bar. */
+export function defaultSectionBars(type: SectionType): number {
+  return barsForChords(SECTION_INFO[type].defaultChords);
+}
+
+/** Validate the dialog's bar-count text: a whole number of bars, 1..64. */
+export function checkBarCount(text: string): BarCountCheck {
+  const trimmed = text.trim();
+  if (!/^\d+$/.test(trimmed)) {
+    return { ok: false, message: `Enter a number of bars from 1 to ${MAX_SECTION_BARS}` };
+  }
+  const bars = Number(trimmed);
+  if (bars < 1 || bars > MAX_SECTION_BARS) {
+    return { ok: false, message: `Use 1 to ${MAX_SECTION_BARS} bars` };
+  }
+  return { ok: true, bars, count: bars * CHORDS_PER_BAR };
+}
+
+/** Live hint for a bar count, e.g. '16 chords, two per bar'. */
+export function barCountSummary(bars: number): string {
+  return `${bars * CHORDS_PER_BAR} chords, two per bar`;
+}
