--- /dev/null
+++ b/frontend/src/components/ScoreEditor/ReharmBand.tsx
@@ -0,0 +1,61 @@
+import { useReharmonizeStore } from '../../store/reharmonizeStore';
+import { reharmSymbol } from '../../engine/reharmonize';
+
+const FAMILY = { common_tones: 'Shared tones', modal: 'Modal color', dominant: 'Dominant approach' };
+
+/** This remains on the score while the user switches to the existing Play controls. */
+export default function ReharmBand() {
+  const { comparison, result, loading, error, selected, preview, close } = useReharmonizeStore();
+  if (!comparison) return null;
+  const measures = comparison.original.map(c => c.address.measureIndex + 1);
+  const range = Math.min(...measures) === Math.max(...measures) ? `M${measures[0]}` : `M${Math.min(...measures)}–${Math.max(...measures)}`;
+  return <section id="reharmonization-comparison" aria-label="Reharmonization comparison" className="p-3 space-y-2 rounded-md"
+    style={{ color: 'var(--text-primary)', background: 'var(--bg-secondary)', border: '1px solid var(--border)' }}>
+    <div className="flex flex-wrap items-center justify-between gap-2">
+      <div className="text-xs font-semibold">Reharmonize · {range}</div>
+      <button onClick={close} className="w-6 h-6 rounded text-base leading-none"
+        style={{ border: '1px solid var(--border)' }}
+        aria-label="Close reharmonization" title="Close · discard unapplied changes">
+        <span aria-hidden="true">×</span>
+      </button>
+    </div>
+    {loading && <p role="status" className="text-xs">Exploring substitutions…</p>}
+    {error && <p role="alert" className="text-xs">{error}</p>}
+    {result && <>
+      <div className="grid grid-cols-4 items-stretch gap-2">
+        <button aria-pressed={selected.length === 0} aria-label="Preview Origin on the score" onClick={() => preview(null)}
+          className="min-w-0 flex flex-col items-start text-left px-2 py-2 rounded space-y-1"
+          style={{ background: selected.length === 0 ? 'var(--brand-yellow)' : 'var(--btn-bg)',
+            color: selected.length === 0 ? '#1a1a1a' : 'var(--text-primary)', border: '1px solid var(--border)' }}>
+          <div className="text-xs font-semibold">Origin{selected.length === 0 ? ' ✓' : ''}</div>
+          <div className="text-xs break-words">{comparison.original.map(c => c.chord ? reharmSymbol(c.chord) : '—').join(' · ')}</div>
+        </button>
+        {result.candidates.map((candidate, index) => <button key={candidate.id} aria-pressed={selected.includes(index)}
+          aria-label={`Select Alter ${index + 1}`} onClick={() => preview(index)}
+          className="min-w-0 flex flex-col items-start text-left px-2 py-2 rounded space-y-1"
+          style={{ background: selected.includes(index) ? 'var(--brand-yellow)' : 'var(--btn-bg)',
+            color: selected.includes(index) ? '#1a1a1a' : 'var(--text-primary)', border: '1px solid var(--border)' }}>
+          <div className="flex flex-wrap items-center gap-x-2 text-xs font-semibold">
+            <span>Alter {index + 1}{selected.includes(index) ? ' ✓' : ''}</span>
+            <span className="text-[10px] font-normal">{FAMILY[candidate.family]}</span>
+          </div>
+          {candidate.changes.map(c => <div key={`${c.address.measureIndex}-${c.address.slotIndex}`} className="text-xs break-words">
+            <span className="text-[10px]">M{c.address.measureIndex + 1}.{c.address.slotIndex + 1} </span>
+            <span className="opacity-60">{c.before}</span> → <strong>{c.after}</strong>
+          </div>)}
+          <div className="text-[10px] opacity-75">
+            {[...new Set(candidate.changes.flatMap(c => c.conventions ?? []))].join(' · ') ||
+              candidate.changes.map(c => `${c.commonTones} shared tones`).join(' · ')}
+          </div>
+        </button>)}
+      </div>
+      {!!result.modelApproximations?.length && <details className="text-[11px]" style={{ color: 'var(--text-muted)' }}>
+        <summary className="cursor-pointer">Some chord colors have limited model scoring</summary>
+        <p>Full chord tones are used for substitution matching and comparison. The music model uses these simpler symbols for scoring only:</p>
+        <ul>{result.modelApproximations.map(a => <li key={`${a.address.measureIndex}.${a.address.slotIndex}`}>
+          M{a.address.measureIndex + 1}.{a.address.slotIndex + 1}: {a.original} → {a.scoredAs}
+        </li>)}</ul>
+      </details>}
+    </>}
+  </section>;
+}
diff --git a/frontend/src/components/ScoreEditor/ScoreContextMenu.tsx b/frontend/src/components/ScoreEditor/ScoreContextMenu.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..303c8aa88dc1e472530b5a67ec93377a3677dea3
--- /dev/null
+++ b/frontend/src/components/ScoreEditor/ScoreContextMenu.tsx
@@ -0,0 +1,76 @@
+import { useEffect, useRef } from 'react';
+import { createPortal } from 'react-dom';
+
+export interface ContextMenuItem {
+  id: string;
+  label: string;
+  /** Keyboard shortcut shown beside the label. */
+  hint?: string;
+  disabled?: boolean;
+  /** Why the item is disabled, as its tooltip. */
+  title?: string;
+  /** Draw a separator above this item. */
+  divider?: boolean;
+  run: () => void;
+}
+
+interface Props {
+  x: number;
+  y: number;
+  items: ContextMenuItem[];
+  onChoose: (item: ContextMenuItem) => void;
+  onClose: () => void;
+}
+
+const MENU_WIDTH = 208;
+
+/** Right-click menu over the selected passage: clipboard edits on the
+ *  selection, then the tools. Opening a tool never starts a model call. */
+export default function ScoreContextMenu({ x, y, items, onChoose, onClose }: Props) {
+  const menu = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const element = menu.current;
+    const buttons = [...element?.querySelectorAll<HTMLButtonElement>('button:not([disabled])') ?? []];
+    buttons[0]?.focus();
+    const dismissOutside = (event: PointerEvent) => {
+      if (!element?.contains(event.target as Node)) onClose();
+    };
+    const keyboard = (event: KeyboardEvent) => {
+      if (event.key === 'Escape' || event.key === 'Tab') {
+        if (event.key === 'Escape') event.preventDefault();
+        onClose();
+      } else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const current = buttons.indexOf(document.activeElement as HTMLButtonElement);
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1
+          : (current + (event.key === 'ArrowDown' ? 1 : -1) + buttons.length) % buttons.length;
+        buttons[next]?.focus();
+      }
+    };
+    window.addEventListener('pointerdown', dismissOutside);
+    window.addEventListener('keydown', keyboard);
+    window.addEventListener('scroll', onClose, true);
+    window.addEventListener('resize', onClose);
+    return () => {
+      window.removeEventListener('pointerdown', dismissOutside);
+      window.removeEventListener('keydown', keyboard);
+      window.removeEventListener('scroll', onClose, true);
+      window.removeEventListener('resize', onClose);
+    };
+  }, [onClose]);
+
+  const height = items.length * 34 + 12;
+  return createPortal(<div ref={menu} role="menu" aria-label="Selected passage" className="fixed p-1 rounded-md shadow-xl"
+    onContextMenu={event => event.preventDefault()}
+    style={{ left: Math.max(8, Math.min(x, window.innerWidth - MENU_WIDTH - 8)),
+      top: Math.max(8, Math.min(y, window.innerHeight - height - 8)), width: MENU_WIDTH, maxWidth: 'calc(100vw - 16px)',
+      zIndex: 100, background: 'var(--bg-surface)', color: 'var(--text-primary)', border: '1px solid var(--border)' }}>
+    {items.map(item => <button key={item.id} role="menuitem" disabled={item.disabled} title={item.disabled ? item.title : undefined}
+      onClick={() => onChoose(item)}
+      className="flex w-full items-center justify-between gap-3 px-3 py-2 text-left text-sm rounded btn-hover focus-visible:outline-2 disabled:opacity-40 disabled:cursor-default"
+      style={{ outlineColor: 'var(--brand-yellow)', ...(item.divider ? { borderTop: '1px solid var(--border)', borderRadius: 0, marginTop: 4, paddingTop: 10 } : {}) }}>
+      <span>{item.label}</span>
+      {item.hint && <span className="text-xs" style={{ color: 'var(--text-muted)' }}>{item.hint}</span>}
+    </button>)}
+  </div>, document.body);
+}
diff --git a/frontend/src/components/ScoreEditor/SectionsDialog.tsx b/frontend/src/components/ScoreEditor/SectionsDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..282cf3d9524c790cf79bab1b453aec3aed8f07d8
--- /dev/null
+++ b/frontend/src/components/ScoreEditor/SectionsDialog.tsx
@@ -0,0 +1,98 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import type { FormEvent } from 'react';
+import { useSongStore } from '../../store/songStore';
+import { checkSectionRanges, isSectionType, SECTION_TYPES, sectionLabel } from '../../engine/songForm';
+import type { SongSection } from '../../models/types';
+
+const fieldStyle = { background: 'var(--btn-bg)', color: 'var(--text-primary)', border: '1px solid var(--border)' };
+
+/** The first measure not covered by the sections that run on from measure 0. */
+function firstUncoveredMeasure(sections: readonly SongSection[]): number {
+  let start = 0;
+  for (const section of [...sections].sort((a, b) => a.startMeasure - b.startMeasure)) {
+    if (section.startMeasure > start) break;
+    start = Math.max(start, section.startMeasure + section.length);
+  }
+  return start;
+}
+
+/** "Edit Song Form": name, type and bar range of each region. Edits stay in
+ *  the dialog until they are applied. */
+export default function SectionsDialog({ onClose }: { onClose: () => void }) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const headingId = useId();
+  const song = useSongStore((s) => s.song);
+  const setSections = useSongStore((s) => s.setSections);
+  const [sections, updateSections] = useState<SongSection[]>(() => structuredClone(song.sections ?? []));
+  const error = checkSectionRanges(sections, song.measures.length);
+  useEffect(() => { dialogRef.current?.showModal(); }, []);
+
+  // An edited region is the user's own, so it no longer shows as suggested.
+  const editSection = (id: string, patch: Partial<SongSection>) => {
+    updateSections((items) => items.map((s) => s.id === id ? { ...s, ...patch, origin: 'manual' } : s));
+  };
+  const removeSection = (id: string) => {
+    updateSections((items) => items.filter((item) => item.id !== id));
+  };
+  const addSection = () => {
+    const start = firstUncoveredMeasure(sections);
+    if (start >= song.measures.length) return;
+    updateSections((items) => [...items, {
+      id: crypto.randomUUID(), type: null, label: '', startMeasure: start, length: 1, origin: 'manual',
+    }]);
+  };
+  const applySections = (event: FormEvent) => {
+    event.preventDefault();
+    // setSections returns an error message, or null once the sections are applied.
+    if (!setSections(sections)) dialogRef.current?.close();
+  };
+
+  return (
+    <dialog ref={dialogRef} onClose={onClose} aria-labelledby={headingId} className="m-auto p-0 backdrop:bg-black/60"
+      style={{ width: 'min(720px, calc(100vw - 32px))', maxHeight: 'calc(100dvh - 32px)', background: 'var(--bg-surface)', color: 'var(--text-primary)', border: '1px solid var(--border)' }}>
+      <form className="p-5 space-y-4" onSubmit={applySections}>
+        <h2 id={headingId} className="font-display text-2xl" style={{ color: 'var(--text-heading)' }}>Song Form</h2>
+        <p className="text-xs" style={{ color: 'var(--text-muted)' }}>
+          Name the regions you know. Leave the type unassigned when the score does not identify its role.
+        </p>
+        <div className="space-y-3">
+          {sections.map((section, index) => (
+            <fieldset key={section.id} className="p-3 space-y-2" style={{ border: '1px solid var(--border)' }}>
+              <legend className="text-xs px-1">Region {index + 1}{section.origin === 'inferred' ? ' · suggested' : ''}</legend>
+              <div className="flex flex-wrap gap-2 items-end">
+                <label className="text-xs flex-1 min-w-28">Name
+                  <input aria-label={`Region ${index + 1} name`} value={section.label ?? ''} placeholder={sectionLabel(section.type)} maxLength={80}
+                    onChange={(e) => editSection(section.id, { label: e.target.value })} className="block w-full p-2 mt-1" style={fieldStyle} />
+                </label>
+                <label className="text-xs">Type
+                  <select aria-label={`Region ${index + 1} type`} value={section.type ?? ''} onChange={(e) => editSection(section.id, { type: isSectionType(e.target.value) ? e.target.value : null })}
+                    className="block p-2 mt-1" style={fieldStyle}>
+                    <option value="">Unassigned</option>
+                    {SECTION_TYPES.map((type) => <option key={type} value={type}>{sectionLabel(type)}</option>)}
+                  </select>
+                </label>
+                <label className="text-xs">From bar
+                  <input type="number" min={1} max={song.measures.length} value={section.startMeasure + 1}
+                    onChange={(e) => editSection(section.id, { startMeasure: Number(e.target.value) - 1 })} className="block w-20 p-2 mt-1" style={fieldStyle} />
+                </label>
+                <label className="text-xs">To bar
+                  <input type="number" min={1} max={song.measures.length} value={section.startMeasure + section.length}
+                    onChange={(e) => editSection(section.id, { length: Number(e.target.value) - section.startMeasure })} className="block w-20 p-2 mt-1" style={fieldStyle} />
+                </label>
+                <button type="button" className="text-xs px-2 py-2 btn-hover" style={fieldStyle}
+                  onClick={() => removeSection(section.id)}>Remove</button>
+              </div>
+            </fieldset>
+          ))}
+        </div>
+        <button type="button" onClick={addSection} className="px-3 py-2 text-xs btn-hover" style={fieldStyle}>Add region</button>
+        {error && <p role="alert" className="text-sm" style={{ color: 'var(--text-heading)' }}>{error}</p>}
+        <div className="flex justify-end gap-2">
+          <button type="button" onClick={() => dialogRef.current?.close()} className="px-3 py-2 text-xs btn-hover" style={fieldStyle}>Cancel</button>
+          <button type="submit" disabled={!!error} className="px-4 py-2 text-xs font-bold btn-hover disabled:opacity-50"
+            style={{ background: 'var(--brand-yellow)', color: '#1a1a1a' }}>Apply sections</button>
+        </div>
+      </form>
+    </dialog>
+  );
+}
