+  { name: 'orchestral_harp',       label: 'Harp',     family: 'strings' },
+  { name: 'flute',                 label: 'Flute',    family: 'winds' },
+  { name: 'clarinet',              label: 'Clarinet', family: 'winds' },
+  { name: 'oboe',                  label: 'Oboe',     family: 'winds' },
+  { name: 'bassoon',               label: 'Bassoon',  family: 'winds' },
