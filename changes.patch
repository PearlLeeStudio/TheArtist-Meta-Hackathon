+import { normalizeGenre } from '../../../engine/playSettings';
+
+/** The song's genre as the pane screens and tooltips name it. */
+export function genreTag(genre: string | null): string {
+  const g = normalizeGenre(genre);
+  if (!g) return 'no genre';
+  return g === 'rnb_soul' ? 'r&b/soul' : g.replace('_', '-');
+}
diff --git a/frontend/src/components/RightPanel/play/paneKeys.ts b/frontend/src/components/RightPanel/play/paneKeys.ts
new file mode 100644
index 0000000000000000000000000000000000000000..be4aa6713a1ced2c2862ad1a5f1caf72f80a9036
--- /dev/null
+++ b/frontend/src/components/RightPanel/play/paneKeys.ts
@@ -0,0 +1,52 @@
+/**
+ * Shared by the Instrument, Rhythm and Drums panes: the type of their
+ * worded keys, and keyboard movement through a group of choice keys.
+ */
+import type { CSSProperties, KeyboardEvent } from 'react';
+
+/** Type of a pane key that carries a word or two: a part toggle, Auto. */
+export const KEY_TEXT_STYLE: CSSProperties = { fontSize: 12, lineHeight: '14px', letterSpacing: 'normal' };
+
+/** A full-width key as tall as an sm key (26px): the Rhythm and Drums
+ *  part toggles and their Auto keys. */
+export const WIDE_KEY_STYLE: CSSProperties = { height: 26, minHeight: 26, ...KEY_TEXT_STYLE };
+
+/** The picked key of a narrow grid reads heavier at the same width: bold would widen
+ *  its label and wrap it past the key's height, a hairline stroke does not. */
+export function pickedLabelStyle(picked: boolean): CSSProperties {
+  return { fontWeight: 400, WebkitTextStroke: picked ? '0.45px currentColor' : undefined };
+}
+
+/** Where an arrow, Home or End key moves from choice `index` of `count`
+ *  (the arrows wrap around); null for any other key. */
+function nextChoiceIndex(key: string, index: number, count: number): number | null {
+  switch (key) {
+    case 'ArrowRight':
+    case 'ArrowDown':
+      return (index + 1) % count;
+    case 'ArrowLeft':
+    case 'ArrowUp':
+      return (index + count - 1) % count;
+    case 'Home':
+      return 0;
+    case 'End':
+      return count - 1;
+    default:
+      return null;
+  }
+}
+
+/**
+ * Roving choice for a group's onKeyDown: from a focused key matching
+ * `selector`, the arrows, Home and End click and focus another one.
+ */
+export function moveChoiceByKey(event: KeyboardEvent<HTMLElement>, selector: string): void {
+  const choices = Array.from(event.currentTarget.querySelectorAll<HTMLButtonElement>(selector));
+  const index = choices.indexOf(event.target as HTMLButtonElement);
+  if (index < 0) return;
+  const next = nextChoiceIndex(event.key, index, choices.length);
+  if (next === null) return;
+  event.preventDefault();
+  choices[next]?.click();
+  choices[next]?.focus();
+}
diff --git a/frontend/src/components/RightPanel/play/ui/KeyButton.tsx b/frontend/src/components/RightPanel/play/ui/KeyButton.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1fac76ce357b88ca9b2b8188ab8e6b5908833334
--- /dev/null
+++ b/frontend/src/components/RightPanel/play/ui/KeyButton.tsx
@@ -0,0 +1,85 @@
+import type { CSSProperties, ReactNode } from 'react';
+
+type KeySize = 'sm' | 'md';
+
+interface KeyButtonProps {
+  label?: string;
+  /** An icon in place of the label (the label then becomes the accessible name). */
+  children?: ReactNode;
+  /** Latched / selected: pressed look, plus aria-pressed (aria-checked or
+   *  aria-selected when `role` is a checkable or selectable role). */
+  active?: boolean;
+  onClick?: () => void;
+  title?: string;
+  ariaLabel?: string;
+  /** Fixed heights: sm 26px, md 30px (default). */
+  size?: KeySize;
+  role?: string;
+  /** For a tab in a roving-tabindex tablist: -1 takes it out of the tab order. */
+  tabIndex?: number;
+  id?: string;
+  ariaControls?: string;
+  className?: string;
+  style?: CSSProperties;
+}
+
+/** Geometry per size (px): key height, label type and line. */
+const SIZES: Record<KeySize, { height: number; font: number; line: number }> = {
+  sm: { height: 26, font: 9, line: 10 },
+  md: { height: 30, font: 10, line: 12 },
+};
+/** Side padding inside the 1px border. */
+const PAD_X = 3;
+
+const CHECKED_ROLES = new Set(['checkbox', 'radio', 'switch', 'menuitemcheckbox', 'menuitemradio']);
+const SELECTED_ROLES = new Set(['tab', 'option', 'gridcell', 'row', 'treeitem']);
+
+/**
+ * Square device key: uppercase device type on one line (ellipsis), or an
+ * icon. Fills its grid cell's width; its height is fixed by `size`.
+ */
+export default function KeyButton({
+  label,
+  children,
+  active,
+  onClick,
+  title,
+  ariaLabel,
+  size = 'md',
+  role,
+  tabIndex,
+  id,
+  ariaControls,
+  className,
+  style,
+}: KeyButtonProps) {
+  const geometry = SIZES[size];
+  const toggle = role === undefined || role === 'button';
+  const checkable = role !== undefined && CHECKED_ROLES.has(role);
+  const selectable = role !== undefined && SELECTED_ROLES.has(role);
+
+  return (
+    <button
+      type="button"
+      id={id}
+      role={role}
+      tabIndex={tabIndex}
+      aria-controls={ariaControls}
+      aria-pressed={toggle ? active : undefined}
+      aria-checked={checkable ? Boolean(active) : undefined}
+      aria-selected={selectable ? Boolean(active) : undefined}
+      aria-label={ariaLabel ?? (children !== undefined ? label : undefined)}
+      title={title}
+      onClick={onClick}
+      data-active={active ? '' : undefined}
+      className={`te-key btn-hover relative flex w-full min-w-0 flex-col items-center justify-center uppercase select-none${className ? ` ${className}` : ''}`}
+      style={{ height: geometry.height, paddingInline: PAD_X, fontSize: geometry.font, ...style }}
+    >
+      {children ?? (label !== undefined && (
+        <span className="relative block max-w-full truncate" style={{ lineHeight: `${geometry.line}px` }}>
+          {label}
+        </span>
+      ))}
+    </button>
+  );
+}
