@@ -0,0 +1,190 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createMidiCaptureState } from './midiCaptureState.ts';
+import type { Chord } from '../models/types';
+
+const chord: Chord = { root: 'C', quality: 'maj', voicing: [60, 64, 67], romanNumeral: 'I', extensions: [] };
+const seventh: Chord = { ...chord, quality: 'maj7', voicing: [60, 64, 67, 71] };
+
+function fixture() {
+  let now = 0;
+  let nextId = 0;
+  const timers = new Map<number, () => void>();
+  const commits: Chord[] = [];
+  let live: Chord[] = [];
+  const capture = createMidiCaptureState({
+    clock: {
+      now: () => now,
+      setInterval: (callback) => { const id = ++nextId; timers.set(id, callback); return id; },
+      clearInterval: (id) => { timers.delete(id); },
+    },
+    onCommit: (value) => { commits.push(value); return true; },
+    onCandidates: (value) => { live = value; },
+  });
+  return {
+    capture, commits, timers, live: () => live,
+    advance(milliseconds: number) { now += milliseconds; [...timers.values()].forEach((callback) => callback()); },
+    play(value = chord) { capture.notes(value.voicing); capture.detected([value]); },
+  };
+}
+
+test('monitoring publishes notes and chords without a target, timer or commit', () => {
+  const f = fixture();
+  f.capture.setContext(false, null);
+  f.play();
+  f.advance(10_000);
+  assert.deepEqual(f.live(), [chord]);
+  assert.equal(f.timers.size, 0);
+  f.capture.notes([]);
+  f.capture.confirm();
+  assert.equal(f.capture.getSnapshot().confirming, null);
+  assert.deepEqual(f.live(), []);
+  assert.deepEqual(f.commits, []);
+});
+
+test('leaving the input tab cancels a running hold and never commits in Play', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play();
+  f.advance(2000);
+  assert.ok(f.capture.getSnapshot().holdProgress > 0);
+  f.capture.setContext(false, '0:0');
+  assert.equal(f.timers.size, 0);
+  assert.equal(f.capture.getSnapshot().holdProgress, 0);
+  f.advance(5000);
+  f.capture.notes([]);
+  f.capture.confirm();
+  assert.deepEqual(f.commits, []);
+  assert.equal(f.capture.getSnapshot().confirming, null);
+});
+
+test('returning to capture requires a fresh press rather than committing held monitor notes', () => {
+  const f = fixture();
+  f.play();
+  f.capture.setContext(true, '0:0');
+  f.capture.detected([seventh]);
+  f.advance(5000);
+  assert.equal(f.capture.getSnapshot().awaitingRelease, true);
+  assert.deepEqual(f.commits, []);
+  f.capture.notes([]);
+  f.play();
+  f.advance(3000);
+  assert.deepEqual(f.commits, [chord]);
+});
+
+test('a hold commits once and partial key releases cannot start a second commit', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play(seventh);
+  f.advance(3000);
+  f.capture.notes(chord.voicing);
+  f.capture.detected([chord]);
+  f.advance(5000);
+  f.capture.notes([]);
+  assert.deepEqual(f.commits, [seventh]);
+  assert.equal(f.capture.getSnapshot().confirming, null);
+});
+
+test('early release reviews the largest voicing, but hidden confirmation cannot write it', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play(seventh);
+  f.capture.notes(chord.voicing);
+  f.capture.detected([chord]);
+  f.capture.notes([]);
+  assert.equal(f.capture.getSnapshot().confirming?.candidates[0], seventh);
+  f.capture.setContext(false, '0:0');
+  f.capture.confirm();
+  assert.deepEqual(f.commits, []);
+  assert.equal(f.capture.getSnapshot().confirming, null);
+});
+
+test('selection changes and song replacement cancel stale capture state', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play();
+  f.advance(2000);
+  f.capture.setContext(true, '1:0');
+  f.advance(3000);
+  assert.deepEqual(f.commits, []);
+  assert.equal(f.timers.size, 0);
+  f.capture.reset();
+  assert.deepEqual(f.live(), []);
+  assert.equal(f.capture.getSnapshot().awaitingRelease, false);
+  assert.equal(f.capture.getSnapshot().confirming, null);
+});
+
+test('one selected target is needed for capture, but losing it keeps live monitoring', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play();
+  f.capture.setContext(true, null);
+  f.capture.detected([seventh]);
+  f.advance(3000);
+  assert.deepEqual(f.live(), [seventh]);
+  assert.deepEqual(f.commits, []);
+  assert.equal(f.timers.size, 0);
+});
+
+test('disposal cancels all scheduled capture work', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play();
+  f.capture.dispose();
+  assert.equal(f.timers.size, 0);
+  f.advance(5000);
+  assert.deepEqual(f.commits, []);
+});
+
+test('auto-advance cannot rearm the still-held chord through a synchronous target update', () => {
+  let now = 0;
+  let tick: (() => void) | null = null;
+  let commits = 0;
+  const capture = createMidiCaptureState({
+    clock: {
+      now: () => now,
+      setInterval: (callback) => { tick = callback; return 1; },
+      clearInterval: () => { tick = null; },
+    },
+    onCandidates: () => {},
+    onCommit: () => { commits++; capture.setContext(true, '0:1'); return true; },
+  });
+  capture.setContext(true, '0:0');
+  capture.notes(seventh.voicing);
+  capture.detected([seventh]);
+  now = 3000;
+  const fire = tick as (() => void) | null;
+  fire?.();
+  capture.notes(chord.voicing);
+  capture.detected([chord]);
+  assert.equal(commits, 1);
+  assert.equal(tick, null);
+  capture.notes([]);
+  assert.equal(capture.getSnapshot().confirming, null);
+});
+
+test('automatic input commits the chord still held, not a larger earlier voicing', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play(seventh);
+  f.advance(500);
+  f.capture.notes(chord.voicing);
+  f.capture.detected([chord]);
+  f.advance(3000);
+  assert.deepEqual(f.commits, [chord]);
+});
+
+test('dropping below three held notes cancels automatic input but retains early-release review', () => {
+  const f = fixture();
+  f.capture.setContext(true, '0:0');
+  f.play();
+  f.advance(2000);
+  f.capture.notes([60, 64]);
+  assert.equal(f.timers.size, 0);
+  assert.equal(f.capture.getSnapshot().holdProgress, 0);
+  assert.deepEqual(f.live(), []);
+  f.advance(5000);
+  assert.deepEqual(f.commits, []);
+  f.capture.notes([]);
+  assert.deepEqual(f.capture.getSnapshot().confirming?.candidates, [chord]);
+});
diff --git a/frontend/src/engine/midiCaptureState.ts b/frontend/src/engine/midiCaptureState.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e66a23086264e1ec14c0335841293e41133c543c
--- /dev/null
+++ b/frontend/src/engine/midiCaptureState.ts
@@ -0,0 +1,169 @@
+import type { Chord } from '../models/types';
+
+export const HOLD_DURATION_MS = 3000;
+export const PROGRESS_TICK_MS = 50;
+/** A chord needs this many held notes; with fewer, the live chord clears and no hold runs. */
+const MIN_CHORD_NOTES = 3;
+
+export interface ConfirmState { candidates: Chord[]; activeIdx: number }
+export interface MidiCaptureSnapshot {
+  candidates: Chord[];
+  activeIdx: number;
+  holdProgress: number;
+  confirming: ConfirmState | null;
+  awaitingRelease: boolean;
+}
+export interface CaptureClock {
+  now: () => number;
+  setInterval: (callback: () => void, delay: number) => number;
+  clearInterval: (id: number) => void;
+}
+
+const idleSnapshot = (): MidiCaptureSnapshot => ({
+  candidates: [], activeIdx: 0, holdProgress: 0, confirming: null, awaitingRelease: false,
+});
+
+const isIndexIn = (index: number, items: readonly unknown[]): boolean =>
+  Number.isInteger(index) && index >= 0 && index < items.length;
+
+/** Identity of a detected chord: root, quality, bass and the held notes. */
+const voicingId = (chord: Chord): string =>
+  `${chord.root}:${chord.quality}:${chord.bass ?? ''}:${chord.voicing.join(',')}`;
+
+/** Event-driven capture. Monitoring can publish live chords, but only an
+ *  active input target can start a timer or commit. The clock is injectable
+ *  so boundary changes are testable without a MIDI device or browser. */
+export function createMidiCaptureState(options: {
+  clock: CaptureClock;
+  onCommit: (chord: Chord) => boolean;
+  onCandidates: (chords: Chord[]) => void;
+}) {
+  let snapshot = idleSnapshot();
+  const listeners = new Set<() => void>();
+  let captureActive = false;
+  let target: string | null = null;
+  let heldCount = 0;
+  // Candidates for the largest voicing of the current press, offered for
+  // review when the keys are released before the hold completes.
+  let peak: Chord[] = [];
+  let committed = false;
+  let timer: number | null = null;
+  let holdStart = 0;
+  let timedVoicingId = '';
+
+  const publish = (patch: Partial<MidiCaptureSnapshot>) => {
+    const previous = snapshot;
+    snapshot = { ...snapshot, ...patch };
+    if (snapshot.candidates !== previous.candidates) options.onCandidates(snapshot.candidates);
+    listeners.forEach((listener) => listener());
+  };
+  const stopTimer = () => {
+    if (timer !== null) options.clock.clearInterval(timer);
+    timer = null;
+    timedVoicingId = '';
+  };
+  const canCapture = () => captureActive && target !== null && !snapshot.awaitingRelease;
+  const resetCapture = () => {
+    stopTimer();
+    peak = [];
+    committed = false;
+    publish({ activeIdx: 0, holdProgress: 0, confirming: null, awaitingRelease: heldCount > 0 });
+  };
+  const clearLiveChord = () => {
+    stopTimer();
+    publish({ candidates: [], activeIdx: 0, holdProgress: 0 });
+  };
+  /** One progress step of a running hold; a completed hold commits the active candidate. */
+  const tickHold = () => {
+    if (!canCapture() || committed || heldCount < MIN_CHORD_NOTES) { stopTimer(); return; }
+    const progress = Math.min(1, (options.clock.now() - holdStart) / HOLD_DURATION_MS);
+    publish({ holdProgress: progress });
+    if (progress < 1) return;
+    stopTimer();
+    const chords = snapshot.candidates;
+    const chord = chords[Math.min(snapshot.activeIdx, chords.length - 1)];
+    // A store write can advance the target and synchronously reset the
+    // capture context. Keep this press committed until the full release.
+    if (chord && options.onCommit(chord)) {
+      committed = true;
+      peak = [];
+      publish({ candidates: [], activeIdx: 0, holdProgress: 0, confirming: null, awaitingRelease: true });
+    } else resetCapture();
+  };
+  /** Holding the same voicing keeps the hold timer running; any change restarts it. */
+  const startTimer = (nextVoicingId: string) => {
+    if (timer !== null && timedVoicingId === nextVoicingId) return;
+    stopTimer();
+    timedVoicingId = nextVoicingId;
+    holdStart = options.clock.now();
+    publish({ holdProgress: 0 });
+    timer = options.clock.setInterval(tickHold, PROGRESS_TICK_MS);
+  };
+
+  return {
+    getSnapshot: () => snapshot,
+    subscribe: (listener: () => void) => { listeners.add(listener); return () => { listeners.delete(listener); }; },
+    setContext(active: boolean, nextTarget: string | null) {
+      if (captureActive === active && target === nextTarget) return;
+      captureActive = active;
+      target = nextTarget;
+      resetCapture();
+    },
+    notes(notes: number[]) {
+      heldCount = notes.length;
+      if (heldCount) {
+        if (heldCount < MIN_CHORD_NOTES) clearLiveChord();
+        return;
+      }
+      // Full release: a press that did not commit is offered for review.
+      stopTimer();
+      const confirming = canCapture() && !committed && peak.length
+        ? { candidates: peak, activeIdx: Math.min(snapshot.activeIdx, peak.length - 1) } : snapshot.confirming;
+      peak = [];
+      committed = false;
+      publish({ candidates: [], activeIdx: 0, holdProgress: 0, confirming, awaitingRelease: false });
+    },
+    detected(chords: Chord[]) {
+      if (!chords.length) {
+        clearLiveChord();
+        return;
+      }
+      if (committed) return;
+      publish({ candidates: chords, activeIdx: 0 });
+      if (!canCapture() || heldCount < MIN_CHORD_NOTES) return;
+      if ((chords[0].voicing?.length ?? 0) >= (peak[0]?.voicing?.length ?? 0)) peak = chords;
+      publish({ confirming: null });
+      startTimer(voicingId(chords[0]));
+    },
+    choose(index: number) {
+      if (isIndexIn(index, snapshot.candidates)) publish({ activeIdx: index });
+    },
+    chooseConfirm(index: number) {
+      const confirming = snapshot.confirming;
+      if (confirming && isIndexIn(index, confirming.candidates)) {
+        publish({ confirming: { ...confirming, activeIdx: index } });
+      }
+    },
+    confirm() {
+      const confirming = snapshot.confirming;
+      if (!canCapture() || !confirming) return;
+      const chord = confirming.candidates[confirming.activeIdx] ?? confirming.candidates[0];
+      if (chord) options.onCommit(chord);
+      publish({ confirming: null });
+    },
+    cancel() { publish({ confirming: null }); },
+    reset() {
+      heldCount = 0;
+      resetCapture();
+      publish({ candidates: [] });
+    },
+    dispose() {
+      stopTimer();
+      peak = [];
+      heldCount = 0;
+      committed = false;
+      snapshot = idleSnapshot();
+      listeners.clear();
+    },
+  };
+}
