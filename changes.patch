+              >
+                {blocker ?? metaNotice}
+              </p>
+            )}
+
+            <div className="flex flex-wrap items-center justify-between gap-2">
+              <button
+                type="button"
+                onClick={() => void startRun('rules')}
+                disabled={blocker !== null || busy}
+                className="px-3 py-1.5 text-xs btn-hover disabled:opacity-40 disabled:cursor-not-allowed"
+                style={{ background: 'var(--btn-bg)', color: 'var(--text-primary)', border: '1px solid var(--border)' }}
+                title="Use the genre template"
+              >
+                Genre template
+              </button>
+              <div className="flex gap-2">
+                <button
+                  type="button"
+                  onClick={() => dialogRef.current?.close()}
+                  className="px-3 py-1.5 text-xs btn-hover"
+                  style={{ background: 'var(--btn-bg)', color: 'var(--text-primary)', border: '1px solid var(--border)' }}
+                  title={planning ? 'Stop generating and close' : 'Close without planning'}
+                >
+                  Cancel
+                </button>
+                <button
+                  type="submit"
+                  disabled={planDisabled}
+                  className="px-4 py-1.5 text-xs font-bold btn-hover"
+                  style={{
+                    background: 'var(--text-heading)',
+                    color: 'var(--bg-primary)',
+                    // undefined when enabled, so btn-hover's hover dimming applies
+                    opacity: planDisabled ? 0.6 : undefined,
+                  }}
+                  title={metaOffText ?? (chordSource === 'meta' ? 'Muse Spark writes the form and every chord' : 'Muse Spark plans and reviews Music Transformer chords')}
+                >
+                  {planning ? 'Generating…' : judgeOffText ? 'Meta review unavailable' : metaOff ? 'Muse Spark unavailable' : chordSource === 'meta' ? 'Muse Spark only' : 'Meta + Music Transformer'}
+                </button>
+              </div>
+            </div>
+          </>
+        )}
+      </form>
+    </dialog>
+  );
+}
