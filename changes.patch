+      const volume = Math.max(.0001, velocity * (channel === 1 ? .14 : .045));
+      gain.gain.setValueAtTime(.0001, onset);
+      gain.gain.exponentialRampToValueAtTime(volume, onset + .012);
+      gain.gain.exponentialRampToValueAtTime(Math.max(.0001, volume * .45), onset + Math.max(.02, duration));
+      gain.gain.exponentialRampToValueAtTime(.0001, onset + Math.max(.03, duration) + .08);
+      oscillator.connect(gain).connect(context.destination);
