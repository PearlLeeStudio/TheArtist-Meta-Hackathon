+        self.assertEqual([(tick, message.type) for tick, message in absolute(messages)],
+                         [(0, "note_on"), (240, "note_off"), (240, "note_on"), (720, "note_off")])
+        for genre in ("funk", "jazz", "blues", "bossa", "country"):
+            body = spec(genre=genre)
