+  { name: 'electric_guitar_clean', label: 'Clean',    family: 'guitar' },
+  { name: 'overdriven_guitar',     label: 'Drive',    family: 'guitar' },
+  { name: 'distortion_guitar',     label: 'Dist',     family: 'guitar' },
