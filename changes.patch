index 0000000000000000000000000000000000000000..7ed808b4e4c3271b83686c259f7ad97f64ad775a
--- /dev/null
+++ b/scripts/bootstrap_submission.py
@@ -0,0 +1,59 @@
+"""Reconstruct the app in a separate dependency checkout, verifying all deltas."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+
+def run(*args, **kwargs):
+    subprocess.run([str(arg) for arg in args], check=True, **kwargs)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--target", type=Path, required=True)
+    parser.add_argument("--core-source", help="Optional local mirror for offline reconstruction")
+    parser.add_argument("--install", action="store_true", help="Install locked dependencies and build the frontend")
+    parser.add_argument("--prepare-assets", action="store_true", help="Download F1 and reviewed OMT; requires --install")
+    args = parser.parse_args()
+    package = Path(__file__).resolve().parent
+    if not args.target.is_absolute() or args.target.exists() or args.target.resolve().is_relative_to(package):
+        parser.error("Use a new absolute target outside this submission directory")
+    if args.prepare_assets and not args.install:
+        parser.error("--prepare-assets requires --install")
+    manifest = json.loads((package / "manifest.json").read_text())
+    patch = package / "changes.patch"
+    if manifest["version"] != 1 or hashlib.sha256(patch.read_bytes()).hexdigest() != manifest["patchSha256"]:
+        raise SystemExit("Invalid manifest or patch checksum")
+    for name in manifest["files"]:
+        if Path(name).is_absolute() or ".." in Path(name).parts or ".git" in Path(name).parts:
+            raise SystemExit("Invalid manifest path")
+    run("git", "clone", "--no-checkout", args.core_source or manifest["core"]["repository"], args.target)
+    run("git", "-C", args.target, "checkout", "--detach", manifest["core"]["commit"])
+    tree = subprocess.check_output(["git", "-C", str(args.target), "rev-parse", "HEAD^{tree}"]).decode().strip()
+    if tree != manifest["core"]["tree"]:
+        raise SystemExit("Core tree checksum differs from the declared baseline")
+    run("git", "-C", args.target, "apply", "--check", patch)
+    run("git", "-C", args.target, "apply", patch)
+    for name, checksum in manifest["files"].items():
+        file = args.target / name
+        actual = hashlib.sha256(file.read_bytes()).hexdigest() if file.exists() else None
+        if actual != checksum:
+            raise SystemExit(f"Reconstructed file mismatch: {name}")
+    print(f"Verified {len(manifest['files'])} changed paths against the manifest", flush=True)
+    if args.install:
+        backend, frontend = args.target / "backend", args.target / "frontend"
+        run("uv", "sync", "--frozen", "--python", "3.12", "--directory", backend)
+        run("npm", "--prefix", frontend, "ci")
+        run("npm", "--prefix", frontend, "run", "build")
+        run("uv", "run", "--frozen", "--directory", backend, "python", "-c", "import app.main; print('app import: ok')")
+        if args.prepare_assets:
+            for script in (backend / "scripts/setup_omt.py", args.target / "model/_download.py"):
+                run("uv", "run", "--frozen", "--directory", backend, "python", script,
+                    *(["--smoke"] if script.name == "_download.py" else []))
+    print("Reconstruction complete. No pre-event checkout or history was added to the submission directory.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/build_submission.py b/scripts/build_submission.py
new file mode 100644
index 0000000000000000000000000000000000000000..89ff2a61c375a2f27be6ebf8653cbe0605e6661c
--- /dev/null
+++ b/scripts/build_submission.py
@@ -0,0 +1,96 @@
+"""Extract event changes as a patch against a separately acquired, pinned core.
+
+The output contains no pre-event checkout or git history. Provenance candidates
+are review evidence, not an assertion that every added line is newly authored.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+# The pre-event core: this repository's public `baseline` tag, which holds the public TheArtist snapshot
+# f043e53 unchanged (same tree). The public TheArtist repository keeps only its latest
+# snapshot, so that commit is no longer served there.
+CORE_REPOSITORY = "https://github.com/PearlLeeStudio/TheArtist-DAW.git"
+CORE_COMMIT = "852204b7b3ba1a610d623c84625c86143298b23d"
+CORE_TREE = "76d0cff342da3d47cfd8250feea0e9ea37cd8823"
+CORE_SNAPSHOT = "https://github.com/PearlLeeStudio/TheArtist f043e538facd7a2f133a35f577904ac34eff1dc6"
+EXCLUDE = ("AGENTS.md", "CLAUDE.md")
+
+
+def git(*args):
+    return subprocess.check_output(["git", "-C", str(ROOT), *args])
+
+
+def blocks(content):
+    try:
+        lines = [line.strip() for line in content.decode().splitlines() if line.strip()]
+    except UnicodeDecodeError:
+        return set()
+    return {"\n".join(lines[i:i + 3]) for i in range(len(lines) - 2)
+            if sum(map(len, lines[i:i + 3])) >= 80}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    if not args.out.is_absolute() or args.out.exists():
+        parser.error("Use a new absolute output directory")
+    if git("status", "--porcelain").strip():
+        parser.error("Commit the development working tree before extraction")
+    if git("rev-parse", "baseline^{tree}").decode().strip() != CORE_TREE:
+        raise SystemExit("Baseline no longer matches the pinned public core")
+    if git("rev-parse", "baseline^{commit}").decode().strip() != CORE_COMMIT:
+        raise SystemExit("The baseline tag no longer points at the pinned core commit")
+    head = git("rev-parse", "HEAD").decode().strip()
+    paths = [".", *(f":(exclude){name}" for name in EXCLUDE)]
+    patch = git("diff", "--binary", "--full-index", "--no-renames", "baseline", head, "--", *paths)
+    changed = git("diff", "--name-only", "--no-renames", "-z", "baseline", head, "--", *paths).split(b"\0")
+    base = {name.decode(): git("show", f"baseline:{name.decode()}") for name in
+            git("ls-tree", "-r", "--name-only", "-z", "baseline").split(b"\0") if name}
+    base_blocks = {name: blocks(content) for name, content in base.items()}
+    manifest_files, added = {}, []
+    for raw in changed:
+        if not raw:
+            continue
+        name = raw.decode()
+        file = ROOT / name
+        if not file.exists():
+            manifest_files[name] = None
+            continue
+        content = file.read_bytes()
+        manifest_files[name] = hashlib.sha256(content).hexdigest()
+        if name in base:
+            continue
+        spans = blocks(content)
+        matches = []
+        for old_name, old_content in base.items():
+            shared = len(spans & base_blocks[old_name])
+            if content == old_content or (shared >= 3 and shared / max(1, len(spans)) >= .15):
+                matches.append(dict(path=old_name, exact=content == old_content,
+                                    sharedBlocks=shared, addedFileBlocks=len(spans)))
+        added.append(dict(path=name, candidates=sorted(matches, key=lambda x: -x["sharedBlocks"])[:5]))
+    args.out.mkdir(parents=True)
+    (args.out / "changes.patch").write_bytes(patch)
+    manifest = dict(version=1, core=dict(repository=CORE_REPOSITORY, ref="baseline",
+                    commit=CORE_COMMIT, tree=CORE_TREE, snapshotOf=CORE_SNAPSHOT),
+                    development=dict(repository="https://github.com/PearlLeeStudio/TheArtist-DAW", commit=head),
+                    patchSha256=hashlib.sha256(patch).hexdigest(), files=manifest_files)
+    (args.out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    (args.out / "provenance-review.json").write_text(json.dumps(dict(
+        method="Exact bytes and normalized three-line blocks; manual review remains required. "
+               "A git-added file can contain pre-event code. All such files remain patch deltas, not claimed new assets.",
+        addedFiles=added), indent=2) + "\n")
+    shutil.copyfile(ROOT / "scripts/bootstrap_submission.py", args.out / "bootstrap.py")
+    shutil.copyfile(ROOT / "scripts/submission_README.md", args.out / "README.md")
+    shutil.copyfile(ROOT / "LICENSE", args.out / "LICENSE")
+    print(f"Extracted {len(manifest_files)} changed paths at {head}; "
+          f"{sum(bool(row['candidates']) for row in added)} added paths need provenance review")
+
+
+if __name__ == "__main__":
+    main()
