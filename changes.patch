@@ -0,0 +1,60 @@
+"""Logic Pro Scripter export: the arrangement as a MIDI FX script that plays inside Logic.
+
+The script carries the same harmony and bass notes the MIDI export writes (smf_export.arrangement),
+so Logic plays what Play and the .mid file play; drums stay with Logic or the MIDI file.
+"""
+
+import json
+import math
+from pathlib import Path
+
+from app.models.export import ExportSpec
+from app.services.smf_export import ExportError, Note, arrangement, safe_title
+
+TEMPLATE = Path(__file__).with_name("scripter_template.js")
+SONG_MARKER = "/*__SONG_JSON__*/"
+MAX_SCRIPT_BYTES = 4 * 1024 * 1024
+
+
+def _notes(part: str, notes: list[Note]) -> list[dict]:
+    # The MIDI encoder drops the same impossible notes (smf_export._is_valid_note)
+    return [{"part": part, "pitch": note.pitch, "start": round(note.start, 6), "end": round(note.end, 6),
+             "velocity": note.velocity}
+            for note in notes
+            if 0 <= note.pitch <= 127 and math.isfinite(note.start) and math.isfinite(note.end) and note.end > note.start]
+
+
+def scripter_song(spec: ExportSpec) -> dict:
+    """The SONG object the template reads: times in quarter notes from the start of bar 1."""
+    parts = arrangement(spec)
+    grid = parts.grid
+    chords = [{"bar": bar, "slot": slot, "symbol": chord.symbol,
+               "startQuarter": round((bar * grid.numerator + slot * grid.half) * grid.quarters_per_beat, 6)}
+              for bar, measure in enumerate(spec.measures)
+              for slot, chord in enumerate(measure.chords) if chord is not None]
+    notes = sorted(_notes("bass", parts.bass) + _notes("harmony", parts.harmony),
+                   key=lambda note: (note["start"], note["part"] != "bass", note["pitch"]))
+    # The song form the script plays from: the whole form or one of these sections, never beyond it
+    sections = [{"label": section.label, "startBar": section.startMeasure, "bars": section.length}
+                for section in sorted(spec.sections, key=lambda section: section.startMeasure)]
+    return {"title": spec.title, "key": spec.key, "bpm": spec.bpm, "timeSignature": list(spec.timeSignature),
+            "quartersPerBar": grid.numerator * grid.quarters_per_beat, "lengthQuarters": grid.song_quarters,
+            "sections": sections, "chords": chords, "notes": notes}
+
+
+def render_scripter(spec: ExportSpec) -> str:
+    """The template with this song's SONG object in place of the placeholder."""
+    template = TEMPLATE.read_text(encoding="utf-8")
+    start = template.index(SONG_MARKER) + len(SONG_MARKER)
+    end = template.index(";\n", start)
+    payload = json.dumps(scripter_song(spec), ensure_ascii=False, separators=(",", ":"))
+    # Valid JSON, but not valid in an older JavaScript string literal
+    payload = payload.replace("\u2028", "\\u2028").replace("\u2029", "\\u2029")
+    script = template[:start] + payload + template[end:]
+    if len(script.encode("utf-8")) > MAX_SCRIPT_BYTES:
+        raise ExportError("The Scripter script exceeds the 4 MiB export limit.", 413)
+    return script
+
+
+def scripter_filename(title: str) -> str:
+    return f"{safe_title(title)}.theartist.js"
diff --git a/backend/app/services/scripter_template.js b/backend/app/services/scripter_template.js
new file mode 100644
index 0000000000000000000000000000000000000000..dd14938fd98f0d4035eea228674074a8acc86720
--- /dev/null
+++ b/backend/app/services/scripter_template.js
@@ -0,0 +1,243 @@
+/*
+ * TheArtist Chords — a Logic Pro Scripter MIDI FX script.
+ *
+ * Generated by TheArtist from the song below. Put it on a software-instrument
+ * track: MIDI FX ▸ Scripter ▸ Open Script in Editor ▸ paste ▸ Run Script.
+ * The arrangement follows Logic's transport (play, stop, locate, cycle) and
+ * keeps the voicings, comping rhythm, swing and bass line of the editor's Play
+ * panel. Notes you play on the track pass straight through.
+ *
+ * It works on the song form set in TheArtist, not on Logic's open timeline:
+ * it plays the whole form or one chosen section from the Start bar, and is
+ * silent beyond it. To change the form, edit it in TheArtist and export again.
+ *
+ * Logic's JavaScript engine is used, so this file stays ES5.
+ */
+
+var NeedsTimingInfo = true;
+
+// Written by the server: the arrangement in quarter-note beats, bar 0 at 0.
+var SONG = /*__SONG_JSON__*/{"title":"","key":"C major","bpm":80,"timeSignature":[4,4],"quartersPerBar":4,"lengthQuarters":0,"sections":[],"chords":[],"notes":[]};
+
+function songSections() {
+  return SONG.sections || [];
+}
+
+// The menu of what can be played: the whole form, then each section of it
+function sectionNames() {
+  var bars = Math.round(SONG.lengthQuarters / (SONG.quartersPerBar || 4));
+  var names = ["Whole form (" + bars + " bars)"];
+  var sections = songSections();
+  for (var i = 0; i < sections.length; i++) {
+    var s = sections[i];
+    names.push(s.label + " (bars " + (s.startBar + 1) + "-" + (s.startBar + s.bars) + ")");
+  }
+  return names;
+}
+
+var PluginParameters = [
+  {name: "Section", type: "menu", valueStrings: sectionNames(), defaultValue: 0},
+  {name: "Start bar", type: "lin", minValue: 1, maxValue: 999, numberOfSteps: 998, defaultValue: 1},
+  {name: "Transpose", type: "lin", minValue: -12, maxValue: 12, numberOfSteps: 24, defaultValue: 0},
+  {name: "Harmony", type: "checkbox", defaultValue: 1},
+  {name: "Bass", type: "checkbox", defaultValue: 1},
+  {name: "Velocity %", type: "lin", minValue: 10, maxValue: 150, numberOfSteps: 140, defaultValue: 100},
+  {name: "Loop", type: "checkbox", defaultValue: 0},
+  // Logic's ruler counts the meter's denominator as one beat; a quarter-note
+  // ruler is offered in case a host build reports quarter beats instead.
+  {name: "Beat unit", type: "menu", valueStrings: ["Logic ruler (meter denominator)", "Quarter note"], defaultValue: 0},
+];
+
+var EPS = 1e-6;
+var sounding = {};      // pitch -> number of note-ons without their note-off yet
+var pending = [];       // {pitch: int, beat: host beat of the note-off}
+var lastBlockEnd = null;
+var wasPlaying = false;
+var tracedChord = -1;
+
+function param(name) {
+  var value = GetParameter(name);
+  return value === undefined ? 0 : value;
+}
+
+function quartersPerHostBeat(info) {
+  if (param("Beat unit") === 1) return 1;
+  var denominator = info.meterDenominator || 4;
+  return 4 / denominator;
+}
+
+function startBeat(info) {
+  // Bar 1 is beat 1 in Logic; each bar holds meterNumerator ruler beats.
+  var bars = Math.round(param("Start bar")) - 1;
+  var beatsPerBar = (SONG.quartersPerBar || 4) / quartersPerHostBeat(info);
+  return 1 + bars * beatsPerBar;
+}
+
+function playsPart(part) {
+  return part === "bass" ? param("Bass") === 1 : param("Harmony") === 1;
+}
+
+function pitchOf(note) {
+  var pitch = note.pitch + Math.round(param("Transpose"));
+  return pitch < 0 || pitch > 127 ? -1 : pitch;
+}
+
+function velocityOf(note) {
+  var scaled = Math.round(note.velocity * 127 * param("Velocity %") / 100);
+  return Math.max(1, Math.min(127, scaled));
+}
+
+function noteOff(pitch, beat) {
+  var off = new NoteOff();
+  off.pitch = pitch;
+  off.velocity = 0;
+  if (beat === undefined) off.send(); else off.sendAtBeat(beat);
+  if (sounding[pitch] > 0) sounding[pitch] -= 1;
+}
+
+function allOff() {
+  for (var pitch in sounding) {
+    while (sounding[pitch] > 0) noteOff(parseInt(pitch, 10));
+  }
+  sounding = {};
+  pending = [];
+  tracedChord = -1;
+}
+
+function sectionOfBar(bar) {
+  var sections = songSections();
+  for (var i = 0; i < sections.length; i++) {
+    if (bar >= sections[i].startBar && bar < sections[i].startBar + sections[i].bars) return sections[i].label;
+  }
+  return "";
+}
+
+function traceChord(index) {
+  if (index === tracedChord) return;
+  tracedChord = index;
+  var chord = SONG.chords[index];
+  if (!chord) return;
+  var section = sectionOfBar(chord.bar);
+  Trace((section ? section + " · " : "") + "bar " + (chord.bar + 1) + (chord.slot ? "+" : "") + ": " + chord.symbol);
+}
+
+// What is played, in song quarters: the whole form, or the section chosen in the menu
+function activeWindow() {
+  var chosen = songSections()[Math.round(param("Section")) - 1];
+  if (!chosen) return {start: 0, end: SONG.lengthQuarters};
+  var quartersPerBar = SONG.quartersPerBar || 4;
+  return {start: chosen.startBar * quartersPerBar,
+          end: Math.min(SONG.lengthQuarters, (chosen.startBar + chosen.bars) * quartersPerBar)};
+}
+
+function chordAt(quarter) {
+  var found = -1;
+  for (var i = 0; i < SONG.chords.length; i++) {
+    if (SONG.chords[i].startQuarter <= quarter + EPS) found = i; else break;
+  }
+  return found;
+}
+
+// Strike every note whose onset lies in [fromQ, toQ) of the song; the window's start lands on
+// hostOriginBeat, and nothing sounds past the window's end.
+function scheduleSpan(fromQ, toQ, win, hostOriginBeat, qph) {
+  var notes = SONG.notes;
+  for (var i = 0; i < notes.length; i++) {
+    var note = notes[i];
+    if (note.start < fromQ - EPS || note.start >= toQ - EPS) continue;
+    if (!playsPart(note.part)) continue;
+    var pitch = pitchOf(note);
+    if (pitch < 0) continue;
+    var onBeat = hostOriginBeat + (note.start - win.start) / qph;
+    var on = new NoteOn();
+    on.pitch = pitch;
+    on.velocity = velocityOf(note);
+    on.sendAtBeat(onBeat);
+    sounding[pitch] = (sounding[pitch] || 0) + 1;
+    pending.push({pitch: pitch, beat: hostOriginBeat + (Math.min(note.end, win.end) - win.start) / qph});
+    if (note.part !== "bass") traceChord(chordAt(note.start));
+  }
+}
+
+// Map one host-beat range onto the chosen window of the form, looping when asked.
+function processRange(blockStart, blockEnd, info) {
+  var qph = quartersPerHostBeat(info);
+  var origin = startBeat(info);
+  var win = activeWindow();
+  var length = win.end - win.start;
+  var fromQ = (blockStart - origin) * qph;
+  var toQ = (blockEnd - origin) * qph;
+  if (toQ <= 0 || length <= 0) return;
+  if (fromQ < 0) fromQ = 0;
+  if (param("Loop") !== 1) {
+    // Once through the window; the timeline after it stays silent
+    if (fromQ >= length) return;
+    scheduleSpan(win.start + fromQ, win.start + Math.min(toQ, length), win, origin, qph);
+    return;
+  }
+  // Looping: walk the range one pass at a time so a block may cross the join.
+  var cursor = fromQ;
+  while (cursor < toQ - EPS) {
+    var passStartQ = Math.floor(cursor / length) * length;
+    var spanEnd = Math.min(toQ, passStartQ + length);
+    scheduleSpan(win.start + cursor - passStartQ, win.start + spanEnd - passStartQ, win,
+                 origin + passStartQ / qph, qph);
+    cursor = spanEnd;
+  }
+}
+
+function releaseDue(blockEnd) {
+  var keep = [];
+  for (var i = 0; i < pending.length; i++) {
+    var item = pending[i];
+    if (item.beat < blockEnd + EPS) noteOff(item.pitch, item.beat); else keep.push(item);
+  }
+  pending = keep;
+}
+
+function ProcessMIDI() {
+  var info = GetTimingInfo();
+  if (!info.playing) {
+    if (wasPlaying) allOff();
+    wasPlaying = false;
+    lastBlockEnd = null;
+    return;
+  }
+  var blockStart = info.blockStartBeat;
+  var blockEnd = info.blockEndBeat;
+  // A jump backwards (locate, or the cycle wrapping between blocks) ends what was sounding.
+  if (lastBlockEnd !== null && blockStart < lastBlockEnd - EPS) allOff();
+  wasPlaying = true;
+
+  if (info.cycling && blockEnd > info.rightCycleBeat + EPS && blockStart < info.rightCycleBeat) {
+    // The block runs past the right locator: the rest of it starts again at the left one.
+    processRange(blockStart, info.rightCycleBeat, info);
+    releaseDue(info.rightCycleBeat);
+    allOff();
+    var wrapped = blockEnd - info.rightCycleBeat;
+    processRange(info.leftCycleBeat, info.leftCycleBeat + wrapped, info);
+    releaseDue(info.leftCycleBeat + wrapped);
+    lastBlockEnd = info.leftCycleBeat + wrapped;
+    return;
+  }
+  processRange(blockStart, blockEnd, info);
+  releaseDue(blockEnd);
+  lastBlockEnd = blockEnd;
+}
+
+function HandleMIDI(event) {
+  event.send();
+}
+
+function Reset() {
+  allOff();
+  wasPlaying = false;
+  lastBlockEnd = null;
+}
+
+function ParameterChanged(index, value) {
+  var name = PluginParameters[index] && PluginParameters[index].name;
+  if (name === "Harmony" || name === "Bass" || name === "Transpose" || name === "Section" || name === "Start bar") {
+    allOff();
+  }
+}
diff --git a/backend/app/services/serving_readiness.py b/backend/app/services/serving_readiness.py
new file mode 100644
index 0000000000000000000000000000000000000000..1d258ee0de14df1f6fb7dd7b2e09d8c07938540f
--- /dev/null
+++ b/backend/app/services/serving_readiness.py
@@ -0,0 +1,30 @@
+"""Fail closed when a hosted model catalog cannot serve every advertised choice."""
+
+from app.services import inference
+
+
+def require_full_catalog() -> list[str]:
+    if not inference.TORCH_AVAILABLE or not inference.PEFT_AVAILABLE:
+        raise RuntimeError("Serving the full catalog requires Torch and PEFT")
+    missing = []
+    for key, path in inference.CHECKPOINTS.items():
+        required = (
+            (path / "adapter" / "adapter_config.json",
+             path / "adapter" / "adapter_model.safetensors",
+             path / "embedding_extension.pt")
+            if key.startswith("ft_f1_lora_") else (path,)
+        )
+        if any(not item.is_file() or item.stat().st_size == 0 for item in required):
+            missing.append(key)
+    if missing:
+        raise RuntimeError("Missing model assets: " + ", ".join(missing)
+                           + "; run model/_download.py without --smoke")
+
+    # Check assets before entering the legacy LoRA loader, which permits F1 fallback.
+    # A hosted catalog must never advertise such a substitution as the requested model.
+    registry = inference.ModelRegistry.get()
+    for key in inference.CHECKPOINTS:
+        loaded = registry.load_model(key)
+        if loaded is None or loaded.name != key:
+            raise RuntimeError(f"Requested model {key} did not load as itself")
+    return list(inference.CHECKPOINTS)
