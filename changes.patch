+class PausedStateTestCase(LLMTestCase):
+    """Each test starts and ends with no provider hold in this process."""
+
+    def setUp(self):
+        super().setUp()
+        holds = patch.dict(llm._no_credit_until, {}, clear=True)
+        holds.start()
+        self.addCleanup(holds.stop)
