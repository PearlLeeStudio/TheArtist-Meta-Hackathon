+  pending = [];
+  tracedChord = -1;
+}
+
+function sectionOfBar(bar) {
+  var sections = songSections();
+  for (var i = 0; i < sections.length; i++) {
+    if (bar >= sections[i].startBar && bar < sections[i].startBar + sections[i].bars) return sections[i].label;
+  }
+  return "";
+}
+
+function traceChord(index) {
+  if (index === tracedChord) return;
+  tracedChord = index;
+  var chord = SONG.chords[index];
+  if (!chord) return;
+  var section = sectionOfBar(chord.bar);
+  Trace((section ? section + " · " : "") + "bar " + (chord.bar + 1) + (chord.slot ? "+" : "") + ": " + chord.symbol);
+}
+
+// What is played, in song quarters: the whole form, or the section chosen in the menu
+function activeWindow() {
+  var chosen = songSections()[Math.round(param("Section")) - 1];
+  if (!chosen) return {start: 0, end: SONG.lengthQuarters};
+  var quartersPerBar = SONG.quartersPerBar || 4;
+  return {start: chosen.startBar * quartersPerBar,
+          end: Math.min(SONG.lengthQuarters, (chosen.startBar + chosen.bars) * quartersPerBar)};
+}
+
+function chordAt(quarter) {
+  var found = -1;
+  for (var i = 0; i < SONG.chords.length; i++) {
+    if (SONG.chords[i].startQuarter <= quarter + EPS) found = i; else break;
+  }
+  return found;
+}
+
+// Strike every note whose onset lies in [fromQ, toQ) of the song; the window's start lands on
+// hostOriginBeat, and nothing sounds past the window's end.
+function scheduleSpan(fromQ, toQ, win, hostOriginBeat, qph) {
+  var notes = SONG.notes;
+  for (var i = 0; i < notes.length; i++) {
+    var note = notes[i];
+    if (note.start < fromQ - EPS || note.start >= toQ - EPS) continue;
+    if (!playsPart(note.part)) continue;
+    var pitch = pitchOf(note);
+    if (pitch < 0) continue;
+    var onBeat = hostOriginBeat + (note.start - win.start) / qph;
+    var on = new NoteOn();
+    on.pitch = pitch;
+    on.velocity = velocityOf(note);
+    on.sendAtBeat(onBeat);
+    sounding[pitch] = (sounding[pitch] || 0) + 1;
+    pending.push({pitch: pitch, beat: hostOriginBeat + (Math.min(note.end, win.end) - win.start) / qph});
+    if (note.part !== "bass") traceChord(chordAt(note.start));
+  }
+}
+
+// Map one host-beat range onto the chosen window of the form, looping when asked.
+function processRange(blockStart, blockEnd, info) {
+  var qph = quartersPerHostBeat(info);
+  var origin = startBeat(info);
+  var win = activeWindow();
+  var length = win.end - win.start;
+  var fromQ = (blockStart - origin) * qph;
+  var toQ = (blockEnd - origin) * qph;
+  if (toQ <= 0 || length <= 0) return;
+  if (fromQ < 0) fromQ = 0;
+  if (param("Loop") !== 1) {
+    // Once through the window; the timeline after it stays silent
+    if (fromQ >= length) return;
+    scheduleSpan(win.start + fromQ, win.start + Math.min(toQ, length), win, origin, qph);
+    return;
+  }
+  // Looping: walk the range one pass at a time so a block may cross the join.
+  var cursor = fromQ;
+  while (cursor < toQ - EPS) {
+    var passStartQ = Math.floor(cursor / length) * length;
+    var spanEnd = Math.min(toQ, passStartQ + length);
+    scheduleSpan(win.start + cursor - passStartQ, win.start + spanEnd - passStartQ, win,
+                 origin + passStartQ / qph, qph);
+    cursor = spanEnd;
+  }
+}
+
+function releaseDue(blockEnd) {
+  var keep = [];
+  for (var i = 0; i < pending.length; i++) {
+    var item = pending[i];
+    if (item.beat < blockEnd + EPS) noteOff(item.pitch, item.beat); else keep.push(item);
+  }
+  pending = keep;
+}
+
+function ProcessMIDI() {
+  var info = GetTimingInfo();
+  if (!info.playing) {
+    if (wasPlaying) allOff();
+    wasPlaying = false;
+    lastBlockEnd = null;
+    return;
+  }
+  var blockStart = info.blockStartBeat;
+  var blockEnd = info.blockEndBeat;
+  // A jump backwards (locate, or the cycle wrapping between blocks) ends what was sounding.
+  if (lastBlockEnd !== null && blockStart < lastBlockEnd - EPS) allOff();
+  wasPlaying = true;
+
+  if (info.cycling && blockEnd > info.rightCycleBeat + EPS && blockStart < info.rightCycleBeat) {
+    // The block runs past the right locator: the rest of it starts again at the left one.
+    processRange(blockStart, info.rightCycleBeat, info);
+    releaseDue(info.rightCycleBeat);
+    allOff();
+    var wrapped = blockEnd - info.rightCycleBeat;
+    processRange(info.leftCycleBeat, info.leftCycleBeat + wrapped, info);
+    releaseDue(info.leftCycleBeat + wrapped);
+    lastBlockEnd = info.leftCycleBeat + wrapped;
+    return;
+  }
+  processRange(blockStart, blockEnd, info);
+  releaseDue(blockEnd);
+  lastBlockEnd = blockEnd;
+}
+
+function HandleMIDI(event) {
+  event.send();
+}
+
+function Reset() {
+  allOff();
+  wasPlaying = false;
+  lastBlockEnd = null;
+}
+
+function ParameterChanged(index, value) {
+  var name = PluginParameters[index] && PluginParameters[index].name;
+  if (name === "Harmony" || name === "Bass" || name === "Transpose" || name === "Section" || name === "Start bar") {
+    allOff();
+  }
+}
diff --git a/plugin/logic-scripter/test/scripter-host.mjs b/plugin/logic-scripter/test/scripter-host.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..26488c57ddd0ffc25436ef6dcb43722c3b2b4092
--- /dev/null
+++ b/plugin/logic-scripter/test/scripter-host.mjs
@@ -0,0 +1,83 @@
+// A small stand-in for Logic Pro's Scripter host: the globals a script sees
+// (timing info, parameters, NoteOn/NoteOff, Trace, MIDI) plus a driver that
+// feeds process blocks. It records every event the script sends, with the
+// beat it was scheduled for, so tests can check the arrangement follows the
+// transport. It is not Logic; it mirrors the documented Scripter API only.
+import vm from 'node:vm';
+
+export function createHost(script, { tempo = 120, meter = [4, 4], params = {} } = {}) {
+  const sent = [];
+  const traces = [];
+  const timing = {
+    playing: false, tempo, meterNumerator: meter[0], meterDenominator: meter[1],
+    blockStartBeat: 1, blockEndBeat: 1.25, blockLength: 0.25,
+    cycling: false, leftCycleBeat: 1, rightCycleBeat: 5,
+  };
+  let paramDefs = [];
+  const values = {};
+
+  class Event {
+    constructor(type) { this.type = type; this.pitch = 60; this.velocity = 100; this.channel = 1; }
+    send() { sent.push({ type: this.type, pitch: this.pitch, velocity: this.velocity, beat: null }); }
+    sendAtBeat(beat) { sent.push({ type: this.type, pitch: this.pitch, velocity: this.velocity, beat }); }
+    sendAfterBeats(beats) { this.sendAtBeat(timing.blockStartBeat + beats); }
+  }
+  class NoteOn extends Event { constructor() { super('NoteOn'); } }
+  class NoteOff extends Event { constructor() { super('NoteOff'); } }
+
+  const context = {
+    GetTimingInfo: () => ({ ...timing }),
+    GetParameter: (name) => (name in values ? values[name] : defaultOf(name)),
+    SetParameter: (name, value) => { values[name] = value; },
+    NoteOn, NoteOff,
+    MIDI: { allNotesOff: () => sent.push({ type: 'AllNotesOff', pitch: null, velocity: null, beat: null }) },
+    Trace: (text) => traces.push(String(text)),
+    Math, parseInt, parseFloat, JSON, Number, String, Array, Object, undefined,
+  };
+  vm.createContext(context);
+  vm.runInContext(script, context, { filename: 'theartist_chords.js' });
+  paramDefs = context.PluginParameters || [];
+  for (const [name, value] of Object.entries(params)) values[name] = value;
+
+  function defaultOf(name) {
+    const def = paramDefs.find((p) => p.name === name);
+    return def ? def.defaultValue : undefined;
+  }
+
+  return {
+    sent, traces, timing, context,
+    setParam(name, value) {
+      values[name] = value;
+      const index = paramDefs.findIndex((p) => p.name === name);
+      if (typeof context.ParameterChanged === 'function') context.ParameterChanged(index, value);
+    },
+    /** Run blocks of `step` beats from `from` up to `to` while playing. */
+    play(from, to, step = 0.25, patch = {}) {
+      Object.assign(timing, patch, { playing: true });
+      for (let beat = from; beat < to - 1e-9; beat += step) {
+        timing.blockStartBeat = beat;
+        timing.blockEndBeat = Math.min(beat + step, to);
+        timing.blockLength = timing.blockEndBeat - timing.blockStartBeat;
+        context.ProcessMIDI();
+      }
+    },
+    /** One block at an explicit position (used for cycle wraps and locates). */
+    block(start, end, patch = {}) {
+      Object.assign(timing, patch, { playing: true, blockStartBeat: start, blockEndBeat: end, blockLength: end - start });
+      context.ProcessMIDI();
+    },
+    stop() {
+      timing.playing = false;
+      context.ProcessMIDI();
+    },
+    reset() { context.Reset(); },
+    incoming(pitch) {
+      const on = new NoteOn();
+      on.pitch = pitch;
+      context.HandleMIDI(on);
+    },
+  };
+}
+
+export function notesOn(host) { return host.sent.filter((e) => e.type === 'NoteOn'); }
+export function notesOff(host) { return host.sent.filter((e) => e.type === 'NoteOff'); }
diff --git a/plugin/logic-scripter/test/theartist_chords.test.mjs b/plugin/logic-scripter/test/theartist_chords.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d05ac85f31e5b2feb1e97f0324597af850314365
--- /dev/null
+++ b/plugin/logic-scripter/test/theartist_chords.test.mjs
@@ -0,0 +1,184 @@
+// Drives the Scripter script with the mock host in scripter-host.mjs.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import { createHost, notesOn, notesOff } from './scripter-host.mjs';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const TEMPLATE = readFileSync(path.join(here, '..', '..', '..', 'backend', 'app', 'services', 'scripter_template.js'), 'utf8');
+
+// Two bars of 4/4: C (bar 0) then G (bar 1), one strike per bar, bass on beats 1 and 3.
+const SONG = {
+  title: 'Test', key: 'C major', bpm: 120, timeSignature: [4, 4], quartersPerBar: 4, lengthQuarters: 8,
+  chords: [
+    { bar: 0, slot: 0, symbol: 'C', startQuarter: 0 },
+    { bar: 1, slot: 0, symbol: 'G', startQuarter: 4 },
+  ],
+  notes: [
+    { part: 'harmony', pitch: 60, start: 0, end: 3.4, velocity: 0.7 },
+    { part: 'harmony', pitch: 64, start: 0, end: 3.4, velocity: 0.7 },
+    { part: 'harmony', pitch: 67, start: 0, end: 3.4, velocity: 0.7 },
+    { part: 'bass', pitch: 36, start: 0, end: 0.9, velocity: 0.6 },
+    { part: 'bass', pitch: 36, start: 2, end: 2.9, velocity: 0.6 },
+    { part: 'harmony', pitch: 59, start: 4, end: 7.4, velocity: 0.7 },
+    { part: 'harmony', pitch: 62, start: 4, end: 7.4, velocity: 0.7 },
+    { part: 'harmony', pitch: 67, start: 4, end: 7.4, velocity: 0.7 },
+    { part: 'bass', pitch: 43, start: 4, end: 4.9, velocity: 0.6 },
+    { part: 'bass', pitch: 43, start: 6, end: 6.9, velocity: 0.6 },
+  ],
+};
+
+function script(song = SONG) {
+  const marker = '/*__SONG_JSON__*/';
+  const at = TEMPLATE.indexOf(marker);
+  const lineEnd = TEMPLATE.indexOf(';\n', at);
+  return TEMPLATE.slice(0, at) + marker + JSON.stringify(song) + TEMPLATE.slice(lineEnd);
+}
+
+function near(a, b) { return Math.abs(a - b) < 1e-6; }
+
+test('every note is struck and released at its beat, bar 1 at host beat 1', () => {
+  const host = createHost(script());
+  host.play(1, 9.5);
+  const on = notesOn(host);
+  assert.equal(on.length, SONG.notes.length);
+  for (const note of SONG.notes) {
+    const hit = on.find((e) => e.pitch === note.pitch && near(e.beat, 1 + note.start));
+    assert.ok(hit, `note-on for ${note.pitch} at ${1 + note.start}`);
+    const off = notesOff(host).find((e) => e.pitch === note.pitch && near(e.beat, 1 + note.end));
+    assert.ok(off, `note-off for ${note.pitch} at ${1 + note.end}`);
+  }
+  assert.equal(on[0].velocity, Math.round(0.7 * 127));
+  assert.deepEqual(host.traces, ['bar 1: C', 'bar 2: G']);
+});
+
+test('nothing sounds before the start bar and the song can start later in the ruler', () => {
+  const host = createHost(script(), { params: { 'Start bar': 3 } });
+  host.play(1, 9);
+  assert.equal(notesOn(host).length, 0, 'bars 1-2 are silent');
+  host.play(9, 17);
+  const on = notesOn(host);
+  assert.equal(on.length, SONG.notes.length);
+  assert.ok(on.some((e) => e.pitch === 60 && near(e.beat, 9)));
+});
+
+test('stopping releases what is sounding, once', () => {
+  const host = createHost(script());
+  host.play(1, 2);
+  const sounding = notesOn(host).length;
+  assert.equal(sounding, 4, 'C triad plus one bass note by beat 2');
+  host.stop();
+  const released = notesOff(host).filter((e) => e.beat === null);
+  assert.equal(released.length, 4 - 1, 'bass note already released at 1.9; the triad is released now');
+  host.stop();
+  assert.equal(notesOff(host).filter((e) => e.beat === null).length, 3, 'a second stop sends nothing');
+});
+
+test('locating backwards releases and restarts', () => {
+  const host = createHost(script());
+  host.play(1, 6);
+  const before = notesOn(host).length;
+  host.block(1, 1.25);
+  const immediate = notesOff(host).filter((e) => e.beat === null);
+  assert.ok(immediate.length >= 3, 'the G chord sounding at beat 6 is released on the jump');
+  assert.ok(notesOn(host).length > before, 'the first chord is struck again');
+});
+
+test('a cycle that wraps inside one block restarts at the left locator', () => {
+  const host = createHost(script());
+  host.play(1, 4.9, 0.25, { cycling: true, leftCycleBeat: 1, rightCycleBeat: 5 });
+  const beforeWrap = notesOn(host).length;
+  host.block(4.9, 5.2, { cycling: true, leftCycleBeat: 1, rightCycleBeat: 5 });
+  const after = notesOn(host).slice(beforeWrap);
+  assert.ok(after.some((e) => e.pitch === 60 && near(e.beat, 1)), 'the C chord restarts at beat 1');
+  assert.ok(!after.some((e) => e.pitch === 59), 'the G chord of bar 2 is not struck in the wrapped part');
+});
+
+test('without Loop the timeline after the form stays silent', () => {
+  const host = createHost(script());
+  host.play(1, 25);
+  assert.equal(notesOn(host).length, SONG.notes.length, 'the two bars once, nothing in bars 3-6');
+  assert.ok(notesOn(host).every((e) => e.beat < 9));
+});
+
+test('Loop repeats the arrangement after its last bar', () => {
+  const host = createHost(script(), { params: { Loop: 1 } });
+  host.play(1, 13);
+  const cHits = notesOn(host).filter((e) => e.pitch === 60).map((e) => e.beat);
+  assert.deepEqual(cHits.map((b) => Math.round(b * 100) / 100), [1, 9]);
+  const gHits = notesOn(host).filter((e) => e.pitch === 59).map((e) => e.beat);
+  assert.deepEqual(gHits, [5]);
+});
+
+test('Transpose, Velocity % and the part switches apply to new strikes', () => {
+  const host = createHost(script(), { params: { Transpose: 2, 'Velocity %': 50, Bass: 0 } });
+  host.play(1, 5);
+  const on = notesOn(host);
+  assert.deepEqual([...new Set(on.map((e) => e.pitch))].sort((a, b) => a - b), [62, 66, 69]);
+  assert.ok(on.every((e) => e.velocity === Math.round(0.7 * 127 * 0.5)));
+});
+
+test('6/8 maps quarter-note times onto the ruler beats of the meter', () => {
+  const song = { ...SONG, timeSignature: [6, 8], quartersPerBar: 3, lengthQuarters: 6,
+    chords: [{ bar: 0, slot: 0, symbol: 'C', startQuarter: 0 }],
+    notes: [{ part: 'harmony', pitch: 60, start: 1.5, end: 2.5, velocity: 0.7 }] };
+  const ruler = createHost(script(song), { meter: [6, 8] });
+  ruler.play(1, 7);
+  assert.ok(near(notesOn(ruler)[0].beat, 1 + 3), 'eighth-note ruler: 1.5 quarters = 3 ruler beats');
+  const quarter = createHost(script(song), { meter: [6, 8], params: { 'Beat unit': 1 } });
+  quarter.play(1, 7);
+  assert.ok(near(notesOn(quarter)[0].beat, 1 + 1.5));
+});
+
+// The same two bars as a song form of two one-bar sections, A (the C bar) and B (the G bar)
+const FORM = { ...SONG, sections: [{ label: 'A', startBar: 0, bars: 1 }, { label: 'B', startBar: 1, bars: 1 }] };
+
+test('the Section menu lists the whole form, then each section with its bars', () => {
+  const host = createHost(script(FORM));
+  const menu = host.context.PluginParameters.find((p) => p.name === 'Section');
+  assert.deepEqual([...menu.valueStrings], ['Whole form (2 bars)', 'A (bars 1-1)', 'B (bars 2-2)']);
+  assert.equal(menu.defaultValue, 0);
+});
+
+test('a chosen section plays alone from the Start bar and is silent after it', () => {
+  const host = createHost(script(FORM), { params: { Section: 2, 'Start bar': 3 } });
+  host.play(1, 21);
+  const on = notesOn(host);
+  assert.deepEqual([...new Set(on.map((e) => e.pitch))].sort((a, b) => a - b), [43, 59, 62, 67], 'only section B');
+  assert.ok(on.filter((e) => e.pitch === 59).every((e) => near(e.beat, 9)), 'B starts at bar 3 = beat 9');
+  assert.equal(on.length, 5, 'once: G triad and its two bass notes');
+  assert.deepEqual(host.traces, ['B · bar 2: G']);
+});
+
+test('Loop repeats only the chosen section, and its notes end at the section edge', () => {
+  const sustained = { ...FORM, notes: [{ part: 'harmony', pitch: 60, start: 0, end: 6, velocity: 0.7 }] };
+  const host = createHost(script(sustained), { params: { Section: 1, Loop: 1 } });
+  host.play(1, 13);
+  assert.deepEqual(notesOn(host).map((e) => e.beat), [1, 5, 9], 'section A every bar');
+  assert.ok(notesOff(host).filter((e) => e.beat !== null).every((e) => near((e.beat - 1) % 4, 0)),
+    'a note longer than its section is released at the section edge');
+});
+
+test('the committed example, generated by the backend, plays every note it carries', () => {
+  const example = readFileSync(path.join(here, '..', 'example', 'theartist_chords.example.js'), 'utf8');
+  const host = createHost(example, { tempo: 96 });
+  const song = host.context.SONG;
+  assert.deepEqual([...song.sections.map((s) => s.label)], ['Verse', 'Chorus']);  // copied out of the host's realm
+  host.play(1, 1 + song.lengthQuarters + 1);
+  assert.equal(notesOn(host).length, song.notes.length);
+  assert.equal(notesOff(host).length, song.notes.length, 'every note is released, none left hanging');
+  assert.equal(host.traces[0], 'Verse · bar 1: Cmaj7');
+  assert.ok(host.traces.includes('Verse · bar 4+: C/E'), 'the second slot of bar 4 is traced as its own chord');
+  assert.ok(host.traces.includes('Chorus · bar 5: Fmaj7'));
+});
+
+test('incoming notes pass through and Reset releases everything', () => {
+  const host = createHost(script());
+  host.incoming(72);
+  assert.deepEqual(host.sent.at(-1), { type: 'NoteOn', pitch: 72, velocity: 100, beat: null });
+  host.play(1, 2);
+  host.reset();
+  assert.ok(notesOff(host).filter((e) => e.beat === null).length >= 3);
+});
