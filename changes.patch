+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { postJson } from './httpClient.ts';
+
+test('JSON POST keeps session headers and cancellation while leaving the response for the caller', async (t) => {
+  const controller = new AbortController();
+  const headers = new Headers({ 'X-TheArtist-Session': 'session-id' });
+  const response = new Response('event: complete\ndata: {}\n\n');
+  t.mock.method(globalThis, 'fetch', async (url, init) => {
+    assert.equal(url, '/api/plan/song/stream');
+    assert.equal(init?.method, 'POST');
+    assert.equal(init?.signal, controller.signal);
+    assert.equal(new Headers(init?.headers).get('X-TheArtist-Session'), 'session-id');
+    assert.equal(new Headers(init?.headers).get('Content-Type'), 'application/json');
+    assert.deepEqual(JSON.parse(String(init?.body)), { targetBars: 32 });
+    return response;
+  });
+  assert.equal(await postJson('/api/plan/song/stream', { targetBars: 32 }, { headers, signal: controller.signal }), response);
+  assert.equal(response.bodyUsed, false);
+  assert.equal(headers.has('Content-Type'), false);
+});
+
+test('network errors retain their cause and the endpoint-specific message', async (t) => {
+  const failure = new TypeError('connection refused');
+  t.mock.method(globalThis, 'fetch', async () => { throw failure; });
+  await assert.rejects(postJson('/api/generate/stream', {}), (error: Error) =>
+    /Could not reach the server/.test(error.message) && error.cause === failure);
+  await assert.rejects(postJson('/api/generate/section/stream', {}, { unreachableMessage: 'Section unavailable' }),
+    (error: Error) => error.message === 'Section unavailable' && error.cause === failure);
+});
+
+test('cancellation is not reclassified as a connectivity failure', async (t) => {
+  const controller = new AbortController();
+  const failure = new DOMException('Aborted', 'AbortError');
+  t.mock.method(globalThis, 'fetch', async () => { controller.abort(); throw failure; });
+  await assert.rejects(postJson('/api/plan/song/stream', {}, { signal: controller.signal }),
+    (error) => error === failure);
+});
+
+test('HTTP failures preserve validation locations, alternate messages, and non-JSON status', async (t) => {
+  const cases: Array<[number, unknown, string]> = [
+    [422, { detail: [{ loc: ['body', 'sections', 0, 'bars'], msg: 'Must be positive' }] }, 'sections.0.bars: Must be positive'],
+    [429, { detail: '  ', error: 'Allowance exhausted' }, 'Allowance exhausted'],
+    [400, null, 'Request failed (HTTP 400)'],
+    [503, '<html>Unavailable</html>', 'Server error (HTTP 503)'],
+  ];
+  for (const [status, body, message] of cases) {
+    const mock = t.mock.method(globalThis, 'fetch', async () =>
+      new Response(typeof body === 'string' ? body : JSON.stringify(body), { status }));
+    await assert.rejects(postJson('/api/generate/stream', {}), { message });
+    mock.mock.restore();
+  }
+});
diff --git a/frontend/src/engine/httpClient.ts b/frontend/src/engine/httpClient.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dd5d6e3c87b6efc3e380597598fdbc49b40a9edd
--- /dev/null
+++ b/frontend/src/engine/httpClient.ts
@@ -0,0 +1,55 @@
+/** Shared transport for JSON POSTs; callers own their response schemas and streams. */
+
+/** A backend detail can be a plain message or FastAPI's field-validation list. */
+export function formatErrorDetail(detail: unknown): string | null {
+  if (typeof detail === 'string') return detail.trim() || null;
+  if (!Array.isArray(detail)) return null;
+  const parts = detail.map((item) => {
+    if (typeof item === 'string') return item;
+    if (typeof item !== 'object' || item === null) return '';
+    const { loc, msg } = item as { loc?: unknown; msg?: unknown };
+    const field = Array.isArray(loc) ? loc.filter((p) => p !== 'body').join('.') : '';
+    const text = typeof msg === 'string' ? msg : '';
+    return field && text ? `${field}: ${text}` : text;
+  }).filter(Boolean);
+  return parts.length > 0 ? parts.join('; ') : null;
+}
+
+export async function describeHttpError(response: Response): Promise<string> {
+  try {
+    const body = (await response.json()) as { detail?: unknown; error?: unknown } | null;
+    const detail = formatErrorDetail(body?.detail) ?? formatErrorDetail(body?.error);
+    if (detail) return detail;
+  } catch {
+    // A non-JSON error still gets a visible HTTP status.
+  }
+  return response.status >= 500
+    ? `Server error (HTTP ${response.status})`
+    : `Request failed (HTTP ${response.status})`;
+}
+
+interface PostJsonOptions {
+  signal?: AbortSignal;
+  headers?: HeadersInit;
+  unreachableMessage?: string;
+  /** Some endpoints include request ids and spend in their failure envelope. */
+  describeError?: (response: Response) => Promise<string>;
+}
+
+/** Preserve abort errors, report HTTP failures, and leave successful bodies unread. */
+export async function postJson(url: string, body: unknown, options: PostJsonOptions = {}): Promise<Response> {
+  const headers = new Headers(options.headers);
+  headers.set('Content-Type', 'application/json');
+  let response: Response;
+  try {
+    response = await fetch(url, {
+      method: 'POST', headers, body: JSON.stringify(body), signal: options.signal,
+    });
+  } catch (error) {
+    if (options.signal?.aborted) throw error;
+    throw new Error(options.unreachableMessage ??
+      'Could not reach the server. Check the backend connection and try again.', { cause: error });
+  }
+  if (!response.ok) throw new Error(await (options.describeError ?? describeHttpError)(response));
+  return response;
+}
